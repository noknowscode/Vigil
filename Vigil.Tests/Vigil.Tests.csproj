<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      UNOB0025: the tests reference the app's plain net10.0 build, which has no Uno runtime host by design; they test
      domain, store and model code and never start the Uno runtime.
    -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);UNOB0025</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vigil\Vigil.csproj" />
  </ItemGroup>
</Project>
