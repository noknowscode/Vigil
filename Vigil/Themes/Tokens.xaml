<!--
  v2 design: fonts, radii, shadows, the type ramp, icons and the button, nav, link, card, badge and chip styles
  (SPEC-v2.md Design Brief; values from docs/design/shell-and-tokens.md §1-6, §10). No colour lives here: every brush is a
  palette role (Styles/ColorPaletteOverride.xaml) or one of App.xaml's no-role brushes (care stages, vitals).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">
  <!--
    Brushes drawn from role colours (ThemeResource stops), so they follow the theme and the palette: the Today hero's
    ground (secondary to primary container), the gantt's planned slots, a booked status strip, done stepper segments,
    the stepper knob and the status strip's inset shade.
  -->
  <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0.32" EndPoint="1,0.68">
    <GradientStop Color="{ThemeResource SecondaryContainerColor}" Offset="0" />
    <GradientStop Color="{ThemeResource PrimaryContainerColor}" Offset="1" />
  </LinearGradientBrush>
  <!-- 135deg repeating stripes: Absolute mapping, end point (p/√2, p/√2) for a period of p px; hard stops. -->
  <LinearGradientBrush x:Key="PlannedHatchBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="2.828,2.828">
    <GradientStop Color="{ThemeResource SurfaceColor}" Offset="0" /><GradientStop Color="{ThemeResource SurfaceColor}" Offset="0.75" />
    <GradientStop Color="{ThemeResource OutlineColor}" Offset="0.75" /><GradientStop Color="{ThemeResource OutlineColor}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="BookedHatchBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="4.243,4.243">
    <GradientStop Color="{ThemeResource BackgroundColor}" Offset="0" /><GradientStop Color="{ThemeResource BackgroundColor}" Offset="0.8333" />
    <GradientStop Color="{ThemeResource SurfaceVariantColor}" Offset="0.8333" /><GradientStop Color="{ThemeResource SurfaceVariantColor}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="StepDoneHatchBrush" MappingMode="Absolute" SpreadMethod="Repeat" StartPoint="0,0" EndPoint="2.828,2.828">
    <GradientStop Color="{ThemeResource OutlineVariantColor}" Offset="0" /><GradientStop Color="{ThemeResource OutlineVariantColor}" Offset="0.25" />
    <GradientStop Color="{ThemeResource SurfaceColor}" Offset="0.25" /><GradientStop Color="{ThemeResource SurfaceColor}" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="KnobBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="{ThemeResource SurfaceColor}" Offset="0" /><GradientStop Color="{ThemeResource SurfaceVariantColor}" Offset="1" />
  </LinearGradientBrush>
  <!-- Inset shadow (CSS inset 0 1px 3px) as a 4 px top shade inside rounded strips and status cards. -->
  <LinearGradientBrush x:Key="InsetShadeBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,4" Opacity="0.12">
    <GradientStop Color="{StaticResource ShadowInkColor}" Offset="0" /><GradientStop Color="Transparent" Offset="1" />
  </LinearGradientBrush>

  <!-- Shadows (§4), shared by every ShadowContainer that wears them (Toolkit: a ShadowCollection may be a resource). -->
  <utu:ShadowCollection x:Key="ShadowFrame">
    <utu:Shadow OffsetY="1" BlurRadius="2" Opacity="0.05" Color="{StaticResource ShadowInkColor}" />
    <utu:Shadow OffsetY="12" BlurRadius="32" Spread="-24" Opacity="0.25" Color="{StaticResource ShadowInkColor}" />
  </utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowXs"><utu:Shadow OffsetY="1" BlurRadius="2" Opacity="0.05" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowNavOn"><utu:Shadow OffsetY="1" BlurRadius="2" Opacity="0.06" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowSegOn"><utu:Shadow OffsetY="1" BlurRadius="2" Opacity="0.12" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowCard"><utu:Shadow OffsetY="2" BlurRadius="3" Spread="-1" Opacity="0.07" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowGlass"><utu:Shadow OffsetY="10" BlurRadius="28" Spread="-16" Opacity="0.28" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowFloatButton"><utu:Shadow OffsetY="2" BlurRadius="8" Opacity="0.18" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowKnob"><utu:Shadow OffsetY="1" BlurRadius="3" Opacity="0.2" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <utu:ShadowCollection x:Key="ShadowGanttDot"><utu:Shadow OffsetY="1" BlurRadius="3" Opacity="0.25" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
  <!-- Inset: photo frames, the shadow ink at 20 % in both themes (the prototype's rgba(0,0,0,.2)). -->
  <utu:ShadowCollection x:Key="ShadowInsetPhoto"><utu:Shadow IsInner="True" OffsetY="1" BlurRadius="3" Opacity="0.2" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>

  <!-- Fonts (§1). Weights resolve through the .ttf.manifest files (static instances per weight). -->
  <FontFamily x:Key="FontSans">ms-appx:///Assets/Fonts/HankenGrotesk.ttf#Hanken Grotesk</FontFamily>
  <FontFamily x:Key="FontMono">ms-appx:///Assets/Fonts/MartianMono.ttf#Martian Mono</FontFamily>
  <!-- Tracked copies (tools/track_fonts.py): the prototype's negative letter-spacing baked into the advance widths,
       because Skia ignores CharacterSpacing. Txx = -0.0xx em. -->
  <FontFamily x:Key="FontMonoT50">ms-appx:///Assets/Fonts/MartianMonoT50.ttf#Vigil Mono T50</FontFamily>
  <FontFamily x:Key="FontMonoT30">ms-appx:///Assets/Fonts/MartianMonoT30.ttf#Vigil Mono T30</FontFamily>
  <FontFamily x:Key="FontMonoT20">ms-appx:///Assets/Fonts/MartianMonoT20.ttf#Vigil Mono T20</FontFamily>
  <FontFamily x:Key="FontSerifT20">ms-appx:///Assets/Fonts/NewsreaderT20.ttf#Vigil Serif T20</FontFamily>
  <FontFamily x:Key="FontSerifT15">ms-appx:///Assets/Fonts/NewsreaderT15.ttf#Vigil Serif T15</FontFamily>
  <FontFamily x:Key="FontSansT20">ms-appx:///Assets/Fonts/HankenGroteskT20.ttf#Vigil Sans T20</FontFamily>

  <!-- Radii (§3) -->
  <CornerRadius x:Key="Radius3">3</CornerRadius>
  <CornerRadius x:Key="Radius6">6</CornerRadius>
  <CornerRadius x:Key="Radius8">8</CornerRadius>
  <CornerRadius x:Key="Radius10">10</CornerRadius>
  <CornerRadius x:Key="Radius12">12</CornerRadius>
  <CornerRadius x:Key="Radius14">14</CornerRadius>
  <CornerRadius x:Key="Radius16">16</CornerRadius>
  <CornerRadius x:Key="Radius18">18</CornerRadius>
  <CornerRadius x:Key="Radius22">22</CornerRadius>
  <CornerRadius x:Key="Radius24">24</CornerRadius>
  <CornerRadius x:Key="Radius26">26</CornerRadius>
  <CornerRadius x:Key="Radius11">11</CornerRadius>
  <!-- Patient card header tray (17 under the 18 px tray, 18 at its foot) and the Show details toggle's foot. -->
  <CornerRadius x:Key="RadiusTrayHeader">17,17,18,18</CornerRadius>
  <CornerRadius x:Key="RadiusToggleBottom">0,0,17,17</CornerRadius>

  <!-- Page frame (§7): content padding inside the frame's scroll area (CSS main padding 36 40 40 40). -->
  <Thickness x:Key="FramePadding">40,36,40,40</Thickness>

  <!-- Type ramp (§1), named by role. CharacterSpacing is a no-op on Skia: tracked roles use the FontXxxTnn copies. -->
  <Style x:Key="TypeBase" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>
  <Style x:Key="TypeDisplayTitleL" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}">
    <Setter Property="FontFamily" Value="{StaticResource FontSerifT20}" />
    <Setter Property="FontSize" Value="56" />
    <Setter Property="LineHeight" Value="60" />
  </Style>
  <Style x:Key="TypeDisplayTitle" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}">
    <Setter Property="FontFamily" Value="{StaticResource FontSerifT15}" />
    <Setter Property="FontSize" Value="40" />
    <Setter Property="LineHeight" Value="46" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>
  <Style x:Key="TypeMono" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}">
    <Setter Property="FontFamily" Value="{StaticResource FontMono}" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style x:Key="TypeMonoHero" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT50}" /><Setter Property="FontSize" Value="64" /><Setter Property="LineHeight" Value="68" /></Style>
  <Style x:Key="TypeMonoHeroS" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT50}" /><Setter Property="FontSize" Value="56" /><Setter Property="LineHeight" Value="60" /></Style>
  <Style x:Key="TypeMonoVital" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT50}" /><Setter Property="FontSize" Value="48" /><Setter Property="LineHeight" Value="52" /></Style>
  <Style x:Key="TypeMonoStatL" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT30}" /><Setter Property="FontSize" Value="30" /><Setter Property="LineHeight" Value="36" /></Style>
  <Style x:Key="TypeMonoStat" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT30}" /><Setter Property="FontSize" Value="28" /><Setter Property="LineHeight" Value="32" /></Style>
  <Style x:Key="TypeMonoStatS" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT30}" /><Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="30" /></Style>
  <Style x:Key="TypeMonoTimerCard" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontFamily" Value="{StaticResource FontMonoT20}" /><Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="24" /></Style>
  <Style x:Key="TypeMonoValue" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="18" /><Setter Property="LineHeight" Value="26" /></Style>
  <Style x:Key="TypeMonoValueS" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="22" /></Style>
  <Style x:Key="TypeMonoCell" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="18" /></Style>
  <Style x:Key="TypeMonoNum" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18" /></Style>
  <Style x:Key="TypeMonoLabel" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /></Style>
  <Style x:Key="TypeMonoMeta" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" /></Style>
  <Style x:Key="TypeMonoAxis" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="16" /><Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" /></Style>
  <Style x:Key="TypeMonoChart" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}"><Setter Property="FontSize" Value="10" /><Setter Property="LineHeight" Value="12" /><Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" /></Style>
  <Style x:Key="TypeBrand" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}">
    <Setter Property="FontFamily" Value="{StaticResource FontSansT20}" /><Setter Property="FontSize" Value="24" /><Setter Property="LineHeight" Value="28" /><Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
  </Style>
  <Style x:Key="TypeH2Section" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeH3CardName" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeTitleM" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="18" /><Setter Property="LineHeight" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeH3Card" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="24" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeBodyL" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="24" /><Setter Property="TextWrapping" Value="WrapWholeWords" /></Style>
  <Style x:Key="TypeTitleS" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeBody" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /></Style>
  <Style x:Key="TypeBodyMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeBody}"><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="TypeBodyStrong" TargetType="TextBlock" BasedOn="{StaticResource TypeBody}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeBodyS" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" /></Style>
  <Style x:Key="TypeButtonS" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeCaption" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /><Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" /></Style>
  <Style x:Key="TypeCaptionStrong" TargetType="TextBlock" BasedOn="{StaticResource TypeCaption}"><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style x:Key="TypeMicro" TargetType="TextBlock" BasedOn="{StaticResource TypeBase}"><Setter Property="FontSize" Value="11" /><Setter Property="LineHeight" Value="14" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" /></Style>

  <!--
    Line icons (§11): Lucide geometry from Icons.xaml drawn at 24 units and scaled to the box, so the stroke scales
    with it exactly like the prototype's SVG (stroke 1.75 or 2 in viewBox units). Set Content to the geometry key and
    Foreground to the stroke colour. Path.Stroke does not inherit Foreground, so the template binds it.
  -->
  <ControlTemplate x:Key="LineIconTemplate" TargetType="ContentControl">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.75"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Grid>
    </Viewbox>
  </ControlTemplate>
  <ControlTemplate x:Key="LineIconBoldTemplate" TargetType="ContentControl">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="{TemplateBinding Content}" Stroke="{TemplateBinding Foreground}" StrokeThickness="2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Grid>
    </Viewbox>
  </ControlTemplate>
  <ControlTemplate x:Key="FilledIconTemplate" TargetType="ContentControl">
    <Viewbox Stretch="Uniform">
      <Grid Width="24" Height="24">
        <Path Data="{TemplateBinding Content}" Fill="{TemplateBinding Foreground}" />
      </Grid>
    </Viewbox>
  </ControlTemplate>
  <Style x:Key="LineIcon18" TargetType="ContentControl">
    <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
    <Setter Property="IsTabStop" Value="False" /><Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="Template" Value="{StaticResource LineIconTemplate}" />
  </Style>
  <Style x:Key="LineIcon16" TargetType="ContentControl" BasedOn="{StaticResource LineIcon18}">
    <Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" />
  </Style>
  <Style x:Key="LineIcon16Bold" TargetType="ContentControl" BasedOn="{StaticResource LineIcon16}">
    <Setter Property="Template" Value="{StaticResource LineIconBoldTemplate}" />
  </Style>
  <Style x:Key="LineIcon14Bold" TargetType="ContentControl" BasedOn="{StaticResource LineIcon16Bold}">
    <Setter Property="Width" Value="14" /><Setter Property="Height" Value="14" />
  </Style>
  <Style x:Key="FilledIcon" TargetType="ContentControl" BasedOn="{StaticResource LineIcon18}">
    <Setter Property="Foreground" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Template" Value="{StaticResource FilledIconTemplate}" />
  </Style>

  <!--
    Buttons (§10). Two templates: the Material button templates carry their own elevation, min sizes and state
    overlays, so a Border + ContentPresenter template keeps the box, the hover fill and the 0.96 press scale. Every
    colour is a role brush: the primary button is Primary with the OnPrimary state layer, the secondary one Surface with
    the Background hover and the SurfaceVariant press.
    xaml-lint: allow template - exact prototype fills, press scale; Material overlays cannot match them
  -->
  <Style x:Key="ButtonBase" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource FontSans}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="FocusVisualPrimaryBrush" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="FocusVisualPrimaryThickness" Value="2" />
    <Setter Property="FocusVisualSecondaryThickness" Value="0" />
    <Setter Property="FocusVisualMargin" Value="-4" />
  </Style>
  <!-- Disabled buttons (primary, secondary, nav item) fade to this, so an unavailable action never reads as available. -->
  <x:Double x:Key="DisabledOpacity">0.45</x:Double>
  <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="Press" /></Grid.RenderTransform>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="StateLayer.Background" Value="{ThemeResource OnPrimaryHoverBrush}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters><Setter Target="StateLayer.Background" Value="{ThemeResource OnPrimaryPressedBrush}" /></VisualState.Setters>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
          </VisualState>
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="{StaticResource DisabledOpacity}" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <!-- State layer (Material): the OnPrimary hover and pressed tints over the primary fill. -->
      <Border x:Name="StateLayer" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Grid>
  </ControlTemplate>
  <ControlTemplate x:Key="SecondaryButtonTemplate" TargetType="Button">
    <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" RenderTransformOrigin="0.5,0.5">
      <Grid.RenderTransform><ScaleTransform x:Name="Press" /></Grid.RenderTransform>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal" />
          <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource BackgroundBrush}" /></VisualState.Setters></VisualState>
          <VisualState x:Name="Pressed">
            <VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" /></VisualState.Setters>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="Press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
            </Storyboard>
          </VisualState>
          <!-- A disabled button reads as unavailable (Induce before the checks, Administer dose on a signed record). -->
          <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="{StaticResource DisabledOpacity}" /></VisualState.Setters></VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}"
                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
    </Grid>
  </ControlTemplate>

  <Style x:Key="ButtonPrimary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnPrimaryBrush}" />
    <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
  </Style>
  <Style x:Key="ButtonPrimaryS" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
    <Setter Property="Height" Value="32" /><Setter Property="Padding" Value="14,0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="ButtonPrimaryM" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
    <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="ButtonPrimaryL" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
    <Setter Property="Height" Value="40" /><Setter Property="Padding" Value="18,0" /><Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style x:Key="ButtonPrimaryXL" TargetType="Button" BasedOn="{StaticResource ButtonPrimary}">
    <Setter Property="Height" Value="48" /><Setter Property="Padding" Value="18,0" /><Setter Property="CornerRadius" Value="14" /><Setter Property="FontSize" Value="15" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style x:Key="ButtonSecondary" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template" Value="{StaticResource SecondaryButtonTemplate}" />
  </Style>
  <Style x:Key="ButtonSecondaryM" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
    <Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="CornerRadius" Value="10" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="ButtonSecondaryL" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
    <Setter Property="Height" Value="40" /><Setter Property="Padding" Value="18,0" /><Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style x:Key="ButtonIconSecondary" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
    <Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="12" />
  </Style>
  <Style x:Key="ButtonIconSecondaryS" TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
    <Setter Property="Width" Value="32" /><Setter Property="Height" Value="32" /><Setter Property="Padding" Value="0" /><Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style x:Key="ButtonIconGhost" TargetType="Button" BasedOn="{StaticResource ButtonIconSecondaryS}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>

  <!--
    Sidebar nav item (§8): 40 px, radius 12, icon 18 + label 14/20 Medium + optional count. Hover ink 5 %; the active
    item (NavStates.Active, driven by utu:VisualStateManagerExtensions.States from ShellModel) gets the surface, the
    tri-tone border, the nav-on shadow and a primary icon (icons bind the presenter's Foreground).
    xaml-lint: allow template - route-driven Active state needs its own visual state group
  -->
  <!-- Link (.lnk): 14/20 600 ink, underline rgba(27,33,47,.3) 4 px below, trailing arrow 16 / 2.
       xaml-lint: allow template - underline colour and offset are not TextDecorations options -->
  <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Underline.Fill" Value="{ThemeResource OnSurfaceBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Underline.Fill" Value="{ThemeResource OnSurfaceBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Grid>
                <TextBlock Text="{TemplateBinding Content}" Style="{StaticResource TypeBodyStrong}" Foreground="{TemplateBinding Foreground}" />
                <Rectangle x:Name="Underline" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-3" Fill="{ThemeResource OnSurfaceLowBrush}" />
              </Grid>
              <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconArrowRight}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- A row that opens something (record card footers): content row, hover Surface2, radius 8. The negative margin at the
       call site keeps the content aligned with the card text while the hover fill bleeds 8 px.
       xaml-lint: allow template - row hover fill behind arbitrary row content -->
  <Style x:Key="RowLinkButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource SurfaceVariantBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource BackgroundBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled" />
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <ContentPresenter Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Panel card for the utility screens (Settings, Agenda, sheets): the record cards' surface. Surface1, tri-tone edge,
       radius 18, padding 20, shadow xs (0 1 2 / 5 %). Static: no pressed overlay (see StaticOutlinedCardStyle).
       xaml-lint: allow template - shadow xs and the gradient edge; the Material card templates draw neither -->
  <Style x:Key="PanelCardStyle" TargetType="utu:CardContentControl" BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="Padding" Value="20" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:CardContentControl">
          <utu:ShadowContainer Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" Shadows="{StaticResource ShadowXs}">
            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            </Border>
          </utu:ShadowContainer>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Help and explanatory copy: body 14/20, muted, wrapping. -->
  <Style x:Key="TypeBodyMuted" TargetType="TextBlock" BasedOn="{StaticResource TypeBody}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="TextWrapping" Value="WrapWholeWords" />
  </Style>
  <!-- Section eyebrow over a group of fields ("PATIENT", "SCHEDULE"): 12/16 semibold muted. -->
  <Style x:Key="TypeEyebrow" TargetType="TextBlock" BasedOn="{StaticResource TypeCaptionStrong}">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
  </Style>
  <!-- Loading placeholder bar (skeletons keep the loaded layout's footprint). The record page adds VerticalAlignment Top. -->
  <Style x:Key="Skeleton" TargetType="Rectangle">
    <Setter Property="RadiusX" Value="6" />
    <Setter Property="RadiusY" Value="6" />
    <Setter Property="Fill" Value="{ThemeResource SurfaceVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <!-- Care ruler time block (CareRuler builds these in code): radius 9, hover outline primary, press 10 % primary.
       xaml-lint: allow template - hover tint over a block whose fill is the phase colour -->
  <Style x:Key="CloverTimeBlock" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="9,8" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Shell.BorderBrush" Value="{ThemeResource PrimaryBrush}" /><Setter Target="Hover.Opacity" Value="0.04" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.10" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Shell.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
            </Border>
            <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="NavItemButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
    <Setter Property="Height" Value="40" />
    <Setter Property="Padding" Value="12,0,0,0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root">
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Hover.Background" Value="{ThemeResource OnSurfaceHoverBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Background" Value="{ThemeResource OnSurfacePressedBrush}" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Root.Opacity" Value="{StaticResource DisabledOpacity}" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
              <VisualStateGroup x:Name="NavStates">
                <VisualState x:Name="Inactive" />
                <VisualState x:Name="Active">
                  <VisualState.Setters>
                    <Setter Target="Shadow.Visibility" Value="Visible" />
                    <Setter Target="ContentPresenter.Foreground" Value="{ThemeResource PrimaryBrush}" />
                  </VisualState.Setters>
                </VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Hover" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
            <utu:ShadowContainer x:Name="Shadow" Visibility="Collapsed" Background="{ThemeResource SurfaceBrush}" CornerRadius="{TemplateBinding CornerRadius}" Shadows="{StaticResource ShadowNavOn}">
              <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" />
            </utu:ShadowContainer>
            <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}" Foreground="{TemplateBinding Foreground}" BorderThickness="1" BorderBrush="Transparent"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Badges and chips (§10). Text inside uses TypeCaptionStrong (badges) or TypeBodyS + SemiBold (status chips). -->
  <Style x:Key="BadgeOutline" TargetType="Border">
    <Setter Property="Height" Value="24" /><Setter Property="Padding" Value="9,0" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="BadgeNeutral" TargetType="Border">
    <Setter Property="Height" Value="24" /><Setter Property="Padding" Value="9,0" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource SurfaceVariantBrush}" />
  </Style>
  <Style x:Key="ChipErrorSoft" TargetType="Border">
    <Setter Property="Height" Value="26" /><Setter Property="Padding" Value="8,0" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource ErrorContainerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource ErrorLowBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style x:Key="ChipLiveSoft" TargetType="Border">
    <Setter Property="Height" Value="28" /><Setter Property="Padding" Value="10,0" /><Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="{ThemeResource AnesthesiaContainerBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource AnesthesiaOutlineBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
  <!-- Shell surfaces (§8-9) -->
  <Style x:Key="AvatarCircle" TargetType="Border">
    <Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /><Setter Property="CornerRadius" Value="17" />
    <Setter Property="Background" Value="{ThemeResource PrimaryContainerBrush}" />
  </Style>
  <Style x:Key="PillSurface" TargetType="Border">
    <Setter Property="Padding" Value="11,9" /><Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" /><Setter Property="BorderThickness" Value="1" />
  </Style>
</ResourceDictionary>
