<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utu="using:Uno.Toolkit.UI">
  <!--
    App-wide lightweight-styling keys (rung 2). Material buttons keep 56 px (only the Settings dialogs still use them;
    screens use the v2 buttons in Tokens.xaml). Cards are outlined with the border colour at radius 12.
    Form fields (v2): outlined at radius 10, 56 px with the floating label, Hanken 14; outline InputEdgeBrush, hover ink-muted, focus
    primary at 2 px. Brushes alias theme brushes per theme so they follow a theme switch.
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <StaticResource x:Key="OutlinedTextBoxBorderBrush" ResourceKey="InputEdgeBrush" />
      <StaticResource x:Key="OutlinedTextBoxBorderBrushPointerOver" ResourceKey="InkMutedBrush" />
      <StaticResource x:Key="OutlinedTextBoxBorderBrushFocused" ResourceKey="PrimaryBrush" />
      <StaticResource x:Key="OutlinedTextBoxHeaderForeground" ResourceKey="InkMutedBrush" />
      <StaticResource x:Key="OutlinedTextBoxHeaderForegroundFocused" ResourceKey="PrimaryBrush" />
      <StaticResource x:Key="OutlinedTextBoxForeground" ResourceKey="InkBrush" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputEdgeBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="InkMutedBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushOpened" ResourceKey="PrimaryBrush" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <StaticResource x:Key="OutlinedTextBoxBorderBrush" ResourceKey="InputEdgeBrush" />
      <StaticResource x:Key="OutlinedTextBoxBorderBrushPointerOver" ResourceKey="InkMutedBrush" />
      <StaticResource x:Key="OutlinedTextBoxBorderBrushFocused" ResourceKey="PrimaryBrush" />
      <StaticResource x:Key="OutlinedTextBoxHeaderForeground" ResourceKey="InkMutedBrush" />
      <StaticResource x:Key="OutlinedTextBoxHeaderForegroundFocused" ResourceKey="PrimaryBrush" />
      <StaticResource x:Key="OutlinedTextBoxForeground" ResourceKey="InkBrush" />
      <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="InputEdgeBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="InkMutedBrush" />
      <StaticResource x:Key="ComboBoxBorderBrushOpened" ResourceKey="PrimaryBrush" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <CornerRadius x:Key="OutlinedTextBoxCornerRadius">10</CornerRadius>
  <x:Double x:Key="OutlinedTextBoxFontSize">14</x:Double>
  <CornerRadius x:Key="ComboBoxCornerRadius">10</CornerRadius>
  <!-- Matches the outlined TextBox (56 px with its floating label), so a ComboBox beside a field lines up. -->
  <x:Double x:Key="ComboBoxMinHeight">56</x:Double>
  <x:Double x:Key="ButtonHeight">56</x:Double>
  <x:Double x:Key="ButtonMinHeight">56</x:Double>
  <CornerRadius x:Key="ButtonCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>

  <!--
    WORKAROUND(CardContentControl washes out after a touch swipe): the Material card templates keep their
    pressed overlay when a swipe that starts on the card is taken by the ScrollViewer (measured here on the
    Android emulator, Toolkit 9.1.3: the Settings "Monitoring" card stayed greyed). Static cards draw only
    their surface and outline; tappable cards keep the stock template.
    xaml-lint: allow template - see WORKAROUND
  -->
  <Style x:Key="StaticOutlinedCardStyle"
         TargetType="utu:CardContentControl"
         BasedOn="{StaticResource OutlinedCardContentControlStyle}">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="utu:CardContentControl">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
