<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="CloverCanvas" Color="#EFEEE7" />
      <SolidColorBrush x:Key="CloverLavender" Color="#E6E5F7" />
      <SolidColorBrush x:Key="CloverLavenderEdge" Color="#DAD9EE" />
      <SolidColorBrush x:Key="CloverMint" Color="#DDF0E6" />
      <SolidColorBrush x:Key="CloverMintEdge" Color="#CEE3D7" />
      <SolidColorBrush x:Key="CloverLime" Color="#E8EFBA" />
      <SolidColorBrush x:Key="CloverSky" Color="#DAEAF0" />
      <SolidColorBrush x:Key="CloverCream" Color="#F4EBDD" />
      <SolidColorBrush x:Key="CloverGlass" Color="#ECFFFEF9" />
      <SolidColorBrush x:Key="CloverSage" Color="#E8EDE2" />
      <!-- Photo panels: placeholder fill drawn by PetBackdrop, and the live surgery band. -->
      <SolidColorBrush x:Key="CloverPhotoBase" Color="#DFEAF0" />
      <SolidColorBrush x:Key="CloverPhotoBlobA" Color="#D4E2CD" />
      <SolidColorBrush x:Key="CloverPhotoBlobB" Color="#F0E7D6" />
      <SolidColorBrush x:Key="CloverGlassEdge" Color="#EFFFFFFF" />
      <SolidColorBrush x:Key="CloverLiveInk" Color="#41604A" />
      <LinearGradientBrush x:Key="CloverLiveBand" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E5E2FA" Offset="0" /><GradientStop Color="#DAEBF3" Offset="0.55" /><GradientStop Color="#DFEEDC" Offset="1" /></LinearGradientBrush>
</ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="CloverCanvas" Color="#111A15" />
      <SolidColorBrush x:Key="CloverLavender" Color="#33374C" />
      <SolidColorBrush x:Key="CloverLavenderEdge" Color="#454A62" />
      <SolidColorBrush x:Key="CloverMint" Color="#244536" />
      <SolidColorBrush x:Key="CloverMintEdge" Color="#375C49" />
      <SolidColorBrush x:Key="CloverLime" Color="#28361F" />
      <SolidColorBrush x:Key="CloverSky" Color="#253F47" />
      <SolidColorBrush x:Key="CloverCream" Color="#3A342B" />
      <SolidColorBrush x:Key="CloverGlass" Color="#EF1A2820" />
      <SolidColorBrush x:Key="CloverSage" Color="#2B3C31" />
      <SolidColorBrush x:Key="CloverPhotoBase" Color="#1F2F35" />
      <SolidColorBrush x:Key="CloverPhotoBlobA" Color="#24372A" />
      <SolidColorBrush x:Key="CloverPhotoBlobB" Color="#332E26" />
      <SolidColorBrush x:Key="CloverGlassEdge" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="CloverLiveInk" Color="#94A39C" />
      <LinearGradientBrush x:Key="CloverLiveBand" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#262A3D" Offset="0" /><GradientStop Color="#1E3137" Offset="0.55" /><GradientStop Color="#203325" Offset="1" /></LinearGradientBrush>
</ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
  <FontFamily x:Key="CloverFont">ms-appx:///Assets/Fonts/PublicSans.ttf</FontFamily>
  <FontFamily x:Key="CloverEditorialFont">Georgia</FontFamily>

  <Style x:Key="CloverDisplay" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CloverFont}" />
    <Setter Property="FontSize" Value="52" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="CharacterSpacing" Value="-40" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="CloverHeading" TargetType="TextBlock" BasedOn="{StaticResource CloverDisplay}">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="CharacterSpacing" Value="-25" />
  </Style>
  <Style x:Key="CloverTitle" TargetType="TextBlock" BasedOn="{StaticResource CloverDisplay}">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="CharacterSpacing" Value="-10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="CloverBody" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource CloverFont}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="CloverLabel" TargetType="TextBlock" BasedOn="{StaticResource CloverBody}">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="CharacterSpacing" Value="100" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style x:Key="CloverIdLabel" TargetType="TextBlock" BasedOn="{StaticResource CloverLabel}">
    <Setter Property="FontFamily" Value="{StaticResource CodeFontFamily}" />
    <Setter Property="FontSize" Value="9" /><Setter Property="CharacterSpacing" Value="100" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>
  <Style x:Key="CloverMetric" TargetType="TextBlock" BasedOn="{StaticResource CloverDisplay}">
    <Setter Property="FontSize" Value="40" />
  </Style>
  <Style x:Key="CloverCard" TargetType="Border">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="24" />
  </Style>
  <Style x:Key="CloverPrimary" TargetType="Button" BasedOn="{StaticResource FilledButtonStyle}">
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="24,12" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontFamily" Value="{StaticResource CloverFont}" />
  </Style>
  <Style x:Key="CloverSecondary" TargetType="Button" BasedOn="{StaticResource OutlinedButtonStyle}">
    <Setter Property="CornerRadius" Value="28" />
    <Setter Property="Padding" Value="20,12" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="FontFamily" Value="{StaticResource CloverFont}" />
  </Style>
  <Style x:Key="CloverQuiet" TargetType="Button" BasedOn="{StaticResource TextButtonStyle}">
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="MinHeight" Value="48" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontFamily" Value="{StaticResource CloverFont}" />
  </Style>
  <Style x:Key="CloverSidebar" TargetType="Button" BasedOn="{StaticResource CloverQuiet}">
    <Setter Property="MinHeight" Value="40" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style x:Key="CloverPatientCard" TargetType="Button">
    <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{ThemeResource OutlineBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="24" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <VisualStateManager.VisualStateGroups>
              <VisualStateGroup x:Name="CommonStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Shell.BorderBrush" Value="{ThemeResource PrimaryBrush}" /><Setter Target="Hover.Opacity" Value="0.04" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Hover.Opacity" Value="0.10" /></VisualState.Setters></VisualState>
                <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="Shell.Opacity" Value="0.5" /></VisualState.Setters></VisualState>
              </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
            <Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Stretch" />
            </Border>
            <Border x:Name="Hover" CornerRadius="{TemplateBinding CornerRadius}" Background="{ThemeResource PrimaryBrush}" Opacity="0" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloverAgendaItem" TargetType="Button" BasedOn="{StaticResource CloverPatientCard}">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="10,10" />
    <Setter Property="MinHeight" Value="48" />
  </Style>
  <Style x:Key="CloverTimeBlock" TargetType="Button" BasedOn="{StaticResource CloverPatientCard}">
    <Setter Property="Padding" Value="9,8" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="0" />
  </Style>
</ResourceDictionary>
