<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Rung-4 custom tokens: vital-sign series colours follow the patient-monitor convention and have no
    Material role. Each series also carries a glyph in the strip (colour is never the only cue):
    HR dot, BP chevrons, SpO2 ring, EtCO2 cross, Temp square.
    The Skia strip reads these from a palette snapshot taken on ActualThemeChanged (never a converter).
  -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="VitalHrColor">#0F8A57</Color>
      <Color x:Key="VitalBpColor">#5F78E2</Color>
      <Color x:Key="VitalSpO2Color">#00707F</Color>
      <Color x:Key="VitalEtCo2Color">#56625D</Color>
      <Color x:Key="VitalTempColor">#A84B00</Color>
      <SolidColorBrush x:Key="VitalHrBrush" Color="{StaticResource VitalHrColor}" />
      <SolidColorBrush x:Key="VitalBpBrush" Color="{StaticResource VitalBpColor}" />
      <SolidColorBrush x:Key="VitalSpO2Brush" Color="{StaticResource VitalSpO2Color}" />
      <SolidColorBrush x:Key="VitalEtCo2Brush" Color="{StaticResource VitalEtCo2Color}" />
      <SolidColorBrush x:Key="VitalTempBrush" Color="{StaticResource VitalTempColor}" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="VitalHrColor">#6FCF9F</Color>
      <Color x:Key="VitalBpColor">#9AAAF0</Color>
      <Color x:Key="VitalSpO2Color">#5CC8D7</Color>
      <Color x:Key="VitalEtCo2Color">#B8C4BF</Color>
      <Color x:Key="VitalTempColor">#FFA54F</Color>
      <SolidColorBrush x:Key="VitalHrBrush" Color="{StaticResource VitalHrColor}" />
      <SolidColorBrush x:Key="VitalBpBrush" Color="{StaticResource VitalBpColor}" />
      <SolidColorBrush x:Key="VitalSpO2Brush" Color="{StaticResource VitalSpO2Color}" />
      <SolidColorBrush x:Key="VitalEtCo2Brush" Color="{StaticResource VitalEtCo2Color}" />
      <SolidColorBrush x:Key="VitalTempBrush" Color="{StaticResource VitalTempColor}" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
