<!--
  Layout values no theme has (hand-authored): the content-split breakpoint, the shell's frame and sidebar, page, sheet and
  pane insets per responsive category, content widths, and the few composite insets of the design's components. Gaps,
  uniform and one-sided spacing use the theme's Space* tokens and corners its Radius* tokens (Uno.Themes: Space100 = 8,
  Radius100 = 4 under Material here); this file holds only what those cannot express (a Thickness with different sides,
  a width, a breakpoint). Pages pick the responsive ones with utu:Responsive (the default 300 / 600 / 800 / 1080
  breakpoints). WinUI cannot StaticResource across sibling merged dictionaries, so the values here are literals.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utu="using:Uno.Toolkit.UI">

  <!--
    Breakpoints: pages use the Toolkit defaults (Narrow 300, Normal 600, Wide 800, Widest 1080), and so does the shell
    (drawer below 600, icon rail 600-1080, full sidebar from 1080). One exception, for two-column content splits on
    Today (live card | care gantt, Due next | care time): from 1080 the full 256 px sidebar leaves the page ~730 px,
    where both splits squeeze a column below its content (gantt axis labels overprinted, a 70 px task column, measured
    at 1080 x 640). They split at 1280 instead, where the page has the ~930 px the prototype's 1090 px frame needs.
  -->
  <utu:ResponsiveLayout x:Key="SplitLayout" Narrowest="150" Narrow="300" Normal="600" Wide="800" Widest="1280" />

  <!-- Insets with different sides (component paddings). -->
  <Thickness x:Key="Inset4x10">4,10</Thickness>
  <Thickness x:Key="Inset8x6">8,6</Thickness>
  <Thickness x:Key="Inset12x8">12,8</Thickness>
  <Thickness x:Key="Inset12x16">12,16</Thickness>
  <Thickness x:Key="Inset24x16">24,16</Thickness>

  <!-- Today hero: 30 px under the greeting (today-dashboard-values.md §2). -->
  <Thickness x:Key="HeroTopGap">0,30,0,0</Thickness>

  <!-- Shell frame (shell-and-tokens.md §7): 12 px from the window, 0 on the sidebar side. -->
  <Thickness x:Key="FrameMarginNarrow">12</Thickness>
  <Thickness x:Key="FrameMarginNormal">0,12,12,12</Thickness>
  <!-- Below Normal: the frame header row with the menu button that opens the sidebar drawer. -->
  <Thickness x:Key="FrameHeaderInset">20,16,20,0</Thickness>
  <Thickness x:Key="SidebarInset">16,24,16,16</Thickness>
  <!-- Full sidebar content width (256 = 224 + 2 x 16 inset) and the icon rail. -->
  <x:Double x:Key="SidebarContentWidth">224</x:Double>
  <x:Double x:Key="SidebarWidth">256</x:Double>
  <x:Double x:Key="RailWidth">72</x:Double>
  <!-- The drawer (MenuFlyout) never grows wider than this. -->
  <x:Double x:Key="DrawerMaxWidth">320</x:Double>

  <!-- Page frame (shell-and-tokens.md §7): content padding inside the frame's scroll area (CSS main padding 36 40 40 40). -->
  <Thickness x:Key="FramePadding">40,36,40,40</Thickness>
  <!-- Page insets per responsive category (FramePadding from Normal up; phones keep 20 px sides). -->
  <Thickness x:Key="PageInsetNarrow">20,28,20,40</Thickness>
  <Thickness x:Key="PageInsetNormal">40,36,40,40</Thickness>
  <!-- Header row of pages whose body scrolls on its own (Record). -->
  <Thickness x:Key="PageHeaderInsetNarrow">20,28,20,0</Thickness>
  <Thickness x:Key="PageHeaderInsetNormal">40,36,40,0</Thickness>
  <Thickness x:Key="PageBodyInsetNarrow">20,20,20,40</Thickness>
  <Thickness x:Key="PageBodyInsetNormal">40,20,40,40</Thickness>
  <!-- Full-page forms with their own back bar (Dose): title and scrolling body sections, then the pinned action bar. -->
  <Thickness x:Key="SheetActionInsetNarrow">20,0,20,20</Thickness>
  <Thickness x:Key="SheetActionInsetNormal">40,0,40,40</Thickness>
  <Thickness x:Key="SheetSectionInsetNarrow">20,0,20,16</Thickness>
  <Thickness x:Key="SheetSectionInsetNormal">40,0,40,24</Thickness>
  <Thickness x:Key="BackBarInsetNarrow">8,8,20,0</Thickness>
  <Thickness x:Key="BackBarInsetNormal">28,16,40,0</Thickness>
  <!-- Flyout sheets (New patient, Sign off). -->
  <Thickness x:Key="SheetInset">24,12,24,24</Thickness>
  <Thickness x:Key="SheetInsetFlush">24,0,24,24</Thickness>
  <!-- Record drawers: 640 wide from the right, the whole window when it is narrower (DrawerFlyoutPresenter takes a
       pixel length as min(length, window)). -->
  <GridLength x:Key="RecordDrawerLength">640</GridLength>
  <!-- Record drawer content. -->
  <Thickness x:Key="PaneInsetNarrow">16,8,16,16</Thickness>
  <Thickness x:Key="PaneInsetWide">24,8,24,24</Thickness>

  <!-- Content widths. At Widest the page column stops growing and centres (the 1440 design frame is 1090 wide). -->
  <x:Double x:Key="ContentMaxWidth">1280</x:Double>
  <x:Double x:Key="FormMaxWidth">640</x:Double>
  <x:Double x:Key="SettingsMaxWidth">720</x:Double>
  <x:Double x:Key="ReadingMaxWidth">960</x:Double>
  <x:Double x:Key="SheetMaxWidth">1040</x:Double>
  <!-- Parent preview: what a pet parent sees on a phone. -->
  <x:Double x:Key="PhonePreviewMaxWidth">460</x:Double>
  <x:Double x:Key="ShortFieldMaxWidth">240</x:Double>
  <!-- Primary pane actions keep one comfortable width; pain-score buttons one square-ish target. -->
  <x:Double x:Key="ActionMinWidth">220</x:Double>
  <x:Double x:Key="ScoreButtonMinWidth">48</x:Double>
  <!-- Patient cards: as many columns as fit at this width (CardColumnsLayout), at most three. -->
  <x:Double x:Key="CardMinColumnWidth">320</x:Double>
  <!-- Today hero live card (today-dashboard-values.md §2, 448 | 1fr) from Widest; full width below. -->
  <x:Double x:Key="HeroCardWidth">448</x:Double>
  <!-- Today's Due next table: the status column (from Wide) and the action column. -->
  <x:Double x:Key="DueStatusWidth">148</x:Double>
  <x:Double x:Key="DueActionWidth">96</x:Double>

  <!-- The compact (M) buttons: between ControlHeightSmall (32) and ControlHeightMedium (40), the design's 36. -->
  <x:Double x:Key="ButtonHeightCompact">36</x:Double>
  <!-- The pane's one-tap "Record reading". -->
  <x:Double x:Key="ActionHeightLarge">64</x:Double>
  <!-- Vital stepper: 48 px buttons and value box (the value is TitleMedium's 20 in the numeral face). -->
  <x:Double x:Key="StepperTarget">48</x:Double>

  <!-- Component insets -->
  <Thickness x:Key="LiveCardInset">20,18</Thickness>
  <Thickness x:Key="LiveCardInsetNarrow">16,14</Thickness>
  <Thickness x:Key="QuietPanelInset">16,14</Thickness>
  <Thickness x:Key="StatusCardInset">14,12</Thickness>
  <Thickness x:Key="ToggleInset">14,10</Thickness>
  <Thickness x:Key="MetricCardInset">20,16,20,28</Thickness>
  <Thickness x:Key="MetricTileInset">19,17</Thickness>
  <Thickness x:Key="CardHeaderInset">6,6,14,6</Thickness>
  <Thickness x:Key="CardBodyInset">14,0,14,14</Thickness>
  <Thickness x:Key="CardTrayMargin">6,6,6,0</Thickness>
  <Thickness x:Key="AlertInset">16,15,16,16</Thickness>
  <Thickness x:Key="ChipInsetRoomy">14,10,12,10</Thickness>
  <Thickness x:Key="ChartInset">12,12,8,4</Thickness>
  <Thickness x:Key="PreviewCardInset">16,18,16,14</Thickness>
  <Thickness x:Key="PreviewBodyInset">16,16,16,40</Thickness>
  <Thickness x:Key="BrandRowInset">8,0,4,0</Thickness>
  <Thickness x:Key="UserRowInset">8,6,0,0</Thickness>
  <Thickness x:Key="TimelineInset">0,4,4,0</Thickness>
  <Thickness x:Key="DueRowInset">8,10</Thickness>
  <Thickness x:Key="SkeletonStepperMargin">8,14,8,0</Thickness>
  <!-- Patient card skeleton: the outer shell's 3 px pad plus the tray's 6 px. -->
  <Thickness x:Key="CardSkeletonInset">9</Thickness>

  <!-- The patient card's Show details toggle: Radius400 on its bottom corners only, under the 16 px tray (no token
       expresses a one-sided corner radius). -->
  <CornerRadius x:Key="RadiusToggleBottom">0,0,16,16</CornerRadius>
</ResourceDictionary>
