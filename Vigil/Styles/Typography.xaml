<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    The type scale, set once for the app (Studio's uno-themes skill, rule 5). Text uses the semantic styles
    (DisplayLarge ... CaptionSmall); this file gives them the design's sizes, weights and line heights
    (docs/design/shell-and-tokens.md §1). The body face, Hanken Grotesk, is the theme's DefaultFontFamily (App.xaml), so
    every slot without a family here takes it, and so do the Material controls. Display and headline titles use the
    design's serif, Newsreader; figures (timers, vitals, doses, clock times) use Martian Mono through the Numeral*
    styles, each based on the semantic style of its size. The tracked copies (tools/track_fonts.py) bake the design's
    negative letter-spacing into the advance widths, because Skia ignores CharacterSpacing: Txx = -0.0xx em.
    Weights resolve through the .ttf.manifest files.
  -->

  <!-- Faces with no theme key: the display serif, the tracked wordmark sans, and the numerals. -->
  <FontFamily x:Key="NumeralFontFamily">ms-appx:///Assets/Fonts/MartianMono.ttf#Martian Mono</FontFamily>
  <FontFamily x:Key="NumeralT20FontFamily">ms-appx:///Assets/Fonts/MartianMonoT20.ttf#Vigil Mono T20</FontFamily>
  <FontFamily x:Key="NumeralT30FontFamily">ms-appx:///Assets/Fonts/MartianMonoT30.ttf#Vigil Mono T30</FontFamily>
  <FontFamily x:Key="NumeralT50FontFamily">ms-appx:///Assets/Fonts/MartianMonoT50.ttf#Vigil Mono T50</FontFamily>

  <!-- Shared by every slot: on-surface ink, and line heights that hold the block (the design's line-height). -->
  <Style x:Key="TypeScaleBase" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{ThemeResource OnSurfaceBrush}" />
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
  </Style>

  <!-- DisplayLarge: 64/68 Normal, the live timer, in numerals. -->
  <FontFamily x:Key="DisplayLargeFontFamily">ms-appx:///Assets/Fonts/NewsreaderT20.ttf#Vigil Serif T20</FontFamily>
  <x:Double x:Key="DisplayLargeFontSize">64</x:Double>
  <FontWeight x:Key="DisplayLargeFontWeight">Normal</FontWeight>
  <x:Double x:Key="DisplayLargeLineHeight">68</x:Double>
  <Style x:Key="DisplayLarge" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource DisplayLargeFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource DisplayLargeFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource DisplayLargeLineHeight}" />
  </Style>
  <!-- DisplayMedium: 56/60 Normal, the Today greeting; the record timer in numerals. -->
  <FontFamily x:Key="DisplayMediumFontFamily">ms-appx:///Assets/Fonts/NewsreaderT20.ttf#Vigil Serif T20</FontFamily>
  <x:Double x:Key="DisplayMediumFontSize">56</x:Double>
  <FontWeight x:Key="DisplayMediumFontWeight">Normal</FontWeight>
  <x:Double x:Key="DisplayMediumLineHeight">60</x:Double>
  <Style x:Key="DisplayMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{StaticResource DisplayMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource DisplayMediumFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource DisplayMediumFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource DisplayMediumLineHeight}" />
  </Style>
  <!-- DisplaySmall: 48/52 Normal, vitals in numerals. -->
  <FontFamily x:Key="DisplaySmallFontFamily">ms-appx:///Assets/Fonts/NewsreaderT20.ttf#Vigil Serif T20</FontFamily>
  <x:Double x:Key="DisplaySmallFontSize">48</x:Double>
  <FontWeight x:Key="DisplaySmallFontWeight">Normal</FontWeight>
  <x:Double x:Key="DisplaySmallLineHeight">52</x:Double>
  <Style x:Key="DisplaySmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{StaticResource DisplaySmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource DisplaySmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource DisplaySmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource DisplaySmallLineHeight}" />
  </Style>
  <!-- HeadlineLarge: 40/46 Normal, page titles and the patient name. -->
  <FontFamily x:Key="HeadlineLargeFontFamily">ms-appx:///Assets/Fonts/NewsreaderT15.ttf#Vigil Serif T15</FontFamily>
  <x:Double x:Key="HeadlineLargeFontSize">40</x:Double>
  <FontWeight x:Key="HeadlineLargeFontWeight">Normal</FontWeight>
  <x:Double x:Key="HeadlineLargeLineHeight">46</x:Double>
  <Style x:Key="HeadlineLarge" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{StaticResource HeadlineLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource HeadlineLargeFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource HeadlineLargeFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource HeadlineLargeLineHeight}" />
  </Style>
  <!-- HeadlineMedium: 30/36 Medium, large stats in numerals. -->
  <x:Double x:Key="HeadlineMediumFontSize">30</x:Double>
  <FontWeight x:Key="HeadlineMediumFontWeight">Medium</FontWeight>
  <x:Double x:Key="HeadlineMediumLineHeight">36</x:Double>
  <Style x:Key="HeadlineMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource HeadlineMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource HeadlineMediumFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource HeadlineMediumFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource HeadlineMediumLineHeight}" />
  </Style>
  <!-- HeadlineSmall: 28/32 Medium, stats in numerals. -->
  <x:Double x:Key="HeadlineSmallFontSize">28</x:Double>
  <FontWeight x:Key="HeadlineSmallFontWeight">Medium</FontWeight>
  <x:Double x:Key="HeadlineSmallLineHeight">32</x:Double>
  <Style x:Key="HeadlineSmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource HeadlineSmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource HeadlineSmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource HeadlineSmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource HeadlineSmallLineHeight}" />
  </Style>
  <!-- TitleLarge: 24/28 Medium, the clover wordmark; small stats in numerals. -->
  <FontFamily x:Key="TitleLargeFontFamily">ms-appx:///Assets/Fonts/HankenGroteskT20.ttf#Vigil Sans T20</FontFamily>
  <x:Double x:Key="TitleLargeFontSize">24</x:Double>
  <FontWeight x:Key="TitleLargeFontWeight">Medium</FontWeight>
  <x:Double x:Key="TitleLargeLineHeight">28</x:Double>
  <Style x:Key="TitleLarge" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{StaticResource TitleLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TitleLargeFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource TitleLargeFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource TitleLargeLineHeight}" />
  </Style>
  <!-- TitleMedium: 20/28 SemiBold, section headings, card names; card timers in numerals. -->
  <x:Double x:Key="TitleMediumFontSize">20</x:Double>
  <FontWeight x:Key="TitleMediumFontWeight">SemiBold</FontWeight>
  <x:Double x:Key="TitleMediumLineHeight">28</x:Double>
  <Style x:Key="TitleMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource TitleMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TitleMediumFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource TitleMediumFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource TitleMediumLineHeight}" />
  </Style>
  <!-- TitleSmall: 18/24 SemiBold, card and drawer titles; values in numerals. -->
  <x:Double x:Key="TitleSmallFontSize">18</x:Double>
  <FontWeight x:Key="TitleSmallFontWeight">SemiBold</FontWeight>
  <x:Double x:Key="TitleSmallLineHeight">24</x:Double>
  <Style x:Key="TitleSmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource TitleSmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource TitleSmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource TitleSmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource TitleSmallLineHeight}" />
  </Style>
  <!-- BodyLarge: 16/24 Normal, lead copy; card headings in SemiBold. -->
  <x:Double x:Key="BodyLargeFontSize">16</x:Double>
  <FontWeight x:Key="BodyLargeFontWeight">Normal</FontWeight>
  <x:Double x:Key="BodyLargeLineHeight">24</x:Double>
  <Style x:Key="BodyLarge" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource BodyLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource BodyLargeFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource BodyLargeFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource BodyLargeLineHeight}" />
  </Style>
  <!-- BodyMedium: 14/20 Normal, body copy, with Medium and SemiBold for emphasis. -->
  <x:Double x:Key="BodyMediumFontSize">14</x:Double>
  <FontWeight x:Key="BodyMediumFontWeight">Normal</FontWeight>
  <x:Double x:Key="BodyMediumLineHeight">20</x:Double>
  <Style x:Key="BodyMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource BodyMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource BodyMediumFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource BodyMediumFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource BodyMediumLineHeight}" />
  </Style>
  <!-- BodySmall: 13/18 Normal, secondary copy. -->
  <x:Double x:Key="BodySmallFontSize">13</x:Double>
  <FontWeight x:Key="BodySmallFontWeight">Normal</FontWeight>
  <x:Double x:Key="BodySmallLineHeight">18</x:Double>
  <Style x:Key="BodySmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource BodySmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource BodySmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource BodySmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource BodySmallLineHeight}" />
  </Style>
  <!-- LabelLarge: 15/20 SemiBold, small titles (blocks, rows). -->
  <x:Double x:Key="LabelLargeFontSize">15</x:Double>
  <FontWeight x:Key="LabelLargeFontWeight">SemiBold</FontWeight>
  <x:Double x:Key="LabelLargeLineHeight">20</x:Double>
  <Style x:Key="LabelLarge" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource LabelLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelLargeFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource LabelLargeFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource LabelLargeLineHeight}" />
  </Style>
  <!-- LabelMedium: 13/20 SemiBold, small button labels. -->
  <x:Double x:Key="LabelMediumFontSize">13</x:Double>
  <FontWeight x:Key="LabelMediumFontWeight">SemiBold</FontWeight>
  <x:Double x:Key="LabelMediumLineHeight">20</x:Double>
  <Style x:Key="LabelMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource LabelMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelMediumFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource LabelMediumFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource LabelMediumLineHeight}" />
  </Style>
  <!-- LabelSmall: 11/14 Medium, micro labels. -->
  <x:Double x:Key="LabelSmallFontSize">11</x:Double>
  <FontWeight x:Key="LabelSmallFontWeight">Medium</FontWeight>
  <x:Double x:Key="LabelSmallLineHeight">14</x:Double>
  <Style x:Key="LabelSmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource LabelSmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelSmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource LabelSmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource LabelSmallLineHeight}" />
  </Style>
  <!-- LabelExtraSmall: 10/12 Medium, chart labels in numerals. -->
  <x:Double x:Key="LabelExtraSmallFontSize">10</x:Double>
  <FontWeight x:Key="LabelExtraSmallFontWeight">Medium</FontWeight>
  <x:Double x:Key="LabelExtraSmallLineHeight">12</x:Double>
  <Style x:Key="LabelExtraSmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource LabelExtraSmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource LabelExtraSmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource LabelExtraSmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource LabelExtraSmallLineHeight}" />
  </Style>
  <!-- CaptionLarge: 12/16 Normal, captions, eyebrows in SemiBold. -->
  <x:Double x:Key="CaptionLargeFontSize">12</x:Double>
  <FontWeight x:Key="CaptionLargeFontWeight">Normal</FontWeight>
  <x:Double x:Key="CaptionLargeLineHeight">16</x:Double>
  <Style x:Key="CaptionLarge" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource CaptionLargeFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionLargeFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource CaptionLargeFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource CaptionLargeLineHeight}" />
  </Style>
  <!-- CaptionMedium: 11/16 Normal, not used by the design. -->
  <x:Double x:Key="CaptionMediumFontSize">11</x:Double>
  <FontWeight x:Key="CaptionMediumFontWeight">Normal</FontWeight>
  <x:Double x:Key="CaptionMediumLineHeight">16</x:Double>
  <Style x:Key="CaptionMedium" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource CaptionMediumFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionMediumFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource CaptionMediumFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource CaptionMediumLineHeight}" />
  </Style>
  <!-- CaptionSmall: 10/14 Normal, not used by the design. -->
  <x:Double x:Key="CaptionSmallFontSize">10</x:Double>
  <FontWeight x:Key="CaptionSmallFontWeight">Normal</FontWeight>
  <x:Double x:Key="CaptionSmallLineHeight">14</x:Double>
  <Style x:Key="CaptionSmall" TargetType="TextBlock" BasedOn="{StaticResource TypeScaleBase}">
    <Setter Property="FontFamily" Value="{ThemeResource CaptionSmallFontFamily}" />
    <Setter Property="FontSize" Value="{StaticResource CaptionSmallFontSize}" />
    <Setter Property="FontWeight" Value="{StaticResource CaptionSmallFontWeight}" />
    <Setter Property="LineHeight" Value="{StaticResource CaptionSmallLineHeight}" />
  </Style>

  <!-- Figures: Martian Mono Medium at the size of the semantic style they are based on (line height as the design). -->
  <Style x:Key="NumeralDisplayLarge" TargetType="TextBlock" BasedOn="{StaticResource DisplayLarge}"><Setter Property="FontFamily" Value="{StaticResource NumeralT50FontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralDisplayMedium" TargetType="TextBlock" BasedOn="{StaticResource DisplayMedium}"><Setter Property="FontFamily" Value="{StaticResource NumeralT50FontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralDisplaySmall" TargetType="TextBlock" BasedOn="{StaticResource DisplaySmall}"><Setter Property="FontFamily" Value="{StaticResource NumeralT50FontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralHeadlineMedium" TargetType="TextBlock" BasedOn="{StaticResource HeadlineMedium}"><Setter Property="FontFamily" Value="{StaticResource NumeralT30FontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralHeadlineSmall" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmall}"><Setter Property="FontFamily" Value="{StaticResource NumeralT30FontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralTitleLarge" TargetType="TextBlock" BasedOn="{StaticResource TitleLarge}"><Setter Property="FontFamily" Value="{StaticResource NumeralT30FontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="LineHeight" Value="30" /></Style>
  <Style x:Key="NumeralTitleMedium" TargetType="TextBlock" BasedOn="{StaticResource TitleMedium}"><Setter Property="FontFamily" Value="{StaticResource NumeralT20FontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="LineHeight" Value="24" /></Style>
  <Style x:Key="NumeralTitleSmall" TargetType="TextBlock" BasedOn="{StaticResource TitleSmall}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="LineHeight" Value="26" /></Style>
  <Style x:Key="NumeralBodyLarge" TargetType="TextBlock" BasedOn="{StaticResource BodyLarge}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="LineHeight" Value="22" /></Style>
  <Style x:Key="NumeralBodyMedium" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="LineHeight" Value="18" /></Style>
  <Style x:Key="NumeralBodySmall" TargetType="TextBlock" BasedOn="{StaticResource BodySmall}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralCaptionLarge" TargetType="TextBlock" BasedOn="{StaticResource CaptionLarge}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
  <Style x:Key="NumeralLabelSmall" TargetType="TextBlock" BasedOn="{StaticResource LabelSmall}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="LineHeight" Value="16" /></Style>
  <Style x:Key="NumeralLabelExtraSmall" TargetType="TextBlock" BasedOn="{StaticResource LabelExtraSmall}"><Setter Property="FontFamily" Value="{StaticResource NumeralFontFamily}" /><Setter Property="FontWeight" Value="Medium" /></Style>
</ResourceDictionary>
