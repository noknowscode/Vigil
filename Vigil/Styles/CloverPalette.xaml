<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Clover material color roles. Authored with docs/design/CLOVER.md. -->
  <!-- Material color roles for Light and Dark. Use as MaterialTheme.Colors OverrideSource (ThemeColors). -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="PrimaryColor">#244936</Color>
      <Color x:Key="OnPrimaryColor">#FFFEF9</Color>
      <Color x:Key="PrimaryContainerColor">#EAF0D4</Color>
      <Color x:Key="OnPrimaryContainerColor">#193627</Color>
      <Color x:Key="SecondaryColor">#416B7C</Color>
      <Color x:Key="OnSecondaryColor">#FFFEF9</Color>
      <Color x:Key="SecondaryContainerColor">#DFEEF1</Color>
      <Color x:Key="OnSecondaryContainerColor">#132C3A</Color>
      <Color x:Key="TertiaryColor">#00707F</Color>
      <Color x:Key="OnTertiaryColor">#FFFEF9</Color>
      <Color x:Key="TertiaryContainerColor">#CFEBF0</Color>
      <Color x:Key="OnTertiaryContainerColor">#002F36</Color>
      <Color x:Key="ErrorColor">#B3261E</Color>
      <Color x:Key="OnErrorColor">#FFFEF9</Color>
      <Color x:Key="ErrorContainerColor">#FFDBD5</Color>
      <Color x:Key="OnErrorContainerColor">#540001</Color>
      <Color x:Key="BackgroundColor">#F8F5ED</Color>
      <Color x:Key="OnBackgroundColor">#203B2B</Color>
      <Color x:Key="SurfaceColor">#FFFEF9</Color>
      <Color x:Key="OnSurfaceColor">#203B2B</Color>
      <Color x:Key="SurfaceVariantColor">#EFEDE4</Color>
      <Color x:Key="OnSurfaceVariantColor">#5E6B61</Color>
      <Color x:Key="OutlineColor">#D9DED2</Color>
      <Color x:Key="OutlineVariantColor">#E1E6E3</Color>
      <Color x:Key="SurfaceTintColor">#244936</Color>
      <Color x:Key="SurfaceInverseColor">#203B2B</Color>
      <Color x:Key="OnSurfaceInverseColor">#FFFEF9</Color>
      <Color x:Key="PrimaryInverseColor">#DCEB9D</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="PrimaryColor">#DCEB9D</Color>
      <Color x:Key="OnPrimaryColor">#203B2B</Color>
      <Color x:Key="PrimaryContainerColor">#344B38</Color>
      <Color x:Key="OnPrimaryContainerColor">#E6EDCD</Color>
      <Color x:Key="SecondaryColor">#9DB8C9</Color>
      <Color x:Key="OnSecondaryColor">#071822</Color>
      <Color x:Key="SecondaryContainerColor">#263843</Color>
      <Color x:Key="OnSecondaryContainerColor">#D2E0EA</Color>
      <Color x:Key="TertiaryColor">#5CC8D7</Color>
      <Color x:Key="OnTertiaryColor">#001A1E</Color>
      <Color x:Key="TertiaryContainerColor">#0A3C44</Color>
      <Color x:Key="OnTertiaryContainerColor">#C5E5EB</Color>
      <Color x:Key="ErrorColor">#FF6B5E</Color>
      <Color x:Key="OnErrorColor">#320001</Color>
      <Color x:Key="ErrorContainerColor">#611711</Color>
      <Color x:Key="OnErrorContainerColor">#FFD2CB</Color>
      <Color x:Key="BackgroundColor">#121C17</Color>
      <Color x:Key="OnBackgroundColor">#E4EAE6</Color>
      <Color x:Key="SurfaceColor">#1A2820</Color>
      <Color x:Key="OnSurfaceColor">#E4EAE6</Color>
      <Color x:Key="SurfaceVariantColor">#26372D</Color>
      <Color x:Key="OnSurfaceVariantColor">#94A39C</Color>
      <Color x:Key="OutlineColor">#3D5144</Color>
      <Color x:Key="OutlineVariantColor">#212825</Color>
      <Color x:Key="SurfaceTintColor">#DCEB9D</Color>
      <Color x:Key="SurfaceInverseColor">#FFFEF9</Color>
      <Color x:Key="OnSurfaceInverseColor">#203B2B</Color>
      <Color x:Key="PrimaryInverseColor">#244936</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
