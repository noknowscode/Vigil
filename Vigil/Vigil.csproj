<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-browserwasm;net10.0-desktop;net10.0</TargetFrameworks>
    <!--
      App-only override for single-head builds (CI, RID-specific publish): -p:VigilTargetFrameworks=net10.0-desktop.
      A global -p:TargetFrameworks would also retarget the test project and silently drop its tests.
    -->
    <TargetFrameworks Condition="'$(VigilTargetFrameworks)' != ''">$(VigilTargetFrameworks)</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Display name -->
    <ApplicationTitle>Clover</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.unoplatform.vigil</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Clover</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Vigil: the anesthesia record for veterinary surgical technicians. An Uno Platform reference app.</Description>
    <!-- Uno0001 = member not implemented in Uno Platform: fail the build instead of shipping a silent no-op. -->
    <WarningsAsErrors>$(WarningsAsErrors);Uno0001</WarningsAsErrors>
    <!--
      Uno.Sdk 6.7.30 adds Microsoft.Windows.Compatibility 10.0.12 to the WASM head, which pulls in
      System.Security.Cryptography.Xml/Pkcs 10.0.12 (GHSA-846f-f764-76mx, GHSA-r955-8q5j-3h83, GHSA-7hqp-7c5m-4vq6,
      GHSA-c399-9853-6jmj, GHSA-2fmv-rv2c-59x7). Remove when Uno.Sdk pins 10.0.14 or later.
    -->
    <WindowsCompatibilityVersion>10.0.14</WindowsCompatibilityVersion>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      Material;
      Hosting;
      Toolkit;
      Logging;
      MVUX;
      Configuration;
      Localization;
      Navigation;
      ThemeService;
      SkiaRenderer;
      Skia;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data/formulary.json" LogicalName="Vigil.Data.formulary.json" />
    <Content Include="Assets\Fonts\*.manifest" />
  </ItemGroup>

</Project>
