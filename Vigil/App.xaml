<Application x:Class="Vigil.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utum="using:Uno.Toolkit.UI.Material">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme ColorOverrideSource="ms-appx:///Styles/CloverPalette.xaml">
          <!-- Material controls stay Roboto without this (FontOverrideSource). Weights resolve through the .ttf.manifest files. -->
          <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk.ttf</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk.ttf</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk_Medium.ttf</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary>
        </utum:MaterialToolkitTheme>
        <!-- Generated by DesignMd2Uno from docs/design/DESIGN.md: regenerate, never hand-edit. -->
        <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
        <!-- App tokens -->
        <ResourceDictionary Source="ms-appx:///Styles/VitalsPalette.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Clover.xaml" />
        <!-- v2 tokens: brushes, radii, type ramp, buttons, nav item, badges; icons (Lucide geometry) first, Tokens uses them -->
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Presentation/Board/CaseCards.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

</Application>
