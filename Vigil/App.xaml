<Application x:Class="Vigil.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:ut="using:Uno.Themes"
       xmlns:controls="using:Vigil.Controls">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <!--
          Material with the Toolkit: the look comes from the theme.
          - Colour: the palette (Styles/ColorPaletteOverride.xaml, Light and Default) is the one place brand and neutral
            colours live. Uno Platform Studio's Themes tab edits it, and every role brush and control follows. Text,
            surfaces, borders, the accent and alerts use the role brushes (OnSurfaceBrush, SurfaceBrush,
            OutlineVariantBrush, PrimaryBrush, ErrorBrush...).
          - Type: DefaultFontFamily is the body face, Hanken Grotesk, for every type-scale slot and every Material control
            (the weights resolve through its .ttf.manifest); Styles/Typography.xaml sets the design's sizes on the scale.
          - Spacing, corners and heights: the theme's Space*, Radius*, ControlHeight* and IconSize* tokens, at the theme's
            defaults (DefaultSpacing 8, DefaultCornerRadius 4).
        -->
        <utum:MaterialToolkitTheme DefaultFontFamily="ms-appx:///Assets/Fonts/HankenGrotesk.ttf#Hanken Grotesk">
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/ColorPaletteOverride.xaml" />
          </utum:MaterialToolkitTheme.Colors>
        </utum:MaterialToolkitTheme>
        <!-- The type scale: the semantic styles at the design's sizes, and the Numeral* styles for figures. -->
        <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
        <!-- Layout values no theme has: breakpoints, widths, page and component insets. -->
        <ResourceDictionary Source="ms-appx:///Styles/Layout.xaml" />
        <!-- Icon geometry (Lucide), then the control styles that draw it: buttons, nav item, cards, badges, shadows. -->
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
        <!-- The record's drawers: presenter style and FeedView states (after Controls and Layout, which they use) -->
        <ResourceDictionary Source="ms-appx:///Presentation/Record/Drawers/RecordDrawer.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!--
        Colours with no palette role (Studio's uno-themes skill, rule 4): the care stages, the vital-sign series and the
        shadow ink. Everything else is a role brush from the palette above. A status is never colour alone: each stage
        also has its label and its position on the stepper, each vital series its glyph, each alert its icon and text.
      -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <!-- Care stages: solid (bars, dots, sparkline), container (soft fill), on-container (text on the fill), outline
               (the fill's edge and the stepper segment). Error and overdue states use the Error role. -->
          <SolidColorBrush x:Key="AnesthesiaBrush" Color="#0F8A57" />
          <SolidColorBrush x:Key="AnesthesiaContainerBrush" Color="#D5ECE0" />
          <SolidColorBrush x:Key="OnAnesthesiaContainerBrush" Color="#005527" />
          <SolidColorBrush x:Key="AnesthesiaOutlineBrush" Color="#B8DDC8" />
          <SolidColorBrush x:Key="PrepBrush" Color="#C97A2E" />
          <SolidColorBrush x:Key="PrepContainerBrush" Color="#FCE3C6" />
          <SolidColorBrush x:Key="OnPrepContainerBrush" Color="#7A4A1C" />
          <SolidColorBrush x:Key="PrepOutlineBrush" Color="#F1D2AE" />
          <SolidColorBrush x:Key="RecoveryBrush" Color="#5F78E2" />
          <SolidColorBrush x:Key="RecoveryContainerBrush" Color="#E5E8F9" />
          <SolidColorBrush x:Key="RecoveryOutlineBrush" Color="#CDD3F3" />
          <SolidColorBrush x:Key="WaitingBrush" Color="#7E828B" />
          <SolidColorBrush x:Key="HomeBrush" Color="#DCE7E0" />
          <!-- Vital-sign series, the patient-monitor convention; each also carries a glyph on the vitals pad (HR dot,
               BP chevrons, SpO2 ring, EtCO2 cross, Temp square). -->
          <SolidColorBrush x:Key="VitalHrBrush" Color="#0F8A57" />
          <SolidColorBrush x:Key="VitalBpBrush" Color="#5F78E2" />
          <SolidColorBrush x:Key="VitalSpO2Brush" Color="#00707F" />
          <SolidColorBrush x:Key="VitalEtCo2Brush" Color="#56625D" />
          <SolidColorBrush x:Key="VitalTempBrush" Color="#A84B00" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
          <SolidColorBrush x:Key="AnesthesiaBrush" Color="#4FC28E" />
          <SolidColorBrush x:Key="AnesthesiaContainerBrush" Color="#17372A" />
          <SolidColorBrush x:Key="OnAnesthesiaContainerBrush" Color="#9BE0BC" />
          <SolidColorBrush x:Key="AnesthesiaOutlineBrush" Color="#24513D" />
          <SolidColorBrush x:Key="PrepBrush" Color="#E6A766" />
          <SolidColorBrush x:Key="PrepContainerBrush" Color="#3D2A16" />
          <SolidColorBrush x:Key="OnPrepContainerBrush" Color="#FCE3C6" />
          <SolidColorBrush x:Key="PrepOutlineBrush" Color="#5A3D1F" />
          <SolidColorBrush x:Key="RecoveryBrush" Color="#9AAAF0" />
          <SolidColorBrush x:Key="RecoveryContainerBrush" Color="#262B45" />
          <SolidColorBrush x:Key="RecoveryOutlineBrush" Color="#3A4166" />
          <SolidColorBrush x:Key="WaitingBrush" Color="#8E929B" />
          <SolidColorBrush x:Key="HomeBrush" Color="#24392D" />
          <SolidColorBrush x:Key="VitalHrBrush" Color="#6FCF9F" />
          <SolidColorBrush x:Key="VitalBpBrush" Color="#9AAAF0" />
          <SolidColorBrush x:Key="VitalSpO2Brush" Color="#5CC8D7" />
          <SolidColorBrush x:Key="VitalEtCo2Brush" Color="#B8C4BF" />
          <SolidColorBrush x:Key="VitalTempBrush" Color="#FFA54F" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

      <!-- Shadow ink: utu:Shadow is not a FrameworkElement, so the shadows (Themes/Controls.xaml) take one colour in both
           themes. The palette's ShadowColor carries its own 20 % alpha, which the design's shadow opacities would divide. -->
      <Color x:Key="ShadowInkColor">#1B212F</Color>

      <!-- bool -> Visibility for {Binding}: WinUI has no implicit conversion outside x:Bind. -->
      <controls:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
