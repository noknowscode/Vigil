<Application x:Class="Vigil.App"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:utum="using:Uno.Toolkit.UI.Material"
       xmlns:ut="using:Uno.Themes"
       xmlns:controls="using:Vigil.Controls">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- Load WinUI resources -->
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
        <utum:MaterialToolkitTheme>
          <!-- Uno Themes 9: colour overrides live on Colors (ColorOverrideSource is deprecated). -->
          <utum:MaterialToolkitTheme.Colors>
            <ut:ThemeColors OverrideSource="ms-appx:///Styles/CloverPalette.xaml" />
          </utum:MaterialToolkitTheme.Colors>
          <!-- Material controls stay Roboto without this (FontOverrideSource). Weights resolve through the .ttf.manifest files. -->
          <utum:MaterialToolkitTheme.FontOverrideDictionary>
            <ResourceDictionary>
              <FontFamily x:Key="MaterialLightFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk.ttf#Hanken Grotesk</FontFamily>
              <FontFamily x:Key="MaterialRegularFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk.ttf#Hanken Grotesk</FontFamily>
              <FontFamily x:Key="MaterialMediumFontFamily">ms-appx:///Assets/Fonts/HankenGrotesk_Medium.ttf#Hanken Grotesk</FontFamily>
            </ResourceDictionary>
          </utum:MaterialToolkitTheme.FontOverrideDictionary>
        </utum:MaterialToolkitTheme>
        <!-- Generated by DesignMd2Uno from docs/design/DESIGN.md: regenerate, never hand-edit. -->
        <ResourceDictionary Source="ms-appx:///Styles/Typography.xaml" />
        <!-- App tokens -->
        <ResourceDictionary Source="ms-appx:///Styles/VitalsPalette.xaml" />
        <!-- v2 tokens: brushes, radii, type ramp, buttons, nav item, badges; icons (Lucide geometry) first, Tokens uses them -->
        <ResourceDictionary Source="ms-appx:///Themes/Icons.xaml" />
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
        <!-- Material lightweight keys; after Tokens because the form-field keys alias token brushes -->
        <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
        <!-- Layout tokens: spacing scale, insets per responsive category, content widths, the content-split breakpoint -->
        <ResourceDictionary Source="ms-appx:///Styles/Layout.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- bool -> Visibility for {Binding}: WinUI has no implicit conversion outside x:Bind. -->
      <controls:VisibleWhenTrueConverter x:Key="VisibleWhenTrue" />
    </ResourceDictionary>
  </Application.Resources>

</Application>
