<UserControl x:Class="Vigil.Controls.CareMark" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False">
  <Viewbox><Grid x:Name="Leaves" Width="36" Height="40" RenderTransformOrigin="0.5,0.5"><Grid.RenderTransform><CompositeTransform /></Grid.RenderTransform>
    <Ellipse Width="17" Height="20" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,0,0,0" />
    <Ellipse Width="17" Height="20" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,1,0" />
    <Ellipse Width="17" Height="20" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,16,0,0" />
    <Ellipse Width="17" Height="20" Fill="{ThemeResource PrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,1,0" />
    <Ellipse Width="7" Height="7" Fill="{ThemeResource CloverLime}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,4" />
    <Path Data="M 18,25 C 18,32 21,36 27,39" Stroke="{ThemeResource PrimaryBrush}" StrokeThickness="2" />
  </Grid></Viewbox>
</UserControl>
