<!--
  Patient care hero status card (docs/design/patient-care-values.md §3.2, "Anesthesia card"): pad 12 14, radius 14,
  tone soft fill + border, inset-strip shadow; label row (pulse dot, mono label, "since"), Martian 56 timer, the
  recorded-HR sparkline (SPEC-v2 decision 3, in place of the prototype's ECG), a two-value divider grid and the
  overdue line. DataContext: the record's CaseTimers. One layout for every stage: the tone visual state (from
  Status.ToneState, via utu:VisualStateManagerExtensions) swaps fill, border and inks.
-->
<UserControl x:Class="Vigil.Controls.CareStatusCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI"
             utu:VisualStateManagerExtensions.States="{Binding Care.ToneState}">
  <Grid x:Name="Root" AutomationProperties.Name="{Binding Care.AccessibleName}">
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="ToneStates">
        <VisualState x:Name="Surgery" />
        <VisualState x:Name="Recovery">
          <VisualState.Setters>
            <Setter Target="Surface.Background" Value="{ThemeResource RecoveryContainerBrush}" />
            <Setter Target="Edge.BorderBrush" Value="{ThemeResource RecoveryOutlineBrush}" />
            <Setter Target="Divider.BorderBrush" Value="{ThemeResource RecoveryOutlineBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource RecoveryBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
            <Setter Target="Since.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
            <Setter Target="FirstLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
            <Setter Target="SecondLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Prep">
          <VisualState.Setters>
            <Setter Target="Surface.Background" Value="{ThemeResource PrepContainerBrush}" />
            <Setter Target="Edge.BorderBrush" Value="{ThemeResource PrepOutlineBrush}" />
            <Setter Target="Divider.BorderBrush" Value="{ThemeResource PrepOutlineBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource PrepBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource OnPrepContainerBrush}" />
            <Setter Target="Since.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
            <Setter Target="FirstLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
            <Setter Target="SecondLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Neutral">
          <VisualState.Setters>
            <Setter Target="Surface.Background" Value="{ThemeResource SurfaceBrush}" />
            <Setter Target="Edge.BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
            <Setter Target="Divider.BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
            <Setter Target="Dot.Fill" Value="{ThemeResource WaitingBrush}" />
            <Setter Target="Label.Foreground" Value="{ThemeResource OnSurfaceBrush}" />
            <Setter Target="Since.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
            <Setter Target="FirstLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
            <Setter Target="SecondLabel.Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Surface: tone fill, inset shade (inset 0 1px 3px rgba(0,0,0,.12)) and tone edge as rounded Borders (a filled
         ShadowContainer with an inner shadow painted its fill square on Skia). -->
    <!-- xaml-lint: allow card - state-driven tone fill -->
    <Border x:Name="Surface" CornerRadius="{StaticResource Radius14}" Background="{ThemeResource AnesthesiaContainerBrush}" />
    <!-- xaml-lint: allow card - inset shade over the fill -->
    <Border CornerRadius="{StaticResource Radius14}" Background="{ThemeResource InsetShadeBrush}" IsHitTestVisible="False" />
    <!-- xaml-lint: allow card - state-driven tone stroke -->
    <Border x:Name="Edge" CornerRadius="{StaticResource Radius14}" BorderThickness="1" BorderBrush="{ThemeResource AnesthesiaOutlineBrush}" />

    <Grid Padding="{StaticResource StatusCardInset}" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space8}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
          <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{ThemeResource AnesthesiaBrush}" VerticalAlignment="Center" />
          <TextBlock x:Name="Label" Text="{Binding Care.Label}" Style="{StaticResource NumeralCaptionLarge}" Foreground="{ThemeResource OnAnesthesiaContainerBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="Since" Grid.Column="1" Text="{Binding Care.Since}" Style="{StaticResource NumeralCaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
      </Grid>
      <TextBlock Grid.Row="1" Margin="{StaticResource GapTop2}" Text="{Binding Care.Timer}" Style="{StaticResource NumeralDisplayMedium}" />
      <!-- Recorded heart rate (last 13 readings), 32 px, stroke 1.6, while the patient is under anesthesia. -->
      <Grid Grid.Row="2" Height="32" Margin="{StaticResource GapTop2}" Visibility="{Binding Care.IsSurgery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" AutomationProperties.AccessibilityView="Raw">
        <Path Data="{Binding HrSpark.Data}" Margin="{Binding HrSpark.LineMargin}" Height="{Binding HrSpark.Height}" VerticalAlignment="Top" Stretch="Fill"
              Stroke="{ThemeResource AnesthesiaBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      </Grid>
      <Grid x:Name="Divider" Grid.Row="4" Padding="{StaticResource GapTop10}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource AnesthesiaOutlineBrush}" ColumnDefinitions="*,*" ColumnSpacing="{StaticResource Space12}">
        <StackPanel>
          <TextBlock x:Name="FirstLabel" Text="{Binding Care.FirstLabel}" Style="{StaticResource CaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Care.FirstValue}" Style="{StaticResource NumeralBodyLarge}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock x:Name="SecondLabel" Text="{Binding Care.SecondLabel}" Style="{StaticResource CaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
          <TextBlock Text="{Binding Care.SecondValue}" Style="{StaticResource NumeralBodyLarge}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </Grid>
      <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="{StaticResource Space6}" Margin="{StaticResource GapTop10}" Visibility="{Binding Care.HasAlert, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
        <ContentControl Style="{StaticResource LineIcon14Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Care.Alert}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
