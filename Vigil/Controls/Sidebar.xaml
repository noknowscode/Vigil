<!--
  The sidebar (docs/design/shell-and-tokens.md §8), bound to ShellModel in the shell and to MenuModel in the "!Menu"
  drawer on phones (both expose the same members). Width: 256 full, 72 as the icon rail (Normal and Wide, 600-1080 px,
  or collapsed by the user from Widest, 1080). Labels are "full only": an outer element carries the width rule (utu:Responsive) and an inner one the
  model's IsExpanded, so width and state stay separate (uno-scaffolding, Breakpoints).
  Only working destinations are listed: the design's clinic switcher, Records, Messages, Reports, Help center and
  account menu have no screen and were cut (docs/DECISIONS.md D7, superseding D6). The "No monitor connected" pill
  stays as a status: Vigil has no monitor link.
-->
<UserControl x:Class="Vigil.Controls.Sidebar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:utu="using:Uno.Toolkit.UI">
  <!-- Scrolls when the window is shorter than the sidebar (640 px holds the rail only to Settings); the grid is at least
       the viewport tall, so the footer rows still sit at the bottom when everything fits. -->
  <ScrollViewer x:Name="SidebarScroll" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Hidden">
  <Grid Padding="{StaticResource SidebarInset}" MinWidth="{StaticResource RailWidth}" MinHeight="{Binding ViewportHeight, ElementName=SidebarScroll}" RowSpacing="{StaticResource Space150}" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto,Auto">
    <!-- Holds the full width: 256 = 224 content + 2 x 16 padding. -->
    <Grid Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}" Grid.RowSpan="8"><Border Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Width="{StaticResource SidebarContentWidth}" /></Grid>

    <!-- Brand row: logo + wordmark, collapse button (ghost). -->
    <Grid Height="40" Padding="{StaticResource BrandRowInset}" ColumnDefinitions="Auto,*,Auto">
      <ContentControl Style="{StaticResource FilledIcon}" Width="26" Height="26" Content="{StaticResource IconLogo}" />
      <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
        <TextBlock x:Uid="Sidebar_1" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Text="clover" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource PrimaryBrush}" Margin="{StaticResource Space125LeftThickness}" VerticalAlignment="Center" />
      </Grid>
      <Grid Grid.Column="2" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
        <Button x:Uid="Sidebar_2" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Style="{StaticResource ButtonIconGhost}" Command="{Binding ToggleSidebar}" AutomationProperties.Name="Collapse sidebar">
          <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_3" Content="Collapse sidebar" /></ToolTipService.ToolTip>
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconPanelLeft}" />
        </Button>
      </Grid>
    </Grid>

    <!-- The collapsed rail's expand button (from Widest). -->
    <Grid Grid.Row="1" Margin="{StaticResource Space100TopThickness}">
      <Grid Visibility="{utu:Responsive Narrowest=Collapsed, Widest=Visible}">
        <Button x:Uid="Sidebar_9" Visibility="{Binding IsCollapsed, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Style="{StaticResource ButtonIconGhost}" HorizontalAlignment="Center" Command="{Binding ToggleSidebar}" AutomationProperties.Name="Expand sidebar">
          <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_10" Content="Expand sidebar" /></ToolTipService.ToolTip>
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconPanelLeft}" />
        </Button>
      </Grid>
    </Grid>

    <!-- New patient (secondary L, Medium label, xs shadow): opens the New case sheet. -->
    <utu:ShadowContainer Grid.Row="2" Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius300CornerRadius}" Shadows="{StaticResource ShadowXs}">
      <Button x:Uid="Sidebar_11" Style="{StaticResource ButtonSecondaryL}" Padding="0" FontWeight="Medium" HorizontalAlignment="Stretch" Command="{Binding NewPatient}" AutomationProperties.Name="New patient">
        <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_12" Content="New patient" /></ToolTipService.ToolTip>
        <StackPanel Orientation="Horizontal">
          <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconPlus}" Foreground="{ThemeResource OnSurfaceBrush}" />
          <Grid Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <TextBlock x:Uid="Sidebar_13" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Text="New patient" Style="{StaticResource BodyMedium}" FontWeight="Medium" Margin="{StaticResource Space100LeftThickness}" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Button>
    </utu:ShadowContainer>

    <!-- Main nav: margin-top 12, gap 2. -->
    <StackPanel Grid.Row="3" Margin="{StaticResource Space150TopThickness}" Spacing="{StaticResource Space025}">
      <Button x:Uid="Sidebar_14" Style="{StaticResource NavItemButtonStyle}" utu:VisualStateManagerExtensions.States="{Binding TodayState}"
              Command="{Binding Go}" CommandParameter="Today" AutomationProperties.Name="Today">
        <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_15" Content="Today" /></ToolTipService.ToolTip>
        <Grid ColumnDefinitions="18,*">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconLayoutGrid}" Foreground="{utu:AncestorBinding AncestorType=ContentPresenter, Path=Foreground}" />
          <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <Grid Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Margin="{StaticResource Space150HorizontalThickness}" ColumnDefinitions="*,Auto">
              <TextBlock x:Uid="Sidebar_16" Text="Today" Style="{StaticResource BodyMedium}" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </Button>
      <Button x:Uid="Sidebar_17" Style="{StaticResource NavItemButtonStyle}" utu:VisualStateManagerExtensions.States="{Binding PatientsState}"
              Command="{Binding Go}" CommandParameter="Patients" AutomationProperties.Name="Patients">
        <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_18" Content="Patients" /></ToolTipService.ToolTip>
        <Grid ColumnDefinitions="18,*">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconPawPrint}" Foreground="{utu:AncestorBinding AncestorType=ContentPresenter, Path=Foreground}" />
          <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <Grid Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Margin="{StaticResource Space150HorizontalThickness}" ColumnDefinitions="*,Auto">
              <TextBlock x:Uid="Sidebar_19" Text="Patients" Style="{StaticResource BodyMedium}" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding PatientsCount}" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </Button>
      <Button x:Uid="Sidebar_20" Style="{StaticResource NavItemButtonStyle}" utu:VisualStateManagerExtensions.States="{Binding AgendaState}"
              Command="{Binding Go}" CommandParameter="Agenda" AutomationProperties.Name="Agenda">
        <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_21" Content="Agenda" /></ToolTipService.ToolTip>
        <Grid ColumnDefinitions="18,*">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconCalendar}" Foreground="{utu:AncestorBinding AncestorType=ContentPresenter, Path=Foreground}" />
          <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <Grid Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Margin="{StaticResource Space150HorizontalThickness}" ColumnDefinitions="*,Auto">
              <TextBlock x:Uid="Sidebar_22" Text="Agenda" Style="{StaticResource BodyMedium}" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </Button>
      <Button x:Uid="Sidebar_23" Style="{StaticResource NavItemButtonStyle}" utu:VisualStateManagerExtensions.States="{Binding AnesthesiaState}"
              Command="{Binding OpenAnesthesia}" IsEnabled="{Binding HasLive}" AutomationProperties.Name="Anesthesia">
        <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_24" Content="Anesthesia" /></ToolTipService.ToolTip>
        <Grid ColumnDefinitions="18,*">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconActivity}" Foreground="{utu:AncestorBinding AncestorType=ContentPresenter, Path=Foreground}" />
          <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <Grid Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Margin="{StaticResource Space150HorizontalThickness}" ColumnDefinitions="*,Auto">
              <TextBlock x:Uid="Sidebar_25" Text="Anesthesia" Style="{StaticResource BodyMedium}" FontWeight="Medium" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Text="{Binding AnesthesiaCount}" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </Button>
    </StackPanel>

    <!-- Footer nav, bottom-aligned. -->
    <StackPanel Grid.Row="5" Spacing="{StaticResource Space025}">
      <Button x:Uid="Sidebar_35" Style="{StaticResource NavItemButtonStyle}" utu:VisualStateManagerExtensions.States="{Binding SettingsState}"
              Command="{Binding Go}" CommandParameter="Settings" AutomationProperties.Name="Settings">
        <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_36" Content="Settings" /></ToolTipService.ToolTip>
        <Grid ColumnDefinitions="18,*">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconSettings}" Foreground="{utu:AncestorBinding AncestorType=ContentPresenter, Path=Foreground}" />
          <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <Grid Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Margin="{StaticResource Space150HorizontalThickness}" ColumnDefinitions="*,Auto">
              <TextBlock x:Uid="Sidebar_37" Text="Settings" Style="{StaticResource BodyMedium}" FontWeight="Medium" VerticalAlignment="Center" />
            </Grid>
          </Grid>
        </Grid>
      </Button>
    </StackPanel>

    <!-- Monitor status (D7): Vigil has no monitor link (SPEC.md), and the pill says so instead of the design's
         "Monitoring on": a hollow grey dot (all the icon rail shows) and muted text. A status, not a control. -->
    <Grid x:Uid="Sidebar_41" Grid.Row="6" Background="Transparent" AutomationProperties.Name="No monitor connected">
      <ToolTipService.ToolTip><ToolTip x:Uid="Sidebar_42" Content="No monitor connected" /></ToolTipService.ToolTip>
      <Border Style="{StaticResource PillSurface}">
        <StackPanel Orientation="Horizontal" Height="20">
          <Grid Width="14" Height="14" VerticalAlignment="Center" Margin="-3,0,0,0">
            <Ellipse Width="8" Height="8" Stroke="{ThemeResource OnSurfaceVariantBrush}" StrokeThickness="1.5" />
          </Grid>
          <Grid Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
            <TextBlock x:Uid="Sidebar_43" Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Text="No monitor connected" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Margin="7,0,0,0" VerticalAlignment="Center" />
          </Grid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- User row: avatar initials, "Dr. <surname>" from Settings (Settings is where they change), role. -->
    <!-- No ColumnSpacing: it would still apply around the collapsed column and widen the rail; the full-only part carries
         the 10 px gap. The -2 margin keeps 8 + 34 px inside the 40 px rail. -->
    <Grid Grid.Row="7" Padding="{StaticResource UserRowInset}" Margin="0,0,-2,0" ColumnDefinitions="Auto,*">
      <Border Style="{StaticResource AvatarCircle}">
        <TextBlock Text="{Binding ClinicianInitials}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" LineHeight="16" Foreground="{ThemeResource OnPrimaryContainerBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Grid Grid.Column="1" Visibility="{utu:Responsive Narrowest=Visible, Normal=Collapsed, Widest=Visible}">
        <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Margin="{StaticResource Space125LeftThickness}" VerticalAlignment="Center">
          <TextBlock Text="{Binding ClinicianName}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Uid="Sidebar_44" Text="Veterinarian" Style="{StaticResource CaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
  </ScrollViewer>
</UserControl>
