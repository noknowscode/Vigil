<Page x:Class="Vigil.Presentation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!-- A utility screen: a plain list, no anchor. -->
  <Grid utu:SafeArea.Insets="VisibleBounds">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar x:Uid="SettingsTitle" Content="Settings" Background="{ThemeResource BackgroundBrush}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="SettingsBack" Label="Board" AutomationProperties.Name="Back to the board">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Back" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="{utu:Responsive Narrow='16,8,16,32', Wide='32,16,32,40'}" Spacing="24" MaxWidth="720" HorizontalAlignment="Stretch">

        <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
          <StackPanel Padding="20" Spacing="16">
            <TextBlock x:Uid="SettingsAppearance" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Appearance" />
            <muxc:RadioButtons x:Uid="SettingsTheme" Header="Theme" MaxColumns="{utu:Responsive Narrowest=1, Normal=3}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}">
              <RadioButton x:Uid="SettingsThemeSystem" Content="System" />
              <RadioButton x:Uid="SettingsThemeLight" Content="Paper (light)" />
              <RadioButton x:Uid="SettingsThemeDark" Content="Theatre (dark)" />
            </muxc:RadioButtons>
            <!-- Material's ToggleSwitch drops its Header: the label is its own text, the switch carries the name. -->
            <Grid ColumnSpacing="16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Uid="SettingsReduceMotionLabel" Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Reduce motion" />
                <TextBlock x:Uid="SettingsReduceMotionHelp" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                           Text="New strip columns appear without fading in." />
              </StackPanel>
              <ToggleSwitch x:Uid="SettingsReduceMotion" Grid.Column="1" OnContent="" OffContent=""
                            AutomationProperties.Name="Reduce motion"
                            IsOn="{Binding ReduceMotion, Mode=TwoWay}" />
            </Grid>
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
          <StackPanel Padding="20" Spacing="16">
            <TextBlock x:Uid="SettingsLanguageTitle" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Language" />
            <muxc:RadioButtons x:Uid="SettingsLanguage" Header="Language (applies after restart)" MaxColumns="2" SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
              <RadioButton x:Uid="Settings_1" Content="English" />
              <RadioButton x:Uid="Settings_2" Content="Français" />
            </muxc:RadioButtons>
            <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding LanguageNotice}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
          <StackPanel Padding="20" Spacing="16">
            <TextBlock x:Uid="SettingsMonitoring" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Monitoring" />
            <muxc:RadioButtons x:Uid="SettingsInterval" Header="Reading interval" MaxColumns="3" SelectedIndex="{Binding IntervalIndex, Mode=TwoWay}">
              <RadioButton x:Uid="SettingsInterval3" Content="3 min" />
              <RadioButton x:Uid="SettingsInterval5" Content="5 min" />
              <RadioButton x:Uid="SettingsInterval10" Content="10 min" />
            </muxc:RadioButtons>
            <TextBlock x:Uid="SettingsIntervalHelp" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                       Text="The next reading falls due one interval after the last one. The due slot turns yellow 30 seconds before, red when late." />
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
          <StackPanel Padding="20" Spacing="12">
            <TextBlock x:Uid="SettingsData" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Records on this tablet" />
            <TextBlock x:Uid="SettingsDataHelp" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                       Text="Records are stored on this device only. They are not synced to other tablets or to the practice management system: export each signed record from its Recovery tab." />
            <StackPanel Orientation="Horizontal" Spacing="12">
              <Button x:Uid="SettingsLoadSample" Style="{StaticResource OutlinedButtonStyle}" Content="Load sample day" Command="{Binding LoadSampleDay}" />
              <Button x:Uid="SettingsClearAll" Style="{StaticResource OutlinedButtonStyle}" Content="Clear all records" Command="{Binding ClearAll}" />
            </StackPanel>
            <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding Notice}" AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </utu:CardContentControl>

        <TextBlock x:Uid="SettingsAbout" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                   Text="Clover is an Uno Platform reference app. Drug concentrations, dose ranges and alarm thresholds are sample reference data, not for clinical use." />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
