<Page x:Class="Vigil.Presentation.NewCasePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds" MaxWidth="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar x:Uid="NewCase_1" Content="New case" Background="{ThemeResource SurfaceBrush}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="NewCase_2" Label="Cancel"
                      AutomationProperties.Name="Cancel new case"
                      Command="{Binding Cancel}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Cancel" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="24,8,24,24" Spacing="16">
        <TextBlock x:Uid="NewCase_3" Style="{StaticResource LabelLarge}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Text="PATIENT" />
        <TextBox x:Uid="NewCase_4" Header="Name"
                 Text="{Binding Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Patient name" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ComboBox x:Uid="NewCase_5" x:Name="SpeciesBox"
                    Header="Species"
                    HorizontalAlignment="Stretch"
                    SelectedIndex="{Binding Draft.SpeciesIndex, Mode=TwoWay}"
                    AutomationProperties.Name="Species">
            <ComboBoxItem x:Uid="NewCase_6" Content="Canine" />
            <ComboBoxItem x:Uid="NewCase_7" Content="Feline" />
            <ComboBoxItem x:Uid="NewCase_8" Content="Other" />
          </ComboBox>
          <TextBox x:Uid="NewCase_9" Grid.Column="1"
                   Header="Breed"
                   Text="{Binding Draft.Breed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Breed" />
        </Grid>
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Uid="NewCase_10" Header="Weight (kg)"
                   InputScope="Number"
                   Text="{Binding Draft.WeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Weight in kilograms" />
          <TextBox x:Uid="NewCase_11" Grid.Column="1"
                   Header="Age (years)"
                   InputScope="Number"
                   Text="{Binding Draft.AgeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Age in years" />
        </Grid>
        <TextBox x:Uid="NewCase_12" Header="Owner"
                 Text="{Binding Draft.Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Owner" />

        <TextBlock x:Uid="NewCase_13" Style="{StaticResource LabelLarge}"
                   Foreground="{ThemeResource OnSurfaceVariantBrush}"
                   Margin="0,8,0,0"
                   Text="PROCEDURE" />
        <TextBox x:Uid="NewCase_14" Header="Procedure"
                 Text="{Binding Draft.Procedure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Procedure" />
        <Grid ColumnSpacing="12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBox x:Uid="NewCase_15" Header="Veterinarian"
                   Text="{Binding Draft.Veterinarian, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Veterinarian" />
          <TextBox x:Uid="NewCase_16" Grid.Column="1"
                   Header="Technician"
                   Text="{Binding Draft.Technician, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Technician" />
        </Grid>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Padding="24,12,24,24" Spacing="12">
      <TextBlock x:Uid="NewCase_17" Style="{StaticResource BodySmall}"
                 Foreground="{ThemeResource ErrorBrush}"
                 TextWrapping="WrapWholeWords"
                 Text="{Binding ErrorText}"
                 AutomationProperties.LiveSetting="Assertive"
                 AutomationProperties.Name="Form errors" />
      <TextBlock Style="{StaticResource BodySmall}"
                 Foreground="{ThemeResource ErrorBrush}"
                 TextWrapping="WrapWholeWords"
                 Text="{Binding SaveError}" />
      <Button x:Uid="NewCase_18" Style="{StaticResource CloverPrimary}"
              HorizontalAlignment="Stretch"
              Content="Create case"
              AutomationProperties.Name="Create case"
              Command="{Binding Create}" />
    </StackPanel>
  </Grid>
</Page>
