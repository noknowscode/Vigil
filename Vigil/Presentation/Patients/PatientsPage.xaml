<Page x:Class="Vigil.Presentation.PatientsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:controls="using:Vigil.Controls"
      xmlns:local="using:Vigil.Presentation"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Transparent">
  <!-- Patients (sidebar destination): every case on this device as Today's patient cards (PatientCardView). -->
  <ScrollViewer HorizontalScrollMode="Disabled">
    <StackPanel Padding="{utu:Responsive Narrowest='20,28,20,40', Narrow='40,36,40,40'}" Spacing="24">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="16">
        <StackPanel Spacing="8" Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}">
          <TextBlock x:Uid="Patients_1" Text="Patients" Style="{StaticResource TypeDisplayTitle}" />
          <TextBlock Text="{Binding Summary}" Style="{StaticResource TypeBodyL}" Foreground="{ThemeResource InkMutedBrush}" />
        </StackPanel>
        <controls:TopBarCluster Grid.Column="{utu:Responsive Narrowest=0, Wide=1}" VerticalAlignment="Top" HorizontalAlignment="Left" />
      </Grid>
      <mvux:FeedView x:Name="PatientsFeed" Source="{Binding All}" VerticalContentAlignment="Top" RefreshingState="None" IsTabStop="False">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <muxc:ItemsRepeater x:Uid="Patients_2" ItemsSource="{Binding Data}" AutomationProperties.Name="All patients">
              <muxc:ItemsRepeater.Layout><controls:CardColumnsLayout MinColumnWidth="320" MaxColumns="3" ColumnSpacing="24" RowSpacing="24" /></muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate><local:PatientCardView /></DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.ProgressTemplate>
          <DataTemplate><ProgressRing x:Uid="Patients_3" Width="24" Height="24" IsActive="True" HorizontalAlignment="Left" AutomationProperties.Name="Loading patients" /></DataTemplate>
        </mvux:FeedView.ProgressTemplate>
        <mvux:FeedView.NoneTemplate>
          <DataTemplate><TextBlock x:Uid="Patients_4" Text="No patients on this device yet. Use New patient in the sidebar to start a record." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" /></DataTemplate>
        </mvux:FeedView.NoneTemplate>
        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <StackPanel Spacing="12" HorizontalAlignment="Left">
              <TextBlock x:Uid="Patients_5" Text="Couldn't read saved records." Style="{StaticResource TypeH3Card}" />
              <!-- ErrorTemplate DataContext is the Exception: reach the page model by ElementName. -->
              <Button x:Uid="Patients_6" Content="Retry" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" AutomationProperties.Name="Retry reading records"
                      Command="{Binding DataContext.Retry, ElementName=PatientsFeed}" />
            </StackPanel>
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>
    </StackPanel>
  </ScrollViewer>
</Page>
