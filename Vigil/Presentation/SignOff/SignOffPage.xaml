<!--
  Sign off (route !SignOff from the record). v2 sheet: serif patient line, the record summary in a panel card with the
  two mono stats as its anchor, then the signer card. The action bar stays pinned under the scroll area.
-->
<Page x:Class="Vigil.Presentation.SignOffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds" MaxWidth="{StaticResource FormMaxWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="" Background="Transparent">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="SignOff_1" Label="Cancel" AutomationProperties.Name="Close sign-off" Command="{Binding Cancel}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Cancel" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
      <StackPanel Padding="{StaticResource SheetInsetFlush}" Spacing="{StaticResource Space200}">
        <mvux:FeedView x:Name="SummaryFeed" Source="{Binding Summary}" IsTabStop="False" RefreshingState="None" MinHeight="220" HorizontalContentAlignment="Stretch">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <StackPanel Spacing="{StaticResource Space200}">
                <StackPanel Spacing="{StaticResource Space075}" Margin="{StaticResource Space100BottomThickness}">
                  <TextBlock x:Uid="SignOff_2" Text="Sign off" Style="{StaticResource HeadlineLarge}" TextWrapping="WrapWholeWords" />
                  <TextBlock Style="{StaticResource BodyLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.Patient}" />
                </StackPanel>
                <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
                  <StackPanel Spacing="{StaticResource Space150}">
                    <TextBlock Style="{StaticResource BodyLarge}" FontWeight="SemiBold" TextWrapping="WrapWholeWords" Text="{Binding Data.Procedure}" />
                    <!-- Anchor: the signed summary as two mono stats. -->
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space400}">
                      <StackPanel>
                        <TextBlock x:Uid="SignOff_3" Text="Anesthesia" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <TextBlock x:Uid="SignOff_4" Style="{StaticResource NumeralHeadlineSmall}" Text="{Binding Data.Duration}" AutomationProperties.Name="Anesthesia duration" />
                      </StackPanel>
                      <StackPanel>
                        <TextBlock x:Uid="SignOff_5" Text="Readings" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <TextBlock x:Uid="SignOff_6" Style="{StaticResource NumeralHeadlineSmall}" Text="{Binding Data.Readings}" AutomationProperties.Name="Readings recorded" />
                      </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="{StaticResource Space050}" Padding="{StaticResource Space150TopThickness}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                      <TextBlock Style="{StaticResource BodyMedium}" TextWrapping="WrapWholeWords" Text="{Binding Data.Counts}" />
                      <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.Recovery}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodyMedium}" FontWeight="SemiBold" Foreground="{ThemeResource ErrorBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.Blocker}" />
                  </StackPanel>
                </utu:CardContentControl>
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>
          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <StackPanel Spacing="{StaticResource Space150}" AutomationProperties.AccessibilityView="Raw">
                <Rectangle Style="{StaticResource Skeleton}" Width="200" Height="40" HorizontalAlignment="Left" />
                <Rectangle Style="{StaticResource Skeleton}" Width="320" Height="20" HorizontalAlignment="Left" />
                <Rectangle Style="{StaticResource Skeleton}" Height="180" Margin="{StaticResource Space150TopThickness}" HorizontalAlignment="Stretch" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>
          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel Spacing="{StaticResource Space150}">
                <TextBlock x:Uid="SignOff_7" Style="{StaticResource BodyLarge}" FontWeight="SemiBold" Text="Couldn't read this record." />
                <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding Message}" />
                <Button x:Uid="SignOff_8" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Content="Retry"
                        Command="{Binding DataContext.Retry, ElementName=SummaryFeed}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
          <StackPanel Spacing="{StaticResource Space150}">
            <TextBlock x:Uid="SignOff_9" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="SIGNED BY" />
            <TextBox x:Uid="SignOff_10" Header="Veterinarian"
                     Text="{Binding Veterinarian, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Signing veterinarian" />
            <CheckBox x:Uid="SignOff_11" Content="I have reviewed this anesthesia record and it is complete."
                      IsChecked="{Binding Confirmed, Mode=TwoWay}" />
            <TextBlock x:Uid="SignOff_12" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                       Text="Signing makes the record read-only on this device. This is a typed name on a shared device, not an electronic signature." />
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Padding="{StaticResource SheetInset}" Spacing="{StaticResource Space100}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
      <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="WrapWholeWords" Text="{Binding Error}" />
      <Button x:Uid="SignOff_13" Style="{StaticResource ButtonPrimaryXL}" Content="Sign record"
              Command="{Binding Sign}" AutomationProperties.Name="Sign the record" />
    </StackPanel>
  </Grid>
</Page>
