<Page x:Class="Vigil.Presentation.SignOffPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource SurfaceBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds" MaxWidth="640">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar x:Uid="SignOff_1" Content="Sign off" Background="{ThemeResource SurfaceBrush}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="SignOff_2" Label="Cancel" AutomationProperties.Name="Close sign-off" Command="{Binding Cancel}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Cancel" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1">
      <StackPanel Padding="24,8,24,24" Spacing="20">
        <mvux:FeedView x:Name="SummaryFeed" Source="{Binding Summary}" IsTabStop="False" RefreshingState="None" MinHeight="220">
          <mvux:FeedView.ValueTemplate>
            <DataTemplate>
              <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.Patient}" />
                <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Data.Procedure}" />
                <!-- Anchor: the signed summary at display scale. -->
                <StackPanel Orientation="Horizontal" Spacing="24">
                  <StackPanel>
                    <TextBlock x:Uid="SignOff_3" Style="{StaticResource DisplayLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding Data.Duration}" AutomationProperties.Name="Anesthesia duration" />
                    <TextBlock x:Uid="SignOff_4" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="ANESTHESIA" />
                  </StackPanel>
                  <StackPanel>
                    <TextBlock x:Uid="SignOff_5" Style="{StaticResource DisplayLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding Data.Readings}" AutomationProperties.Name="Readings recorded" />
                    <TextBlock x:Uid="SignOff_6" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="READINGS" />
                  </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.Counts}" />
                <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding Data.Recovery}" />
                <TextBlock Style="{StaticResource TitleSmall}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.Blocker}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ValueTemplate>
          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <StackPanel Spacing="12">
                <Rectangle Width="320" Height="24" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                <Rectangle Width="220" Height="18" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                <Rectangle Width="260" Height="68" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>
          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <StackPanel Spacing="12">
                <TextBlock x:Uid="SignOff_7" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Couldn't read this record." />
                <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding Message}" />
                <Button x:Uid="SignOff_8" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Left" Content="Retry"
                        Command="{Binding DataContext.Retry, ElementName=SummaryFeed}" />
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>

        <TextBox x:Uid="SignOff_9" Header="Veterinarian"
                 Text="{Binding Veterinarian, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="Signing veterinarian" />
        <CheckBox x:Uid="SignOff_10" Content="I have reviewed this anesthesia record and it is complete."
                  IsChecked="{Binding Confirmed, Mode=TwoWay}" />
        <TextBlock x:Uid="SignOff_11" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                   Text="Signing makes the record read-only on this device. This is a typed name on a shared tablet, not an electronic signature." />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Padding="24,12,24,24" Spacing="8">
      <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="WrapWholeWords" Text="{Binding Error}" />
      <Button x:Uid="SignOff_12" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Stretch" Content="Sign record"
              Command="{Binding Sign}" AutomationProperties.Name="Sign the record" />
    </StackPanel>
  </Grid>
</Page>
