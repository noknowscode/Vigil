<!--
  Pet parent preview (route Main/ParentPreview, from the record). What a pet parent would see on their phone, drawn
  in the v2 language at phone width (MaxWidth 460): wordmark header, the "not connected" notice, the patient card
  (photo panel, serif name), the team's milestones, what happens next, and the visit details.
-->
<Page x:Class="Vigil.Presentation.ParentPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:controls="using:Vigil.Controls"
      Background="Transparent">
  <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,*">
    <!-- Back bar: the wordmark as the title; the Android back gesture comes with the NavigationBar. -->
    <utu:NavigationBar Background="Transparent" Padding="{utu:Responsive Narrowest='8,8,20,0', Narrow='28,16,40,0'}">
      <utu:NavigationBar.Content>
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <controls:CareMark Width="20" Height="23" />
          <TextBlock x:Uid="ParentPreview_1" Text="clover" Style="{StaticResource TypeBrand}" />
          <!-- xaml-lint: allow card - 20 px audience badge, display-only -->
          <Border Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center" Margin="8,0,0,0"><TextBlock x:Uid="ParentPreview_2" Text="For you" Style="{StaticResource TypeCaptionStrong}" /></Border>
        </StackPanel>
      </utu:NavigationBar.Content>
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="ParentPreview_3" Label="Back" AutomationProperties.Name="Back to patient record" uen:Navigation.Request="-">
          <AppBarButton.Icon><SymbolIcon Symbol="Back" /></AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>
    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
      <StackPanel MaxWidth="460" Padding="16,16,16,40" Spacing="16">
        <!-- xaml-lint: allow card - one-line notice pill, display-only -->
        <Border Style="{StaticResource PillSurface}" HorizontalAlignment="Center">
          <TextBlock x:Uid="ParentPreview_4" Text="Clinic preview · remote sharing is not connected" Style="{StaticResource TypeCaption}" Foreground="{ThemeResource InkMutedBrush}" TextAlignment="Center" TextWrapping="WrapWholeWords" />
        </Border>
        <mvux:FeedView x:Name="ParentFeed" Source="{Binding Patient}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
          <mvux:FeedView.ValueTemplate><DataTemplate>
            <StackPanel Spacing="16">
              <utu:CardContentControl Style="{StaticResource PanelCardStyle}" Padding="6" CornerRadius="24">
                <StackPanel>
                  <Grid Height="248" CornerRadius="19" Background="{ThemeResource MediaPlaceholderBrush}">
                    <controls:PetBackdrop Photo="{Binding Data.Photo}" />
                    <TextBlock Text="{Binding Data.Initial}" Style="{StaticResource TypeDisplayTitleL}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Data.HasNoPhoto}" />
                    <!-- xaml-lint: allow card - status pill over the photo, display-only -->
                    <Border Style="{StaticResource PillSurface}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Data.Status}" Style="{StaticResource TypeCaptionStrong}" />
                      </StackPanel>
                    </Border>
                  </Grid>
                  <StackPanel Padding="16,18,16,14" Spacing="6">
                    <TextBlock Text="{Binding Data.Name}" Style="{StaticResource TypeDisplayTitle}" />
                    <TextBlock Text="{Binding Data.Breed}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" />
                    <TextBlock Text="{Binding Data.Updated}" Style="{StaticResource TypeMonoMeta}" />
                  </StackPanel>
                </StackPanel>
              </utu:CardContentControl>

              <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Uid="ParentPreview_5" Text="A little closer, even apart." Style="{StaticResource TypeH3Card}" />
                    <controls:CareMark Grid.Column="1" Width="16" Height="18" VerticalAlignment="Center" />
                  </Grid>
                  <TextBlock Text="{Binding Data.Description}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                  <ItemsControl ItemsSource="{Binding Data.Milestones}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid ColumnDefinitions="28,*,Auto" Padding="0,12" ColumnSpacing="12" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                        <!-- xaml-lint: allow card - 28 px milestone marker disc -->
                        <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource PhaseAnesthesiaSoftBrush}" VerticalAlignment="Top">
                          <TextBlock Text="{Binding Marker}" Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="2">
                          <TextBlock Text="{Binding Label}" Style="{StaticResource TypeBodyStrong}" TextWrapping="WrapWholeWords" />
                          <TextBlock Text="{Binding Detail}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Time}" Style="{StaticResource TypeMonoMeta}" />
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock x:Uid="ParentPreview_6" Text="Milestones are entered by the team. This is not a live monitor." Style="{StaticResource TypeCaption}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
              </utu:CardContentControl>

              <utu:CardContentControl Style="{StaticResource PanelCardStyle}" Background="{ThemeResource PhaseAnesthesiaSoftBrush}" BorderBrush="{ThemeResource PhaseAnesthesiaSoftBorderBrush}">
                <StackPanel Spacing="8">
                  <TextBlock x:Uid="ParentPreview_7" Text="WHAT HAPPENS NEXT" Style="{StaticResource TypeEyebrow}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" />
                  <TextBlock x:Uid="ParentPreview_8" Text="One step at a time." Style="{StaticResource TypeTitleM}" />
                  <TextBlock Text="{Binding Data.Next}" Style="{StaticResource TypeBody}" TextWrapping="WrapWholeWords" />
                </StackPanel>
              </utu:CardContentControl>

              <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
                <StackPanel Spacing="8">
                  <TextBlock x:Uid="ParentPreview_9" Text="Your visit and care team" Style="{StaticResource TypeH3Card}" />
                  <TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource TypeBodyStrong}" TextWrapping="WrapWholeWords" />
                  <TextBlock Text="{Binding Data.Team}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                  <TextBlock x:Uid="ParentPreview_10" Text="For a personal update, contact your clinic using the details on your appointment confirmation." Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
              </utu:CardContentControl>
              <TextBlock x:Uid="ParentPreview_11" Text="Care, continued. For the ones you love." Style="{StaticResource TypeCaption}" Foreground="{ThemeResource InkMutedBrush}" TextAlignment="Center" Margin="0,8" />
            </StackPanel>
          </DataTemplate></mvux:FeedView.ValueTemplate>
          <mvux:FeedView.ProgressTemplate><DataTemplate>
            <StackPanel Spacing="16" AutomationProperties.AccessibilityView="Raw">
              <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="360" RadiusX="24" RadiusY="24" />
              <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="200" RadiusX="18" RadiusY="18" />
            </StackPanel>
          </DataTemplate></mvux:FeedView.ProgressTemplate>
          <mvux:FeedView.NoneTemplate><DataTemplate><TextBlock x:Uid="ParentPreview_12" Text="This visit is no longer available on this device." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" /></DataTemplate></mvux:FeedView.NoneTemplate>
          <mvux:FeedView.ErrorTemplate><DataTemplate>
            <StackPanel Spacing="12">
              <TextBlock x:Uid="ParentPreview_13" Text="Care updates could not be loaded." Style="{StaticResource TypeH3Card}" />
              <Button x:Uid="ParentPreview_14" Content="Try again" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=ParentFeed}" />
            </StackPanel>
          </DataTemplate></mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
