<Page x:Class="Vigil.Presentation.DosePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:domain="using:Vigil.Domain"
      Background="{ThemeResource SurfaceBrush}">

  <Grid utu:SafeArea.Insets="VisibleBounds" MaxWidth="960">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="{Binding Patient}" Background="{ThemeResource SurfaceBrush}">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="Dose_1" Label="Cancel" AutomationProperties.Name="Close the dose sheet" Command="{Binding Cancel}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Cancel" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <Grid Grid.Row="1" Padding="{utu:Responsive Narrow='16,8,16,16', Wide='24,8,24,24'}" ColumnSpacing="24" RowSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Drug list -->
      <Grid Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Dose_2" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="DRUG · sample formulary, not for clinical use" />
        <ListView x:Uid="Dose_3" Grid.Row="1"
                  ItemsSource="{Binding Drugs}"
                  SelectionMode="Single"
                  AutomationProperties.Name="Drugs">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="domain:Drug">
              <Grid Padding="4,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{x:Bind Name}" />
                  <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind DrugClass}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center">
                  <Run Text="{x:Bind MgPerMl}" /><Run x:Uid="Dose_4" Text=" mg/mL" />
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <!-- Calculation: the computed volume is the sheet's anchor. -->
      <ScrollViewer Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"
                    Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}">
        <StackPanel Spacing="16">
          <TextBox x:Uid="Dose_5" Header="Dose (mg/kg)"
                   InputScope="Number"
                   Text="{Binding MgPerKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Dose in milligrams per kilogram" />

          <mvux:FeedView Source="{Binding Calc}" IsTabStop="False" RefreshingState="None">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <StackPanel Spacing="6">
                  <TextBlock x:Uid="Dose_6" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="DRAW UP" />
                  <TextBlock x:Uid="Dose_7" Style="{StaticResource DisplayLarge}"
                             Foreground="{ThemeResource OnSurfaceBrush}"
                             Text="{Binding Data.VolumeText}"
                             AutomationProperties.Name="Volume to draw up" />
                  <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding Data.Formula}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}">
                    <Run x:Uid="Dose_8" Text="Reference range" />
                    <Run Text="{Binding Data.ReferenceText}" />
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding Data.IsOutOfRange}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource ErrorBrush}" />
                    <TextBlock x:Uid="Dose_9" Style="{StaticResource TitleSmall}" Foreground="{ThemeResource ErrorBrush}" Text="Outside the reference range: you will be asked to confirm." TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <StackPanel Spacing="6">
                  <TextBlock x:Uid="Dose_10" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="DRAW UP" />
                  <TextBlock x:Uid="Dose_11" Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="Pick a drug" />
                  <TextBlock x:Uid="Dose_12" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                             Text="The volume appears here with its formula once a drug and a dose in mg/kg are set." />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
          </mvux:FeedView>

          <muxc:RadioButtons x:Uid="Dose_13" Header="Route" MaxColumns="4" SelectedIndex="{Binding RouteIndex, Mode=TwoWay}">
            <RadioButton x:Uid="Dose_14" Content="IV" />
            <RadioButton x:Uid="Dose_15" Content="IM" />
            <RadioButton x:Uid="Dose_16" Content="SC" />
            <RadioButton x:Uid="Dose_17" Content="PO" />
          </muxc:RadioButtons>
          <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="WrapWholeWords" Text="{Binding Error}" />
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Grid.ColumnSpan="2">
        <Button x:Uid="Dose_18" Style="{StaticResource CloverPrimary}"
                HorizontalAlignment="Stretch"
                Content="Give dose"
                Visibility="{Binding NotConfirming}"
                Command="{Binding Give}"
                AutomationProperties.Name="Give dose" />
        <!-- Out-of-range confirmation, inline: the safe choice is the filled one. -->
        <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding Confirming}"
                                IsTabStop="False">
          <StackPanel Padding="16" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource ErrorBrush}" />
              <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding ConfirmTitle}" />
            </StackPanel>
            <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding ConfirmText}"
                       AutomationProperties.LiveSetting="Assertive" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Uid="Dose_19" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Stretch" Content="Change dose" Command="{Binding ChangeDose}" />
              <Button x:Uid="Dose_20" Grid.Column="1" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Stretch" Content="Give anyway"
                      Command="{Binding GiveAnyway}" AutomationProperties.Name="Give the out-of-range dose anyway" />
            </Grid>
          </StackPanel>
        </utu:CardContentControl>
      </Grid>
    </Grid>
  </Grid>
</Page>
