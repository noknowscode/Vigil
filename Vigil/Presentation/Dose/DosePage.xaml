<!--
  Administer dose (route Main/Redose, from a Due next "Prepare" task). v2 utility layout: serif title over the patient
  line, then the dose entry (DoseEntryView, shared with the record's Dose drawer) with its action bar pinned below.
-->
<Page x:Class="Vigil.Presentation.DosePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      xmlns:local="using:Vigil.Presentation"
      Background="Transparent">

  <Grid utu:SafeArea.Insets="VisibleBounds" MaxWidth="{StaticResource SheetMaxWidth}" HorizontalAlignment="Left">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="" Background="Transparent">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="Dose_1" Label="Cancel" AutomationProperties.Name="Close the dose sheet" Command="{Binding Cancel}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Cancel" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <StackPanel Grid.Row="1" Spacing="{StaticResource Space6}" Padding="{utu:Responsive Narrowest={StaticResource SheetSectionInsetNarrow}, Normal={StaticResource SheetSectionInsetNormal}}">
      <TextBlock x:Uid="Dose_2" Text="Administer dose" Style="{StaticResource TypeDisplayTitle}" />
      <TextBlock Text="{Binding Patient}" Style="{StaticResource TypeBodyL}" Foreground="{ThemeResource InkMutedBrush}" TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- The body scrolls when the window is short (a 640 px window left the stacked drug list no height at all). -->
    <local:DoseEntryView Grid.Row="2"
                         BodyPadding="{utu:Responsive Narrowest={StaticResource SheetSectionInsetNarrow}, Normal={StaticResource SheetSectionInsetNormal}}"
                         ActionPadding="{utu:Responsive Narrowest={StaticResource SheetActionInsetNarrow}, Normal={StaticResource SheetActionInsetNormal}}" />
  </Grid>
</Page>
