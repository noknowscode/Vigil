<!--
  The Recovery and handover drawer (route "!Recovery", RecoveryModel): End anesthesia while the case is under anesthesia;
  then the time in recovery, the recovery log (extubation, sternal, timed pain scores, temperature, notes), Sign off,
  Export CSV and Copy summary once signed, and the discharge call to the pet parent.
-->
<Flyout x:Class="Vigil.Presentation.RecoveryDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
        xmlns:mvux="using:Uno.Extensions.Reactive.UI"
        xmlns:utu="using:Uno.Toolkit.UI"
        xmlns:local="using:Vigil.Presentation"
        xmlns:controls="using:Vigil.Controls"
        Placement="Full"
        FlyoutPresenterStyle="{StaticResource RecordDrawerPresenterStyle}"
        controls:FlyoutFocus.Restores="True">
  <Grid RowDefinitions="Auto,Auto,*" utu:SafeArea.Insets="VisibleBounds">
    <controls:DrawerHeader x:Uid="RecoveryDrawer_1" Title="Recovery &amp; handover" CloseCommand="{Binding Close}" />
    <muxc:InfoBar x:Uid="RecoveryDrawer_2" Grid.Row="1" Severity="Error" Title="Not saved" Message="{Binding SaveError}" IsOpen="{Binding HasSaveError}" IsClosable="False" Margin="{StaticResource InsetX20}">
      <muxc:InfoBar.ActionButton><Button x:Uid="RecoveryDrawer_3" Content="Dismiss" Command="{Binding DismissError}" /></muxc:InfoBar.ActionButton>
    </muxc:InfoBar>
    <mvux:FeedView Grid.Row="2" Source="{Binding Case}" RefreshingState="None" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False"
                   ProgressTemplate="{StaticResource DrawerProgressTemplate}" NoneTemplate="{StaticResource DrawerNoneTemplate}" ErrorTemplate="{StaticResource DrawerErrorTemplate}">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ScrollViewer HorizontalScrollMode="Disabled">
            <StackPanel Padding="{StaticResource MetricCardInset}" Spacing="{StaticResource Space24}" MaxWidth="{StaticResource ReadingMaxWidth}" HorizontalAlignment="Stretch">

              <StackPanel Spacing="{StaticResource Space8}" Visibility="{Binding Data.IsAnesthetized, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                <TextBlock x:Uid="RecoveryDrawer_4" Style="{StaticResource TypeH2Section}" Foreground="{ThemeResource InkBrush}" Text="Patient is under anesthesia" />
                <TextBlock x:Uid="RecoveryDrawer_5" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" Text="End anesthesia when the vaporizer is off. The reading clock stops and recovery starts." />
                <Button x:Uid="RecoveryDrawer_6" Style="{StaticResource ButtonPrimaryL}" HorizontalAlignment="Left" MinWidth="{StaticResource ActionMinWidth}" Content="End anesthesia" Command="{Binding Parent.EndAnesthesia}" AutomationProperties.Name="End anesthesia" />
              </StackPanel>

              <StackPanel Spacing="{StaticResource Space4}" Visibility="{Binding Data.IsNotAnesthetized, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                <TextBlock x:Uid="RecoveryDrawer_7" Style="{StaticResource TypeEyebrow}" Text="RECOVERY" />
                <TextBlock x:Uid="RecoveryDrawer_8" Style="{StaticResource TypeMonoVital}" Foreground="{ThemeResource InkBrush}" Text="{Binding Parent.Timers.RecoveryAnchor}" AutomationProperties.Name="Time in recovery" />
                <TextBlock Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Text="{Binding Data.RecoveryAnchorLabel}" />
              </StackPanel>

              <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False" Visibility="{Binding Data.IsNotAnesthetized, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                <StackPanel Padding="{StaticResource Inset20}" Spacing="{StaticResource Space12}">
                  <TextBlock x:Uid="RecoveryDrawer_9" Style="{StaticResource TypeTitleM}" Foreground="{ThemeResource InkBrush}" Text="Recovery log" />
                  <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space12}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="{StaticResource Space6}">
                      <Button x:Uid="RecoveryDrawer_10" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Stretch" Content="Extubated now" Visibility="{Binding Data.IsNotExtubated, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Command="{Binding Parent.Extubate}" AutomationProperties.Name="Record extubation now" />
                      <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.ExtubatedText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space6}">
                      <Button x:Uid="RecoveryDrawer_11" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Stretch" Content="Sternal now" Visibility="{Binding Data.IsNotSternal, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Command="{Binding Parent.Sternal}" AutomationProperties.Name="Record sternal recumbency now" />
                      <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.SternalText}" />
                    </StackPanel>
                  </Grid>
                  <!-- Pain score: each tap records a timed score (the 15-minute task resets even when the score is unchanged). -->
                  <StackPanel Spacing="{StaticResource Space8}">
                    <TextBlock x:Uid="RecoveryDrawer_12" Text="Pain score (0 none to 4 severe)" Style="{StaticResource TypeBodyS}" FontWeight="Medium" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Visibility="{Binding Data.CanEditRecovery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                      <Button x:Uid="RecoveryDrawer_13" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="0" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="0" AutomationProperties.Name="Record pain score 0" />
                      <Button x:Uid="RecoveryDrawer_14" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="1" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="1" AutomationProperties.Name="Record pain score 1" />
                      <Button x:Uid="RecoveryDrawer_15" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="2" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="2" AutomationProperties.Name="Record pain score 2" />
                      <Button x:Uid="RecoveryDrawer_16" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="3" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="3" AutomationProperties.Name="Record pain score 3" />
                      <Button x:Uid="RecoveryDrawer_17" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="4" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="4" AutomationProperties.Name="Record pain score 4" />
                    </StackPanel>
                    <TextBlock Text="{Binding Data.PainText}" Style="{StaticResource TypeBodyS}" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                  <TextBox x:Uid="RecoveryDrawer_18" Header="Temperature (°C)" InputScope="Number" MaxWidth="{StaticResource ShortFieldMaxWidth}" HorizontalAlignment="Left" IsEnabled="{Binding Data.CanEditRecovery}" Text="{Binding Parent.Recovery.TempC, Mode=TwoWay}" />
                  <TextBox x:Uid="RecoveryDrawer_19" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" IsEnabled="{Binding Data.CanEditRecovery}" Text="{Binding Parent.Recovery.Notes, Mode=TwoWay}" />
                </StackPanel>
              </utu:CardContentControl>

              <StackPanel Spacing="{StaticResource Space8}">
                <Button x:Uid="RecoveryDrawer_20" Style="{StaticResource ButtonPrimaryL}" HorizontalAlignment="Left" MinWidth="{StaticResource ActionMinWidth}" Content="Sign off" Visibility="{Binding Data.IsRecovery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Command="{Binding Parent.SignOff}" AutomationProperties.Name="Sign off the record" />
                <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.SignedText}" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" Visibility="{Binding Data.IsSigned, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                  <Button x:Uid="RecoveryDrawer_21" Style="{StaticResource ButtonPrimaryL}" Content="Export CSV" Command="{Binding Parent.Export}" AutomationProperties.Name="Export the record as CSV" />
                  <Button x:Uid="RecoveryDrawer_22" Style="{StaticResource ButtonSecondaryL}" Content="Copy summary" Command="{Binding Parent.CopySummary}" AutomationProperties.Name="Copy a text summary" />
                </StackPanel>
                <TextBlock Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" Text="{Binding Parent.Notice}" AutomationProperties.LiveSetting="Polite" />
              </StackPanel>

              <!-- Discharge call to the pet parent (a "Due next" task): recorded here once made. -->
              <StackPanel Spacing="{StaticResource Space8}" Visibility="{Binding Data.HasDischargeCall, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                <TextBlock x:Uid="RecoveryDrawer_23" Style="{StaticResource TypeTitleM}" Foreground="{ThemeResource InkBrush}" Text="Discharge call" />
                <TextBlock Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Text="{Binding Data.DischargeText}" TextWrapping="WrapWholeWords" />
                <Button x:Uid="RecoveryDrawer_24" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" MinWidth="{StaticResource ActionMinWidth}" Content="Call made" Visibility="{Binding Data.CanCompleteCall, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Command="{Binding Parent.CompleteDischargeCall}" AutomationProperties.Name="Record the discharge call as made" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
    </mvux:FeedView>
  </Grid>
</Flyout>
