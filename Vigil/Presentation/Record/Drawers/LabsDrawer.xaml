<!--
  The Lab results drawer (route "!Labs", LabsModel): which panels are pending, ready and reviewed, Mark reviewed
  (before induction it also ticks the pre-op bloodwork check), and View preparation.
-->
<Flyout x:Class="Vigil.Presentation.LabsDrawer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
        xmlns:mvux="using:Uno.Extensions.Reactive.UI"
        xmlns:utu="using:Uno.Toolkit.UI"
        xmlns:local="using:Vigil.Presentation"
        xmlns:controls="using:Vigil.Controls"
        Placement="Full"
        FlyoutPresenterStyle="{StaticResource RecordDrawerPresenterStyle}"
        controls:FlyoutFocus.Restores="True">
  <Grid RowDefinitions="Auto,Auto,*" utu:SafeArea.Insets="VisibleBounds">
    <controls:DrawerHeader x:Uid="LabsDrawer_1" Title="Lab results" CloseCommand="{Binding Close}" />
    <muxc:InfoBar x:Uid="LabsDrawer_2" Grid.Row="1" Severity="Error" Title="Not saved" Message="{Binding SaveError}" IsOpen="{Binding HasSaveError}" IsClosable="False" Margin="{StaticResource InsetX20}">
      <muxc:InfoBar.ActionButton><Button x:Uid="LabsDrawer_3" Content="Dismiss" Command="{Binding DismissError}" /></muxc:InfoBar.ActionButton>
    </muxc:InfoBar>
    <mvux:FeedView Grid.Row="2" Source="{Binding Case}" RefreshingState="None" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False"
                   ProgressTemplate="{StaticResource DrawerProgressTemplate}" NoneTemplate="{StaticResource DrawerNoneTemplate}" ErrorTemplate="{StaticResource DrawerErrorTemplate}">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ScrollViewer HorizontalScrollMode="Disabled">
            <StackPanel Padding="{StaticResource Inset24}" Spacing="{StaticResource Space16}">
              <TextBlock x:Uid="LabsDrawer_4" Text="Lab panels for this visit" Style="{StaticResource TypeH2Section}" />
              <TextBlock x:Uid="LabsDrawer_5" Text="Vigil tracks which panels are pending, ready and reviewed. The reports and their values stay in your lab system." Style="{StaticResource TypeBodyMuted}" TextWrapping="WrapWholeWords" />
              <TextBlock x:Uid="LabsDrawer_6" Text="No lab panels for this visit." Style="{StaticResource TypeBodyMuted}" Visibility="{Binding Data.HasNoLabs, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
              <ItemsControl x:Uid="LabsDrawer_7" ItemsSource="{Binding Data.LabRows}" AutomationProperties.Name="Lab panels">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:LabRow">
                    <Grid Padding="{StaticResource InsetY10}" ColumnSpacing="{StaticResource Space16}" ColumnDefinitions="*,Auto" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="0,0,0,1">
                      <StackPanel Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{x:Bind Panel}" />
                        <TextBlock Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind StateText}" />
                      </StackPanel>
                      <Button x:Uid="LabsDrawer_8" Grid.Column="1" Style="{StaticResource ButtonSecondaryL}" Content="Mark reviewed" Visibility="{x:Bind IsReady}" VerticalAlignment="Center"
                              Command="{utu:AncestorBinding AncestorType=mvux:FeedView, Path=DataContext.ReviewLab}" CommandParameter="{x:Bind Panel}" AutomationProperties.Name="Mark the panel reviewed" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button x:Uid="LabsDrawer_9" Content="View preparation" Command="{Binding Parent.ViewPreparation}" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" />
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>
    </mvux:FeedView>
  </Grid>
</Flyout>
