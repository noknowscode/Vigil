                      <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="R" />
                      </Button.KeyboardAccelerators>
                      <!-- The due clock in the button's own ink (it was body ink on the primary green, ~1.3:1); phones put
                           it under the label so neither is clipped. -->
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}">
                        <SymbolIcon Symbol="Accept" VerticalAlignment="Center" />
                        <StackPanel Orientation="{utu:Responsive Narrowest=Vertical, Normal=Horizontal}" Spacing="{utu:Responsive Narrowest=0, Normal={StaticResource Space12}}" VerticalAlignment="Center">
                          <TextBlock x:Uid="Record_48" Text="Record reading" />
                          <TextBlock Style="{StaticResource TypeMonoCell}" Foreground="{ThemeResource OnPrimaryInkBrush}" Text="{Binding Data.ClockText}" VerticalAlignment="Center" />
                        </StackPanel>
                      </StackPanel>
                    </Button>
                    <Grid ColumnSpacing="{utu:Responsive Narrowest={StaticResource Space8}, Normal={StaticResource Space16}}" RowSpacing="{StaticResource Space16}">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <controls:VitalStepper x:Uid="Record_49" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Hr" Label="HR" Unit="bpm" Glyph="●" GlyphBrush="{ThemeResource VitalHrBrush}" SpokenName="heart rate, beats per minute" Text="{Binding Parent.Draft.Hr, Mode=TwoWay}" Flag="{Binding Parent.Flags.Hr}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_50" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="Rr" Label="RR" Unit="/min" Glyph="" GlyphBrush="{ThemeResource InkMutedBrush}" SpokenName="respiratory rate, breaths per minute" Text="{Binding Parent.Draft.Rr, Mode=TwoWay}" Flag="{Binding Parent.Flags.Rr}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_51" Grid.Row="{utu:Responsive Narrowest=2, Normal=1}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="SpO2" Label="SpO₂" Unit="%" Glyph="○" GlyphBrush="{ThemeResource VitalSpO2Brush}" SpokenName="oxygen saturation, percent" Text="{Binding Parent.Draft.SpO2, Mode=TwoWay}" Flag="{Binding Parent.Flags.SpO2}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_52" Grid.Row="{utu:Responsive Narrowest=3, Normal=1}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="EtCo2" Label="EtCO₂" Unit="mmHg" Glyph="×" GlyphBrush="{ThemeResource VitalEtCo2Brush}" SpokenName="end-tidal CO2, millimetres of mercury" Text="{Binding Parent.Draft.EtCo2, Mode=TwoWay}" Flag="{Binding Parent.Flags.EtCo2}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_53" Grid.Row="{utu:Responsive Narrowest=4, Normal=2}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Sys" Label="SYS" Unit="mmHg" Glyph="∨" GlyphBrush="{ThemeResource VitalBpBrush}" SpokenName="systolic pressure" Text="{Binding Parent.Draft.Sys, Mode=TwoWay}" Flag="{Binding Parent.Flags.Sys}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_54" Grid.Row="{utu:Responsive Narrowest=5, Normal=2}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="Dia" Label="DIA" Unit="mmHg" Glyph="∧" GlyphBrush="{ThemeResource VitalBpBrush}" SpokenName="diastolic pressure" Text="{Binding Parent.Draft.Dia, Mode=TwoWay}" Flag="{Binding Parent.Flags.Dia}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_55" Grid.Row="{utu:Responsive Narrowest=6, Normal=3}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Map" Label="MAP" Unit="mmHg" Glyph="" GlyphBrush="{ThemeResource InkMutedBrush}" SpokenName="mean arterial pressure" Text="{Binding Parent.Draft.Map, Mode=TwoWay}" Flag="{Binding Parent.Flags.Map}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_56" Grid.Row="{utu:Responsive Narrowest=7, Normal=3}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="TempC" Label="Temp" Unit="°C" Glyph="■" GlyphBrush="{ThemeResource VitalTempBrush}" SpokenName="temperature, degrees Celsius" Text="{Binding Parent.Draft.TempC, Mode=TwoWay}" Flag="{Binding Parent.Flags.TempC}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_57" Grid.Row="{utu:Responsive Narrowest=8, Normal=4}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Vaporizer" Label="Sevo" Unit="%" Glyph="" GlyphBrush="{ThemeResource InkMutedBrush}" SpokenName="vaporizer setting, percent" Text="{Binding Parent.Draft.Vaporizer, Mode=TwoWay}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_58" Grid.Row="{utu:Responsive Narrowest=9, Normal=4}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="O2" Label="O₂" Unit="L/min" Glyph="" GlyphBrush="{ThemeResource InkMutedBrush}" SpokenName="oxygen flow, litres per minute" Text="{Binding Parent.Draft.O2, Mode=TwoWay}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                    </Grid>
                    <TextBlock Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords">
                      <Run x:Uid="Record_59" Text="MAP left blank is derived as (SYS + 2·DIA) / 3:" />
                      <Run Text="{Binding Parent.Flags.MapHint}" />
                    </TextBlock>
                    <muxc:RadioButtons x:Uid="Record_60" Header="Anesthetic plane" MaxColumns="3" SelectedIndex="{Binding Parent.Draft.PlaneIndex, Mode=TwoWay}">
                      <RadioButton x:Uid="Record_61" Content="Light" />
                      <RadioButton x:Uid="Record_62" Content="Surgical" />
                      <RadioButton x:Uid="Record_63" Content="Deep" />
                    </muxc:RadioButtons>
                    <TextBox x:Uid="Record_64" Header="Note (optional)" Text="{Binding Parent.Draft.Note, Mode=TwoWay}" AutomationProperties.Name="Note for this reading" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>


              <ScrollViewer Visibility="{Binding Parent.PaneRecovery}">
                <StackPanel Padding="{StaticResource MetricCardInset}" Spacing="{StaticResource Space24}" MaxWidth="{StaticResource ReadingMaxWidth}" HorizontalAlignment="Stretch">


                  <StackPanel Spacing="{StaticResource Space8}" Visibility="{Binding Data.IsAnesthetized}">
                    <TextBlock x:Uid="Record_65" Style="{StaticResource TypeH2Section}" Foreground="{ThemeResource InkBrush}" Text="Patient is under anesthesia" />
                    <TextBlock x:Uid="Record_66" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" Text="End anesthesia when the vaporizer is off. The reading clock stops and recovery starts." />
                    <Button x:Uid="Record_67" Style="{StaticResource ButtonPrimaryL}" HorizontalAlignment="Left" MinWidth="{StaticResource ActionMinWidth}" Content="End anesthesia" Command="{Binding Parent.EndAnesthesia}" AutomationProperties.Name="End anesthesia" />
                  </StackPanel>

                  <StackPanel Spacing="{StaticResource Space4}" Visibility="{Binding Data.IsNotAnesthetized}">
                    <TextBlock x:Uid="Record_68" Style="{StaticResource TypeEyebrow}" Text="RECOVERY" />
                    <TextBlock x:Uid="Record_69" Style="{StaticResource TypeMonoVital}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.RecoveryAnchor}" AutomationProperties.Name="Time in recovery" />
                    <TextBlock Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Text="{Binding Data.RecoveryAnchorLabel}" />
                  </StackPanel>

                  <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False" Visibility="{Binding Data.IsNotAnesthetized}">
                    <StackPanel Padding="{StaticResource Inset20}" Spacing="{StaticResource Space12}">
                      <TextBlock x:Uid="Record_70" Style="{StaticResource TypeTitleM}" Foreground="{ThemeResource InkBrush}" Text="Recovery log" />
                      <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{StaticResource Space12}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="{StaticResource Space6}">
                          <Button x:Uid="Record_71" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Stretch" Content="Extubated now" Visibility="{Binding Data.IsNotExtubated}" Command="{Binding Parent.Extubate}" AutomationProperties.Name="Record extubation now" />
                          <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.ExtubatedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space6}">
                          <Button x:Uid="Record_72" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Stretch" Content="Sternal now" Visibility="{Binding Data.IsNotSternal}" Command="{Binding Parent.Sternal}" AutomationProperties.Name="Record sternal recumbency now" />
                          <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" Text="{Binding Data.SternalText}" />
                        </StackPanel>
                      </Grid>
                      <!-- Pain score: each tap records a timed score (the 15-minute task resets even when the score is unchanged). -->
                      <StackPanel Spacing="{StaticResource Space8}">
                        <TextBlock x:Uid="Record_159" Text="Pain score (0 none to 4 severe)" Style="{StaticResource TypeBodyS}" FontWeight="Medium" />
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" Visibility="{Binding Data.CanEditRecovery}">
                          <Button x:Uid="Record_160" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="0" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="0" AutomationProperties.Name="Record pain score 0" />
                          <Button x:Uid="Record_161" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="1" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="1" AutomationProperties.Name="Record pain score 1" />
                          <Button x:Uid="Record_162" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="2" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="2" AutomationProperties.Name="Record pain score 2" />
                          <Button x:Uid="Record_163" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="3" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="3" AutomationProperties.Name="Record pain score 3" />
                          <Button x:Uid="Record_164" Style="{StaticResource ButtonSecondaryM}" MinWidth="{StaticResource ScoreButtonMinWidth}" Content="4" IsEnabled="{Binding Data.CanEditRecovery}" Command="{Binding Parent.ScorePain}" CommandParameter="4" AutomationProperties.Name="Record pain score 4" />
                        </StackPanel>
                        <TextBlock Text="{Binding Data.PainText}" Style="{StaticResource TypeBodyS}" AutomationProperties.LiveSetting="Polite" />
                      </StackPanel>
                      <TextBox x:Uid="Record_75" Header="Temperature (°C)" InputScope="Number" MaxWidth="{StaticResource ShortFieldMaxWidth}" HorizontalAlignment="Left" IsEnabled="{Binding Data.CanEditRecovery}" Text="{Binding Parent.Recovery.TempC, Mode=TwoWay}" />
                      <TextBox x:Uid="Record_76" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" IsEnabled="{Binding Data.CanEditRecovery}" Text="{Binding Parent.Recovery.Notes, Mode=TwoWay}" />
                    </StackPanel>
                  </utu:CardContentControl>

                  <StackPanel Spacing="{StaticResource Space8}">
                    <Button x:Uid="Record_77" Style="{StaticResource ButtonPrimaryL}" HorizontalAlignment="Left" MinWidth="{StaticResource ActionMinWidth}" Content="Sign off" Visibility="{Binding Data.IsRecovery}" Command="{Binding Parent.OpenSignOff}" AutomationProperties.Name="Sign off the record" />
                    <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.SignedText}" />
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space12}" Visibility="{Binding Data.IsSigned}">
                      <Button x:Uid="Record_78" Style="{StaticResource ButtonPrimaryL}" Content="Export CSV" Command="{Binding Parent.Export}" AutomationProperties.Name="Export the record as CSV" />
                      <Button x:Uid="Record_79" Style="{StaticResource ButtonSecondaryL}" Content="Copy summary" Command="{Binding Parent.CopySummary}" AutomationProperties.Name="Copy a text summary" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" Text="{Binding Parent.Notice}" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>

                  <!-- Discharge call to the pet parent (a "Due next" task): recorded here once made. -->
                  <StackPanel Spacing="{StaticResource Space8}" Visibility="{Binding Data.HasDischargeCall}">
                    <TextBlock x:Uid="Record_170" Style="{StaticResource TypeTitleM}" Foreground="{ThemeResource InkBrush}" Text="Discharge call" />
                    <TextBlock Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Text="{Binding Data.DischargeText}" TextWrapping="WrapWholeWords" />
                    <Button x:Uid="Record_171" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" MinWidth="{StaticResource ActionMinWidth}" Content="Call made" Visibility="{Binding Data.CanCompleteCall}" Command="{Binding Parent.CompleteDischargeCall}" AutomationProperties.Name="Record the discharge call as made" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

    <ScrollViewer Visibility="{Binding Parent.PaneHistory}"><StackPanel Padding="{StaticResource Inset24}" Spacing="{StaticResource Space16}"><TextBlock Text="{Binding Data.VisitDate}" Style="{StaticResource TypeEyebrow}" /><TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource TypeH2Section}" /><TextBlock Text="{Binding Data.Team}" Style="{StaticResource TypeBodyMuted}" /><TextBlock x:Uid="Record_133" Text="Observations in this record" Style="{StaticResource TypeTitleM}" /><ItemsControl x:Uid="Record_39" ItemsSource="{Binding Data.Readings}" AutomationProperties.Name="Readings table">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:ReadingRow">
                            <Grid Padding="{StaticResource InsetY8}" ColumnSpacing="{StaticResource Space12}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Style="{StaticResource TypeMonoCell}" Foreground="{ThemeResource InkMutedBrush}" Text="{x:Bind Time}" />
                              <StackPanel Grid.Column="1" Spacing="{StaticResource Space2}">
                                <TextBlock Style="{StaticResource TypeMonoCell}" Foreground="{ThemeResource InkBrush}" TextWrapping="Wrap">
                                  <Run x:Uid="Record_40" Text="HR" /> <Run Text="{x:Bind Hr}" />
                                  <Run x:Uid="Record_41" Text=" RR" /> <Run Text="{x:Bind Rr}" />
                                  <Run x:Uid="Record_42" Text=" SpO₂" /> <Run Text="{x:Bind SpO2}" />
                                  <Run x:Uid="Record_43" Text=" BP" /> <Run Text="{x:Bind Bp}" />
                                  <Run x:Uid="Record_44" Text=" MAP" /> <Run Text="{x:Bind Map}" />
                                  <Run x:Uid="Record_45" Text=" EtCO₂" /> <Run Text="{x:Bind EtCo2}" />
                                  <Run x:Uid="Record_46" Text=" T" /> <Run Text="{x:Bind Temp}" />
                                  <Run Text=" " /> <Run Text="{x:Bind Plane}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource TypeEyebrow}" Foreground="{ThemeResource ErrorBrush}" Text="{x:Bind Alarms}" />
                                <TextBlock Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" Text="{x:Bind Note}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </StackPanel></ScrollViewer>
    <ScrollViewer Visibility="{Binding Parent.PaneLabs}"><StackPanel Padding="{StaticResource Inset24}" Spacing="{StaticResource Space16}">
      <TextBlock x:Uid="Record_165" Text="Lab panels for this visit" Style="{StaticResource TypeH2Section}" />
      <TextBlock x:Uid="Record_166" Text="Vigil tracks which panels are pending, ready and reviewed. The reports and their values stay in your lab system." Style="{StaticResource TypeBodyMuted}" TextWrapping="WrapWholeWords" />
      <TextBlock x:Uid="Record_167" Text="No lab panels for this visit." Style="{StaticResource TypeBodyMuted}" Visibility="{Binding Data.HasNoLabs}" />
      <ItemsControl x:Uid="Record_168" ItemsSource="{Binding Data.LabRows}" AutomationProperties.Name="Lab panels">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="local:LabRow">
            <Grid Padding="{StaticResource InsetY10}" ColumnSpacing="{StaticResource Space16}" ColumnDefinitions="*,Auto" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1">
              <StackPanel Spacing="{StaticResource Space2}" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkBrush}" Text="{x:Bind Panel}" />
                <TextBlock Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" Text="{x:Bind StateText}" />
              </StackPanel>
              <Button x:Uid="Record_169" Grid.Column="1" Style="{StaticResource ButtonSecondaryL}" Content="Mark reviewed" Visibility="{x:Bind IsReady}" VerticalAlignment="Center"
                      Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ReviewLab}" CommandParameter="{x:Bind Panel}" AutomationProperties.Name="Mark the panel reviewed" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <Button x:Uid="Record_137" Content="View preparation" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" />
    </StackPanel></ScrollViewer>
  </Grid>
</Grid></SplitView.Pane>
        </SplitView></Grid>
      </DataTemplate></mvux:FeedView.ValueTemplate>

      <!-- Loading: skeleton of the hero tray, the procedure header and the four cards (same footprint). -->
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}" AutomationProperties.AccessibilityView="Raw">
            <!-- xaml-lint: allow card - skeleton of the hero tray (same footprint as the loaded tray) -->
            <Border Height="{utu:Responsive Narrowest=720, Widest=452}" CornerRadius="{StaticResource Radius26}" Padding="{StaticResource Inset20}" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="{StaticResource Space14}">
                <Rectangle Style="{StaticResource Skeleton}" Width="140" Height="28" />
                <Rectangle Style="{StaticResource Skeleton}" Width="180" Height="56" />
                <Rectangle Style="{StaticResource Skeleton}" Width="150" Height="20" />
                <Rectangle Style="{StaticResource Skeleton}" Width="200" Height="200" Margin="{StaticResource GapTop8}" />
              </StackPanel>
            </Border>
            <Rectangle Style="{StaticResource Skeleton}" Margin="{StaticResource GapTop48}" Width="320" Height="28" />
            <Rectangle Style="{StaticResource Skeleton}" Margin="{StaticResource GapTop6}" Width="260" Height="20" />
            <!-- xaml-lint: allow card - skeleton of the anesthesia record card -->
            <Border Margin="{StaticResource GapTop16}" Height="292" CornerRadius="{StaticResource Radius18}" Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" Padding="{StaticResource LiveCardInset}">
              <StackPanel Spacing="{StaticResource Space10}">
                <Rectangle Style="{StaticResource Skeleton}" Width="160" Height="20" />
                <Rectangle Style="{StaticResource Skeleton}" Width="220" Height="16" />
                <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="170" Margin="{StaticResource GapTop8}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}">
            <!-- xaml-lint: allow card - None state inside the hero tray footprint -->
            <Border MinHeight="452" CornerRadius="{StaticResource Radius26}" Padding="{StaticResource Inset32}" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="{StaticResource Space8}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Uid="Record_105" Text="This record no longer exists." Style="{StaticResource TypeTitleM}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Uid="Record_106" Text="It may have been cleared from this device." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>

      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}">
            <!-- xaml-lint: allow card - Error state inside the hero tray footprint -->
            <Border MinHeight="452" CornerRadius="{StaticResource Radius26}" Padding="{StaticResource Inset32}" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="{StaticResource Space12}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" HorizontalAlignment="Center">
                  <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Uid="Record_107" Text="Couldn't read this record." Style="{StaticResource TypeTitleM}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock x:Uid="Record_108" Text="The record file could not be read. Nothing was changed." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button x:Uid="Record_109" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Center" Content="Retry" AutomationProperties.Name="Retry reading the record" Command="{Binding DataContext.Retry, ElementName=CaseFeed}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
