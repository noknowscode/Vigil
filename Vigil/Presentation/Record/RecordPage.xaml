<!--
  Patient care (route Main/Record, data CaseRef), docs/design/patient-care-values.md. Header (back, breadcrumb, top
  bar cluster), hero tray (identity + record nav | photo | weight + status card + CTA), overdue banner, procedure
  header, metric cards (anesthesia record chart, latest medication, circulation, respiration). Every record action
  opens its pane as a drawer over the page (RecordModel.OpenPane, routes "!Preop", "!Dose", "!Drugs", "!Monitor",
  "!Recovery", "!History", "!Labs"; Presentation/Record/Drawers), each with its own model. FeedView states: Progress =
  skeleton of the tray and cards, None = record gone, Error = message + Retry (Store.Reload, bound by ElementName: the
  ErrorTemplate's DataContext is the exception).
  Breakpoints (default, Styles/Layout.xaml): below Widest the hero stacks (identity + photo, status column below) and
  the cards go 2 x 2; below Wide (phones and the 600-800 rail layout) everything is one column. At Widest the header and
  body stop at ContentMaxWidth and centre.
-->
<Page x:Class="Vigil.Presentation.RecordPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" xmlns:mvux="using:Uno.Extensions.Reactive.UI" xmlns:utu="using:Uno.Toolkit.UI" xmlns:local="using:Vigil.Presentation" xmlns:controls="using:Vigil.Controls" xmlns:domain="using:Vigil.Domain" xmlns:media="using:Microsoft.UI.Xaml.Media" xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:not_win="http://uno.ui/not_win" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="not_win" Background="Transparent">
  <Page.Resources>
    <!-- Breadcrumb link: 14/20 muted, no underline (the prototype overrides it to transparent); hover ink.
         xaml-lint: allow template - text-only link with an ink hover, no button chrome -->
    <Style x:Key="CrumbLink" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Text.Foreground" Value="{ThemeResource OnSurfaceBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Text.Foreground" Value="{ThemeResource OnSurfaceBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Style="{StaticResource BodyMedium}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChartLabel" TargetType="TextBlock" BasedOn="{StaticResource NumeralLabelExtraSmall}">
      <Setter Property="Foreground" Value="{ThemeResource OnSurfaceVariantBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="AxisY" TargetType="TextBlock" BasedOn="{StaticResource ChartLabel}">
      <Setter Property="Width" Value="26" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="AxisX" TargetType="TextBlock" BasedOn="{StaticResource ChartLabel}">
      <Setter Property="Width" Value="40" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="Skeleton" TargetType="Rectangle">
      <Setter Property="RadiusX" Value="6" />
      <Setter Property="RadiusY" Value="6" />
      <Setter Property="Fill" Value="{ThemeResource SurfaceVariantBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource BodyMedium}">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="{StaticResource Space150LeftThickness}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,Auto,*">
    <!-- 1. Header: back and breadcrumb (40 px). Outside the FeedView so it shows in every state. A grid, not a horizontal
         StackPanel, so a long patient name trims. -->
    <Grid Padding="{utu:Responsive Narrowest={StaticResource PageHeaderInsetNarrow}, Normal={StaticResource PageHeaderInsetNormal}}" MaxWidth="{StaticResource ContentMaxWidth}">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="{StaticResource Space150}" VerticalAlignment="Center">
        <Button x:Uid="Record_1" Style="{StaticResource ButtonIconSecondary}" Command="{Binding GoBack}" AutomationProperties.Name="Back">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconArrowLeft}" Foreground="{ThemeResource OnSurfaceBrush}" />
        </Button>
        <Button x:Uid="Record_2" Grid.Column="1" Style="{StaticResource CrumbLink}" Content="Patients" Command="{Binding OpenPatients}" VerticalAlignment="Center" AutomationProperties.Name="Patients list" />
        <TextBlock Grid.Column="2" Text="/" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="3" Text="{Binding Name}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </Grid>
    <muxc:InfoBar x:Uid="Record_3" Grid.Row="1" Severity="Error" Title="Not saved" Message="{Binding SaveError}" IsOpen="{Binding HasSaveError}" IsClosable="False" Margin="{utu:Responsive Narrowest={StaticResource Space250HorizontalThickness}, Normal={StaticResource Space500HorizontalThickness}}">
      <muxc:InfoBar.ActionButton><Button x:Uid="Record_4" Content="Dismiss" Command="{Binding DismissError}" /></muxc:InfoBar.ActionButton>
    </muxc:InfoBar>
    <mvux:FeedView x:Name="CaseFeed" Grid.Row="2" Source="{Binding Case}" RefreshingState="None" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False">
      <mvux:FeedView.ValueTemplate>
        <DataTemplate>
          <ScrollViewer HorizontalScrollMode="Disabled">
            <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}" MaxWidth="{StaticResource ContentMaxWidth}">

              <!-- 2. Hero tray: pad 8, radius 26, #F3F3F2, tri-tone, shadow xs; 236 | 1fr | 300, gap 8 -->
              <utu:ShadowContainer Background="{ThemeResource BackgroundBrush}" CornerRadius="{StaticResource Radius700CornerRadius}" Shadows="{StaticResource ShadowXs}">
                <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                <Border CornerRadius="{StaticResource Radius700CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource Space100Thickness}">
                  <Grid ColumnDefinitions="236,*,300" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="{StaticResource Space100}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space100}, Widest=0}">

                    <!-- Identity column: pad T12 R8 B4 L12 -->
                    <Grid Padding="{StaticResource ChartInset}" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Height="{utu:Responsive Narrowest=NaN, Wide=434}"
                          Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1}">
                      <Grid HorizontalAlignment="Left" Height="28">
                        <Border Style="{StaticResource ChipLiveSoft}" Visibility="{Binding Parent.Timers.Care.IsSurgery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}"><Ellipse Width="6" Height="6" Fill="{ThemeResource AnesthesiaBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Parent.Timers.Care.Chip}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Foreground="{ThemeResource OnAnesthesiaContainerBrush}" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipLiveSoft}" Background="{ThemeResource RecoveryContainerBrush}" BorderBrush="{ThemeResource RecoveryOutlineBrush}" Visibility="{Binding Parent.Timers.Care.IsRecovery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}"><Ellipse Width="6" Height="6" Fill="{ThemeResource RecoveryBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Parent.Timers.Care.Chip}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipLiveSoft}" Background="{ThemeResource PrepContainerBrush}" BorderBrush="{ThemeResource PrepOutlineBrush}" Visibility="{Binding Parent.Timers.Care.IsPrep, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}"><Ellipse Width="6" Height="6" Fill="{ThemeResource PrepBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Parent.Timers.Care.Chip}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Foreground="{ThemeResource OnPrepContainerBrush}" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource ChipLiveSoft}" Background="{ThemeResource SurfaceVariantBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" Visibility="{Binding Parent.Timers.Care.IsNeutral, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}"><Ellipse Width="6" Height="6" Fill="{ThemeResource WaitingBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Parent.Timers.Care.Chip}" Style="{StaticResource BodySmall}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" /></StackPanel>
                        </Border>
                      </Grid>
                      <!-- Newsreader sits 4 px lower than the browser places it at 56/60: pulled up, the row keeps its 14 px gap. -->
                      <TextBlock Grid.Row="1" Margin="0,10,0,4" Text="{Binding Data.Name}" Style="{StaticResource DisplayMedium}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="2" Margin="{StaticResource Space050TopThickness}" Text="{Binding Data.Breed}" Style="{StaticResource BodyLarge}" TextWrapping="WrapWholeWords" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="3" Text="{Binding Data.AgeOwner}" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                      <!-- Record nav: the sidebar's nav item (h40, radius 12, icon 18 + 14/20 Medium); each opens its pane. -->
                      <controls:RecordNav Grid.Row="4" Margin="-4,20,0,0" />
                      <!-- Team chip: h32, pad 0 10, radius 10, surface, tri-tone; users 15 -->
                      <!-- xaml-lint: allow card - 32 px team chip (prototype chip: radius 10, tri-tone edge), not a card surface -->
                      <Border Grid.Row="6" Height="32" Padding="{StaticResource Space125HorizontalThickness}" CornerRadius="{StaticResource Radius300CornerRadius}" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                          <ContentControl Style="{StaticResource LineIcon16}" Width="15" Height="15" Content="{StaticResource IconUsers}" VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Data.Team}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                      </Border>
                    </Grid>

                    <!-- Photo panel 520 x 434, radius 16: blurred fill of the same photo (Skia AcrylicBrush over a stretched copy), the
                         photo contained on top, inset-photo shadow, "Pet-parent view" floating bottom right. -->
                    <Grid Grid.Column="{utu:Responsive Narrowest=0, Wide=1}" Grid.Row="{utu:Responsive Narrowest=1, Wide=0}"
                          Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=2, Widest=1}" Height="{utu:Responsive Narrowest=280, Wide=434}">
                      <Rectangle RadiusX="{StaticResource Radius400}" RadiusY="{StaticResource Radius400}" Fill="{ThemeResource SurfaceVariantBrush}" />
                      <Grid Visibility="{Binding Data.HasPhoto, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                        <Rectangle RadiusX="{StaticResource Radius400}" RadiusY="{StaticResource Radius400}" Opacity="0.9">
                          <Rectangle.Fill><ImageBrush ImageSource="{Binding Data.HeroPhoto}" Stretch="Fill" /></Rectangle.Fill>
                        </Rectangle>
                        <!-- xaml-lint: allow card - childless blur layer (Skia-native AcrylicBrush must have no children) -->
                        <Border CornerRadius="{StaticResource Radius400CornerRadius}">
                          <!-- Tint (opacity 0) and fallback come from the theme tokens. UseCompositionEffectBrush is Uno-only (the
                               Skia blur path), so WinUI gets the same brush without it (conditional XAML, platform-specific-xaml.md). -->
                          <Border.Background>
                            <win:AcrylicBrush AlwaysUseFallback="False" TintColor="{ThemeResource SurfaceVariantColor}" TintOpacity="0" TintLuminosityOpacity="0" FallbackColor="{ThemeResource SurfaceVariantColor}" />
                            <not_win:AcrylicBrush AlwaysUseFallback="False" media:AcrylicBrushExtensions.UseCompositionEffectBrush="False" TintColor="{ThemeResource SurfaceVariantColor}" TintOpacity="0" TintLuminosityOpacity="0" FallbackColor="{ThemeResource SurfaceVariantColor}" />
                          </Border.Background>
                        </Border>
                        <Rectangle RadiusX="{StaticResource Radius400}" RadiusY="{StaticResource Radius400}" AutomationProperties.Name="{Binding Data.PhotoName}">
                          <Rectangle.Fill><ImageBrush ImageSource="{Binding Data.HeroPhoto}" Stretch="Uniform" /></Rectangle.Fill>
                        </Rectangle>
                      </Grid>
                      <StackPanel Visibility="{Binding Data.HasNoPhoto, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="{StaticResource Space100}">
                        <ContentControl Style="{StaticResource LineIcon18}" Width="28" Height="28" Content="{StaticResource IconPawPrint}" HorizontalAlignment="Center" />
                        <TextBlock x:Uid="Record_83" Text="Patient photo not added" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
                      </StackPanel>
                      <utu:ShadowContainer Background="Transparent" CornerRadius="{StaticResource Radius400CornerRadius}" IsHitTestVisible="False" Shadows="{StaticResource ShadowInsetPhoto}">
                        <Grid />
                      </utu:ShadowContainer>
                      <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius300CornerRadius}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="{StaticResource Space150Thickness}" Shadows="{StaticResource ShadowFloatButton}">
                        <Button x:Uid="Record_84" Style="{StaticResource ButtonSecondaryM}" Command="{Binding Parent.OpenParentPreview}" AutomationProperties.Name="Pet-parent view">
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                            <TextBlock x:Uid="Record_85" Text="Pet-parent view" Style="{StaticResource LabelMedium}" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconArrowUpRight}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </utu:ShadowContainer>
                    </Grid>

                    <!-- Status column 300: weight card, status card (flex 1), CTA 48. The CTA stays enabled on a signed record:
                         there it is "Review record", the way back to the read-only Recovery pane and its Export CSV. -->
                    <Grid Grid.Column="{utu:Responsive Narrowest=0, Widest=2}" Grid.Row="{utu:Responsive Narrowest=2, Wide=1, Widest=0}"
                          Grid.ColumnSpan="{utu:Responsive Narrowest=3, Widest=1}" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource Space100}">
                      <!-- xaml-lint: allow card - weight tile inside the hero tray (tri-tone gradient edge, exact radius 14 / padding 16 15) -->
                      <Border Padding="{StaticResource AlertInset}" CornerRadius="{StaticResource Radius400CornerRadius}" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
                        <StackPanel>
                          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space100}">
                            <TextBlock x:Uid="Record_86" Text="Weight at this visit" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Style="{StaticResource BadgeOutline}"><TextBlock Text="{Binding Data.Preop.AsaLabel}" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" /></Border>
                          </Grid>
                          <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}" Margin="{StaticResource Space050TopThickness}">
                            <TextBlock Text="{Binding Data.WeightText}" Style="{StaticResource NumeralHeadlineMedium}" />
                            <TextBlock x:Uid="Record_87" Text="kg" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                          </StackPanel>
                          <TextBlock Text="{Binding Data.WeightDate}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        </StackPanel>
                      </Border>
                      <controls:CareStatusCard Grid.Row="1" DataContext="{Binding Parent.Timers}" MinHeight="{utu:Responsive Narrowest=200, Widest=0}" />
                      <Button Grid.Row="2" Style="{StaticResource ButtonPrimaryXL}" Command="{Binding Parent.OpenPane}" CommandParameter="{Binding Parent.Timers.Care.CtaPane}" AutomationProperties.Name="{Binding Parent.Timers.Care.Cta}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                          <TextBlock Text="{Binding Parent.Timers.Care.Cta}" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnPrimaryBrush}" VerticalAlignment="Center" />
                          <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconPlus}" Foreground="{ThemeResource OnPrimaryBrush}" VerticalAlignment="Center" Visibility="{Binding Parent.Timers.Care.IsSurgery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                        </StackPanel>
                      </Button>
                    </Grid>
                  </Grid>
                </Border>
              </utu:ShadowContainer>

              <!-- 3. Overdue banner (role alert): min-h 64, pad 10 12 10 14, radius 16, error soft -->
              <!-- xaml-lint: allow card - role=alert banner (error soft fill and border), not a card surface -->
              <Border Margin="{StaticResource Space200TopThickness}" MinHeight="64" Padding="{StaticResource ChipInsetRoomy}" CornerRadius="{StaticResource Radius400CornerRadius}" Background="{ThemeResource ErrorContainerBrush}" BorderBrush="{ThemeResource ErrorLowBrush}" BorderThickness="1"
                      Visibility="{Binding Parent.Timers.IsOverdue, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Parent.Timers.OverdueTitle}">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space150}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space100}, Wide=0}">
                  <Grid Width="36" Height="36" VerticalAlignment="Center">
                    <Rectangle RadiusX="{StaticResource Radius300}" RadiusY="{StaticResource Radius300}" Fill="{ThemeResource ErrorLowBrush}" />
                    <ContentControl Style="{StaticResource LineIcon16Bold}" Width="18" Height="18" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource OnErrorContainerBrush}" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Parent.Timers.OverdueTitle}" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnErrorContainerBrush}" />
                    <TextBlock Text="{Binding Data.OverdueDetail}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnErrorContainerBrush}" TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <Button x:Uid="Record_88" Grid.Column="{utu:Responsive Narrowest=1, Wide=2}" Grid.Row="{utu:Responsive Narrowest=1, Wide=0}"
                          Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Record observations" Command="{Binding Parent.OpenPane}" CommandParameter="Monitor" />
                </Grid>
              </Border>
              <muxc:InfoBar x:Uid="Record_89" Margin="{StaticResource Space200TopThickness}" Severity="Warning" Title="Latest recorded observations need attention" Message="{Binding Data.Alert}" IsOpen="{Binding Data.HasAlert}" Visibility="{Binding Data.HasAlert, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" IsClosable="False" />

              <!-- 4. Procedure header: h2 20/28 + meta; Pre-op (secondary-l), Administer dose (primary-l + syringe).
                   Under anesthesia, End anesthesia (secondary-l) comes first: it opens the Recovery pane, which holds the
                   command with its "vaporizer off" note and then the recovery log. Below 600 px it sits above the pair. -->
              <Grid Margin="{StaticResource Space400TopThickness}" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space200}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space150}, Wide=0}">
                <StackPanel VerticalAlignment="Center">
                  <TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource TitleMedium}" TextWrapping="WrapWholeWords" />
                  <TextBlock Margin="{StaticResource Space025TopThickness}" Text="{Binding Data.ProcedureMeta}" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" />
                </StackPanel>
                <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Wide=1}" Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Orientation="{utu:Responsive Narrowest=Vertical, Normal=Horizontal}" Spacing="{StaticResource Space100}" VerticalAlignment="Center" HorizontalAlignment="Left">
                  <Button x:Uid="Record_EndAnesthesia" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" Content="End anesthesia" Visibility="{Binding Data.IsAnesthetized, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Command="{Binding Parent.OpenPane}" CommandParameter="Recovery" AutomationProperties.Name="End anesthesia, opens Recovery and handover" />
                  <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                    <Button x:Uid="Record_90" Style="{StaticResource ButtonSecondaryL}" Content="Pre-op" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" AutomationProperties.Name="Pre-op preparation" />
                    <Button x:Uid="Record_91" Style="{StaticResource ButtonPrimaryL}" IsEnabled="{Binding Data.CanChange}" Command="{Binding Parent.OpenPane}" CommandParameter="Dose" AutomationProperties.Name="Administer dose">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}">
                        <TextBlock x:Uid="Record_92" Text="Administer dose" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" Foreground="{ThemeResource OnPrimaryBrush}" VerticalAlignment="Center" />
                        <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconSyringe}" Foreground="{ThemeResource OnPrimaryBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </Grid>
              <!-- xaml-lint: allow card - transient acknowledgement chip -->
              <Border Margin="{StaticResource Space150TopThickness}" Background="{ThemeResource AnesthesiaContainerBrush}" Padding="{StaticResource Inset12x8}" CornerRadius="{StaticResource Radius300CornerRadius}" HorizontalAlignment="Left" Visibility="{Binding Parent.ShowAcknowledgement, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}"><controls:CareMark Width="18" Height="20" Acknowledge="{Binding Parent.ShowAcknowledgement}" ReduceMotion="{Binding Parent.ReduceMotion}" /><TextBlock x:Uid="Record_93" Text="Dose recorded · visual acknowledgement only" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
              </Border>

              <!-- 5. Metric cards: 2.1fr | 1.2fr | 1fr | 1fr, gap 16 (five star columns so 2 x 2 below 1080 splits evenly) -->
              <Grid Margin="{StaticResource Space200TopThickness}" ColumnDefinitions="40.24*,9.76*,11.67*,19.16*,19.16*" RowDefinitions="Auto,Auto,Auto,Auto"
                    ColumnSpacing="{utu:Responsive Narrowest=0, Wide={StaticResource Space200}}" RowSpacing="{StaticResource Space200}">

                <!-- Card A: Anesthesia record -->
                <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius400CornerRadius}"
                                     Grid.ColumnSpan="{utu:Responsive Narrowest=5, Wide=2, Widest=1}" Shadows="{StaticResource ShadowXs}">
                  <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                  <Border CornerRadius="{StaticResource Radius400CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource MetricTileInset}">
                    <StackPanel>
                      <TextBlock x:Uid="Record_94" Text="Anesthesia record" Style="{StaticResource BodyLarge}" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Data.ChartCaption}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <StackPanel Margin="{StaticResource Space125TopThickness}" Orientation="Horizontal" Spacing="{StaticResource Space150}">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}"><Rectangle Width="12" Height="2" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource AnesthesiaBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="Record_96" Text="HR bpm" Style="{StaticResource CaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}"><Rectangle Width="4" Height="12" RadiusX="{StaticResource Radius050}" RadiusY="{StaticResource Radius050}" Fill="{ThemeResource RecoveryBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="Record_97" Text="BP mmHg" Style="{StaticResource CaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}" Visibility="{Binding Data.Chart.HasDue, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"><Rectangle Width="8" Height="12" RadiusX="{StaticResource Radius100}" RadiusY="{StaticResource Radius100}" Fill="{ThemeResource ErrorContainerBrush}" Stroke="{ThemeResource ErrorBrush}" StrokeThickness="1" StrokeDashArray="2,1" VerticalAlignment="Center" /><TextBlock Text="{Binding Data.Chart.DueLabel}" Style="{StaticResource CaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" /></StackPanel>
                      </StackPanel>
                      <!-- The chart: viewBox 400 x 188, scaled uniformly to the card (patient-care-values.md §3.4). -->
                      <Viewbox Margin="{StaticResource Space150TopThickness}" Stretch="Uniform" AutomationProperties.Name="{Binding Data.Chart.AccessibleName}">
                        <Grid Width="400" Height="188">
                          <Path Data="{Binding Data.Chart.DueBand}" Fill="{ThemeResource ErrorContainerBrush}" />
                          <Path Data="{Binding Data.Chart.DueLine}" Stroke="{ThemeResource ErrorBrush}" StrokeThickness="1.5" StrokeDashArray="2,2" />
                          <!-- xaml-lint: allow icon - chart gridlines in the 400 x 188 viewBox, not an icon -->
                          <Path Data="M34,12H378M34,38H378M34,64.5H378" Stroke="{ThemeResource OutlineVariantBrush}" StrokeThickness="1" />
                          <TextBlock Margin="{StaticResource Space075TopThickness}" Text="{Binding Data.Chart.Hr0}" Style="{StaticResource AxisY}" />
                          <TextBlock Margin="{StaticResource Space400TopThickness}" Text="{Binding Data.Chart.Hr1}" Style="{StaticResource AxisY}" />
                          <TextBlock Margin="0,58,0,0" Text="{Binding Data.Chart.Hr2}" Style="{StaticResource AxisY}" />
                          <Path Data="{Binding Data.Chart.HrLine}" Stroke="{ThemeResource AnesthesiaBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                          <Path Data="{Binding Data.Chart.HrPoints}" Fill="{ThemeResource AnesthesiaBrush}" Stroke="{ThemeResource SurfaceBrush}" StrokeThickness="2" />
                          <Path Data="{Binding Data.Chart.HrLast}" Fill="{ThemeResource AnesthesiaBrush}" Stroke="{ThemeResource SurfaceBrush}" StrokeThickness="2" />
                          <!-- xaml-lint: allow icon - chart gridlines in the 400 x 188 viewBox, not an icon -->
                          <Path Data="M34,96.5H378M34,128H378M34,160H378" Stroke="{ThemeResource OutlineVariantBrush}" StrokeThickness="1" />
                          <TextBlock Margin="0,90,0,0" Text="{Binding Data.Chart.Bp0}" Style="{StaticResource AxisY}" />
                          <TextBlock Margin="0,122,0,0" Text="{Binding Data.Chart.Bp1}" Style="{StaticResource AxisY}" />
                          <TextBlock Margin="0,154,0,0" Text="{Binding Data.Chart.Bp2}" Style="{StaticResource AxisY}" />
                          <Path Data="{Binding Data.Chart.BpBars}" Stroke="{ThemeResource RecoveryBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                          <TextBlock Margin="14,174,0,0" Text="{Binding Data.Chart.X0}" Style="{StaticResource AxisX}" />
                          <TextBlock Margin="82.8,174,0,0" Text="{Binding Data.Chart.X1}" Style="{StaticResource AxisX}" />
                          <TextBlock Margin="151.6,174,0,0" Text="{Binding Data.Chart.X2}" Style="{StaticResource AxisX}" />
                          <TextBlock Margin="220.4,174,0,0" Text="{Binding Data.Chart.X3}" Style="{StaticResource AxisX}" />
                          <TextBlock Margin="289.2,174,0,0" Text="{Binding Data.Chart.X4}" Style="{StaticResource AxisX}" />
                          <TextBlock Margin="358,174,0,0" Text="{Binding Data.Chart.X5}" Style="{StaticResource AxisX}" />
                          <TextBlock x:Uid="Record_98" Margin="34,74,0,0" Width="344" TextAlignment="Center" Text="No readings recorded yet" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Visibility="{Binding Data.Chart.HasNoReadings, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                        </Grid>
                      </Viewbox>
                    </StackPanel>
                  </Border>
                </utu:ShadowContainer>

                <!-- Card B: Latest medication, Next dose, Fluids -->
                <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius400CornerRadius}"
                                     Grid.Column="{utu:Responsive Narrowest=0, Wide=2, Widest=1}" Grid.Row="{utu:Responsive Narrowest=1, Wide=0}"
                                     Grid.ColumnSpan="{utu:Responsive Narrowest=5, Wide=3, Widest=2}" Shadows="{StaticResource ShadowXs}">
                  <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                  <Border CornerRadius="{StaticResource Radius400CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource MetricTileInset}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                        <ContentControl Style="{StaticResource LineIcon16}" Width="15" Height="15" Content="{StaticResource IconSyringe}" VerticalAlignment="Center" />
                        <TextBlock x:Uid="Record_99" Text="Latest medication" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" FontWeight="Medium" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock Grid.Row="1" Margin="{StaticResource Space100TopThickness}" Text="{Binding Data.MedicationSummary}" Style="{StaticResource TitleSmall}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="2" Text="{Binding Data.MedicationDetail}" Style="{StaticResource NumeralCaptionLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Visibility="{Binding Data.HasDoses, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                      <TextBlock Grid.Row="2" Text="{Binding Data.MedicationDetail}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Visibility="{Binding Data.HasNoDoses, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                      <StackPanel Grid.Row="3" Margin="{StaticResource Space200TopThickness}" Padding="{StaticResource Space150TopThickness}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
                        <TextBlock x:Uid="Record_100" Text="Next dose" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                        <TextBlock Margin="{StaticResource Space025TopThickness}" Text="{Binding Parent.Timers.NextDose.Time}" Style="{StaticResource NumeralTitleLarge}" />
                        <TextBlock Text="{Binding Parent.Timers.NextDose.Detail}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" />
                      </StackPanel>
                      <!-- The fluids line opens the Medication record pane, where fluids start and stop. -->
                      <Button Grid.Row="5" Margin="-8,8,-8,-6" Style="{StaticResource RowLinkButton}"
                              Command="{Binding Parent.OpenPane}" CommandParameter="Drugs" AutomationProperties.Name="{Binding Data.Fluids.Text}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Space100}">
                          <Grid Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse Fill="{ThemeResource AnesthesiaBrush}" Visibility="{Binding Data.Fluids.IsRunning, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                            <Ellipse Fill="{ThemeResource WaitingBrush}" Visibility="{Binding Data.Fluids.IsStopped, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                          </Grid>
                          <TextBlock Grid.Column="1" Text="{Binding Data.Fluids.Text}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          <ContentControl Grid.Column="2" Style="{StaticResource LineIcon16}" Content="{StaticResource IconChevronRight}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </Grid>
                  </Border>
                </utu:ShadowContainer>

                <!-- Card C: Circulation -->
                <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius400CornerRadius}"
                                     Grid.Column="{utu:Responsive Narrowest=0, Wide=0, Widest=3}" Grid.Row="{utu:Responsive Narrowest=2, Wide=1, Widest=0}"
                                     Grid.ColumnSpan="{utu:Responsive Narrowest=5, Wide=2, Widest=1}" Shadows="{StaticResource ShadowXs}">
                  <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                  <Border CornerRadius="{StaticResource Radius400CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource MetricTileInset}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                        <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconHeartPulse}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Uid="Record_101" Text="Circulation" Style="{StaticResource BodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock x:Uid="Record_102" Grid.Row="1" Margin="{StaticResource Space125TopThickness}" Text="Heart rate · bpm" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <TextBlock Grid.Row="2" Text="{Binding Data.LastHr}" Style="{StaticResource NumeralDisplaySmall}" />
                      <Grid Grid.Row="3" Margin="{StaticResource Space150TopThickness}" Height="32" AutomationProperties.AccessibilityView="Raw">
                        <Path Data="{Binding Data.HrSpark.Data}" Margin="{Binding Data.HrSpark.LineMargin}" Height="{Binding Data.HrSpark.Height}" VerticalAlignment="Top" Stretch="Fill"
                              Stroke="{ThemeResource AnesthesiaBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Width="8" Height="8" Margin="{Binding Data.HrSpark.DotMargin}" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{ThemeResource AnesthesiaBrush}" Visibility="{Binding Data.HrSpark.HasLine, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                      </Grid>
                      <TextBlock Grid.Row="5" Padding="{StaticResource Space150TopThickness}" Text="{Binding Data.CirculationDetail}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </utu:ShadowContainer>

                <!-- Card D: Respiration -->
                <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius400CornerRadius}"
                                     Grid.Column="{utu:Responsive Narrowest=0, Wide=2, Widest=4}" Grid.Row="{utu:Responsive Narrowest=3, Wide=1, Widest=0}"
                                     Grid.ColumnSpan="{utu:Responsive Narrowest=5, Wide=3, Widest=1}" Shadows="{StaticResource ShadowXs}">
                  <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                  <Border CornerRadius="{StaticResource Radius400CornerRadius}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource MetricTileInset}">
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space075}">
                        <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconWind}" Foreground="{ThemeResource OnSurfaceBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Uid="Record_103" Text="Respiration" Style="{StaticResource BodyLarge}" FontWeight="SemiBold" VerticalAlignment="Center" />
                      </StackPanel>
                      <TextBlock x:Uid="Record_104" Grid.Row="1" Margin="{StaticResource Space125TopThickness}" Text="Oxygen saturation" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="{StaticResource Space050}">
                        <TextBlock Text="{Binding Data.LastSpo2}" Style="{StaticResource NumeralDisplaySmall}" />
                        <TextBlock Text="%" Style="{StaticResource BodyLarge}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Bottom" Margin="{StaticResource Space050BottomThickness}" />
                      </StackPanel>
                      <Grid Grid.Row="3" Margin="{StaticResource Space150TopThickness}" Height="32" AutomationProperties.AccessibilityView="Raw">
                        <Path Data="{Binding Data.SpO2Spark.Data}" Margin="{Binding Data.SpO2Spark.LineMargin}" Height="{Binding Data.SpO2Spark.Height}" VerticalAlignment="Top" Stretch="Fill"
                              Stroke="{ThemeResource OnSurfaceVariantBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Ellipse Width="8" Height="8" Margin="{Binding Data.SpO2Spark.DotMargin}" HorizontalAlignment="Right" VerticalAlignment="Top" Fill="{ThemeResource OnSurfaceVariantBrush}" Visibility="{Binding Data.SpO2Spark.HasLine, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                      </Grid>
                      <TextBlock Grid.Row="5" Padding="{StaticResource Space150TopThickness}" Text="{Binding Data.RespirationDetail}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                </utu:ShadowContainer>
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </DataTemplate>
      </mvux:FeedView.ValueTemplate>

      <!-- Loading: skeleton of the hero tray, the procedure header and the four cards (same footprint). -->
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}" AutomationProperties.AccessibilityView="Raw">
            <!-- xaml-lint: allow card - skeleton of the hero tray (same footprint as the loaded tray) -->
            <Border Height="{utu:Responsive Narrowest=720, Widest=452}" CornerRadius="{StaticResource Radius700CornerRadius}" Padding="{StaticResource Space250Thickness}" Background="{ThemeResource BackgroundBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
              <StackPanel Spacing="{StaticResource Space150}">
                <Rectangle Style="{StaticResource Skeleton}" Width="140" Height="28" />
                <Rectangle Style="{StaticResource Skeleton}" Width="180" Height="56" />
                <Rectangle Style="{StaticResource Skeleton}" Width="150" Height="20" />
                <Rectangle Style="{StaticResource Skeleton}" Width="200" Height="200" Margin="{StaticResource Space100TopThickness}" />
              </StackPanel>
            </Border>
            <Rectangle Style="{StaticResource Skeleton}" Margin="{StaticResource Space600TopThickness}" Width="320" Height="28" />
            <Rectangle Style="{StaticResource Skeleton}" Margin="{StaticResource Space075TopThickness}" Width="260" Height="20" />
            <!-- xaml-lint: allow card - skeleton of the anesthesia record card -->
            <Border Margin="{StaticResource Space200TopThickness}" Height="292" CornerRadius="{StaticResource Radius400CornerRadius}" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource LiveCardInset}">
              <StackPanel Spacing="{StaticResource Space125}">
                <Rectangle Style="{StaticResource Skeleton}" Width="160" Height="20" />
                <Rectangle Style="{StaticResource Skeleton}" Width="220" Height="16" />
                <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="170" Margin="{StaticResource Space100TopThickness}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}">
            <!-- xaml-lint: allow card - None state inside the hero tray footprint -->
            <Border MinHeight="452" CornerRadius="{StaticResource Radius700CornerRadius}" Padding="{StaticResource Space400Thickness}" Background="{ThemeResource BackgroundBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
              <StackPanel Spacing="{StaticResource Space100}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Uid="Record_105" Text="This record no longer exists." Style="{StaticResource TitleSmall}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Uid="Record_106" Text="It may have been cleared from this device." Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>

      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageBodyInsetNarrow}, Normal={StaticResource PageBodyInsetNormal}}">
            <!-- xaml-lint: allow card - Error state inside the hero tray footprint -->
            <Border MinHeight="452" CornerRadius="{StaticResource Radius700CornerRadius}" Padding="{StaticResource Space400Thickness}" Background="{ThemeResource BackgroundBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1">
              <StackPanel Spacing="{StaticResource Space150}" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space100}" HorizontalAlignment="Center">
                  <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Uid="Record_107" Text="Couldn't read this record." Style="{StaticResource TitleSmall}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock x:Uid="Record_108" Text="The record file could not be read. Nothing was changed." Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button x:Uid="Record_109" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Center" Content="Retry" AutomationProperties.Name="Retry reading the record" Command="{Binding DataContext.Retry, ElementName=CaseFeed}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
