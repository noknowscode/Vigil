<!--
  Patient care (route Main/Record, data CaseRef), docs/design/patient-care-values.md. Header (back, breadcrumb, top
  bar cluster), hero tray (identity + record nav | photo | weight + status card + CTA), overdue banner, procedure
  header, metric cards (anesthesia record chart, latest medication, circulation, respiration). Every record action
  opens the side pane (SplitView) the page already had: preparation, vitals, history, labs, medications, dose,
  recovery and sign-off. FeedView states: Progress = skeleton of the tray and cards, None = record gone, Error =
  message + Retry (Store.Reload, bound by ElementName: the ErrorTemplate's DataContext is the exception).
  Breakpoints (ShellLayout): below 1080 the hero stacks (identity + photo, status column below) and the cards go 2 x 2;
  below 760 everything is one column.
-->
<Page x:Class="Vigil.Presentation.RecordPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" xmlns:mvux="using:Uno.Extensions.Reactive.UI" xmlns:utu="using:Uno.Toolkit.UI" xmlns:local="using:Vigil.Presentation" xmlns:controls="using:Vigil.Controls" xmlns:domain="using:Vigil.Domain" xmlns:media="using:Microsoft.UI.Xaml.Media" Background="Transparent">
  <Page.Resources>
    <!-- Breadcrumb link: 14/20 muted, no underline (the prototype overrides it to transparent); hover ink.
         xaml-lint: allow template - text-only link with an ink hover, no button chrome -->
    <Style x:Key="CrumbLink" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="Transparent">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Text.Foreground" Value="{ThemeResource InkBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Text.Foreground" Value="{ThemeResource InkBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Style="{StaticResource TypeBody}" Foreground="{TemplateBinding Foreground}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ChartLabel" TargetType="TextBlock" BasedOn="{StaticResource TypeMono}">
      <Setter Property="FontSize" Value="10" />
      <Setter Property="LineHeight" Value="12" />
      <Setter Property="Foreground" Value="{ThemeResource InkMutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="AxisY" TargetType="TextBlock" BasedOn="{StaticResource ChartLabel}">
      <Setter Property="Width" Value="26" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="AxisX" TargetType="TextBlock" BasedOn="{StaticResource ChartLabel}">
      <Setter Property="Width" Value="40" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style x:Key="Skeleton" TargetType="Rectangle">
      <Setter Property="RadiusX" Value="6" />
      <Setter Property="RadiusY" Value="6" />
      <Setter Property="Fill" Value="{ThemeResource SkeletonBrush}" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="NavLabel" TargetType="TextBlock" BasedOn="{StaticResource TypeBodyMedium}">
      <Setter Property="Margin" Value="12,0,0,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Page.Resources>

  <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,Auto,*">
    <!-- 1. Header: back, breadcrumb, top bar cluster (40 px). Outside the FeedView so it shows in every state. -->
    <Grid Padding="{utu:Responsive Narrowest='20,28,20,0', Normal='40,36,40,0', Layout={StaticResource ShellLayout}}" ColumnDefinitions="*,Auto" ColumnSpacing="24">
      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <Button x:Uid="Record_1" Style="{StaticResource ButtonIconSecondary}" Command="{Binding GoBack}" AutomationProperties.Name="Back">
          <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconArrowLeft}" Foreground="{ThemeResource InkBrush}" />
        </Button>
        <Button x:Uid="Record_2" Style="{StaticResource CrumbLink}" Content="Patients" Command="{Binding OpenPatients}" VerticalAlignment="Center" AutomationProperties.Name="Patients list" />
        <TextBlock Text="/" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkFaintBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" Style="{StaticResource TypeBodyStrong}" VerticalAlignment="Center" />
      </StackPanel>
      <controls:TopBarCluster Grid.Column="1" VerticalAlignment="Center" Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible, Layout={StaticResource ShellLayout}}" />
    </Grid>
    <muxc:InfoBar x:Uid="Record_3" Grid.Row="1" Severity="Error" Title="Not saved" Message="{Binding SaveError}" IsOpen="{Binding HasSaveError}" IsClosable="False" Margin="40,0">
      <muxc:InfoBar.ActionButton><Button x:Uid="Record_4" Content="Dismiss" Command="{Binding DismissError}" /></muxc:InfoBar.ActionButton>
    </muxc:InfoBar>
    <mvux:FeedView x:Name="CaseFeed" Grid.Row="2" Source="{Binding Case}" RefreshingState="None" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False">
      <mvux:FeedView.ValueTemplate><DataTemplate><Grid>
        <SplitView PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="640" IsPaneOpen="{Binding Parent.PaneOpen, Mode=TwoWay}" PaneBackground="{ThemeResource BackgroundBrush}" SizeChanged="OnWorkspaceSizeChanged" PaneOpening="OnPaneOpening" PaneOpened="OnPaneOpened" PaneClosed="OnPaneClosed" KeyDown="OnWorkspaceKeyDown">
          <SplitView.Content>
            <ScrollViewer HorizontalScrollMode="Disabled">
              <StackPanel Padding="{utu:Responsive Narrowest='20,20,20,40', Normal='40,20,40,40', Layout={StaticResource ShellLayout}}">

                <!-- 2. Hero tray: pad 8, radius 26, #F3F3F2, tri-tone, shadow xs; 236 | 1fr | 300, gap 8 -->
                <utu:ShadowContainer Background="{ThemeResource PageBrush}" CornerRadius="26">
                  <utu:ShadowContainer.Shadows>
                    <utu:ShadowCollection><utu:Shadow OffsetY="1" BlurRadius="2" Opacity="0.05" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
                  </utu:ShadowContainer.Shadows>
                  <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                  <Border CornerRadius="26" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" Padding="8">
                    <Grid ColumnDefinitions="236,*,300" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="{utu:Responsive Narrowest=8, Wide=0, Layout={StaticResource ShellLayout}}">

                      <!-- Identity column: pad T12 R8 B4 L12 -->
                      <Grid Padding="12,12,8,4" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto" Height="{utu:Responsive Narrowest=NaN, Normal=434, Layout={StaticResource ShellLayout}}"
                            Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1, Layout={StaticResource ShellLayout}}">
                        <Grid HorizontalAlignment="Left" Height="28">
                          <Border Style="{StaticResource ChipLiveSoft}" Visibility="{Binding Data.Care.IsSurgery}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Data.Care.Chip}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" VerticalAlignment="Center" /></StackPanel>
                          </Border>
                          <Border Style="{StaticResource ChipLiveSoft}" Background="{ThemeResource PhaseRecoverySoftBrush}" BorderBrush="{ThemeResource PhaseRecoverySoftBorderBrush}" Visibility="{Binding Data.Care.IsRecovery}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="{ThemeResource PhaseRecoverySolidBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Data.Care.Chip}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" /></StackPanel>
                          </Border>
                          <Border Style="{StaticResource ChipLiveSoft}" Background="{ThemeResource PhasePrepSoftBrush}" BorderBrush="{ThemeResource PhasePrepSoftBorderBrush}" Visibility="{Binding Data.Care.IsPrep}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="{ThemeResource PhasePrepSolidBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Data.Care.Chip}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource PhasePrepDeepBrush}" VerticalAlignment="Center" /></StackPanel>
                          </Border>
                          <Border Style="{StaticResource ChipLiveSoft}" Background="{ThemeResource ChipNeutralBrush}" BorderBrush="{ThemeResource EdgeBrush}" Visibility="{Binding Data.Care.IsNeutral}">
                            <StackPanel Orientation="Horizontal" Spacing="8"><Ellipse Width="6" Height="6" Fill="{ThemeResource PhaseWaitingSolidBrush}" VerticalAlignment="Center" /><TextBlock Text="{Binding Data.Care.Chip}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" /></StackPanel>
                          </Border>
                        </Grid>
                        <!-- Newsreader sits 4 px lower than the browser places it at 56/60: pulled up, the row keeps its 14 px gap. -->
                        <TextBlock Grid.Row="1" Margin="0,10,0,4" Text="{Binding Data.Name}" Style="{StaticResource TypeDisplayTitleL}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="2" Margin="0,4,0,0" Text="{Binding Data.Breed}" Style="{StaticResource TypeBodyL}" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="3" Text="{Binding Data.AgeOwner}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextTrimming="CharacterEllipsis" />
                        <!-- Record nav: the sidebar's nav item (h40, radius 12, icon 18 + 14/20 Medium); each opens its pane. -->
                        <controls:RecordNav Grid.Row="4" Margin="-4,20,0,0" />
                        <!-- Team chip: h32, pad 0 10, radius 10, surface, tri-tone; users 15 -->
                        <!-- xaml-lint: allow card - 32 px team chip (prototype chip: radius 10, tri-tone edge), not a card surface -->
                        <Border Grid.Row="6" Height="32" Padding="10,0" CornerRadius="10" Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" HorizontalAlignment="Left">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <ContentControl Style="{StaticResource LineIcon16}" Width="15" Height="15" Content="{StaticResource IconUsers}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Data.Team}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                          </StackPanel>
                        </Border>
                      </Grid>

                      <!-- Photo panel 520 x 434, radius 16: blurred fill of the same photo (Skia AcrylicBrush over a stretched copy), the
                           photo contained on top, inset-photo shadow, "Pet-parent view" floating bottom right. -->
                      <Grid Grid.Column="{utu:Responsive Narrowest=0, Normal=1, Layout={StaticResource ShellLayout}}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0, Layout={StaticResource ShellLayout}}"
                            Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=2, Wide=1, Layout={StaticResource ShellLayout}}" Height="{utu:Responsive Narrowest=280, Normal=434, Layout={StaticResource ShellLayout}}">
                        <Rectangle RadiusX="16" RadiusY="16" Fill="{ThemeResource MediaPlaceholderBrush}" />
                        <Grid Visibility="{Binding Data.HasPhoto}">
                          <Rectangle RadiusX="16" RadiusY="16" Opacity="0.9">
                            <Rectangle.Fill><ImageBrush ImageSource="{Binding Data.HeroPhoto}" Stretch="Fill" /></Rectangle.Fill>
                          </Rectangle>
                          <!-- xaml-lint: allow card - childless blur layer (Skia-native AcrylicBrush must have no children) -->
                          <Border CornerRadius="16">
                            <!-- xaml-lint: allow hex - AcrylicBrush tint and fallback colours (Color values; the tint opacity is 0, the fallback matches MediaPlaceholderBrush) -->
                            <Border.Background><AcrylicBrush AlwaysUseFallback="False" media:AcrylicBrushExtensions.UseCompositionEffectBrush="False" TintColor="#808080" TintOpacity="0" TintLuminosityOpacity="0" FallbackColor="#E9E9EB" /></Border.Background>
                          </Border>
                          <Rectangle RadiusX="16" RadiusY="16" AutomationProperties.Name="{Binding Data.PhotoName}">
                            <Rectangle.Fill><ImageBrush ImageSource="{Binding Data.HeroPhoto}" Stretch="Uniform" /></Rectangle.Fill>
                          </Rectangle>
                        </Grid>
                        <StackPanel Visibility="{Binding Data.HasNoPhoto}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
                          <ContentControl Style="{StaticResource LineIcon18}" Width="28" Height="28" Content="{StaticResource IconPawPrint}" HorizontalAlignment="Center" />
                          <TextBlock x:Uid="Record_83" Text="Patient photo not added" Style="{StaticResource TypeBodyS}" HorizontalAlignment="Center" />
                        </StackPanel>
                        <utu:ShadowContainer Background="Transparent" CornerRadius="16" IsHitTestVisible="False">
                          <utu:ShadowContainer.Shadows>
                            <utu:ShadowCollection><utu:Shadow IsInner="True" OffsetY="1" BlurRadius="3" Opacity="0.2" Color="Black" /></utu:ShadowCollection>
                          </utu:ShadowContainer.Shadows>
                          <Grid />
                        </utu:ShadowContainer>
                        <utu:ShadowContainer Background="{ThemeResource Surface1Brush}" CornerRadius="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                          <utu:ShadowContainer.Shadows>
                            <utu:ShadowCollection><utu:Shadow OffsetY="2" BlurRadius="8" Opacity="0.18" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
                          </utu:ShadowContainer.Shadows>
                          <Button x:Uid="Record_84" Style="{StaticResource ButtonSecondaryM}" Command="{Binding Parent.OpenParentPreview}" AutomationProperties.Name="Pet-parent view">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock x:Uid="Record_85" Text="Pet-parent view" Style="{StaticResource TypeButtonS}" VerticalAlignment="Center" />
                              <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconArrowUpRight}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                        </utu:ShadowContainer>
                      </Grid>

                      <!-- Status column 300: weight card, status card (flex 1), CTA 48 -->
                      <Grid Grid.Column="{utu:Responsive Narrowest=0, Wide=2, Layout={StaticResource ShellLayout}}" Grid.Row="{utu:Responsive Narrowest=2, Normal=1, Wide=0, Layout={StaticResource ShellLayout}}"
                            Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1, Layout={StaticResource ShellLayout}}" RowDefinitions="Auto,*,Auto" RowSpacing="8">
                        <!-- xaml-lint: allow card - weight tile inside the hero tray (tri-tone gradient edge, exact radius 14 / padding 16 15) -->
                        <Border Padding="16,15,16,16" CornerRadius="14" Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
                          <StackPanel>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                              <TextBlock x:Uid="Record_86" Text="Weight at this visit" Style="{StaticResource TypeBodyS}" FontWeight="Medium" VerticalAlignment="Center" />
                              <Border Grid.Column="1" Style="{StaticResource BadgeOutline}"><TextBlock Text="{Binding Data.Preop.AsaLabel}" Style="{StaticResource TypeCaptionStrong}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" /></Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                              <TextBlock Text="{Binding Data.WeightText}" Style="{StaticResource TypeMonoStatL}" />
                              <TextBlock x:Uid="Record_87" Text="kg" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,5" />
                            </StackPanel>
                            <TextBlock Text="{Binding Data.WeightDate}" Style="{StaticResource TypeBodyS}" />
                          </StackPanel>
                        </Border>
                        <controls:CareStatusCard Grid.Row="1" DataContext="{Binding Data}" MinHeight="{utu:Responsive Narrowest=200, Wide=0, Layout={StaticResource ShellLayout}}" />
                        <Button Grid.Row="2" Style="{StaticResource ButtonPrimaryXL}" Command="{Binding Parent.OpenPane}" CommandParameter="{Binding Data.Care.CtaPane}" IsEnabled="{Binding Data.CanChange}" AutomationProperties.Name="{Binding Data.Care.Cta}">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Data.Care.Cta}" Style="{StaticResource TypeTitleS}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                            <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconPlus}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" Visibility="{Binding Data.Care.IsSurgery}" />
                          </StackPanel>
                        </Button>
                      </Grid>
                    </Grid>
                  </Border>
                </utu:ShadowContainer>

                <!-- 3. Overdue banner (role alert): min-h 64, pad 10 12 10 14, radius 16, error soft -->
                <!-- xaml-lint: allow card - role=alert banner (error soft fill and border), not a card surface -->
                <Border Margin="0,16,0,0" MinHeight="64" Padding="14,10,12,10" CornerRadius="16" Background="{ThemeResource PhaseErrorSoftBrush}" BorderBrush="{ThemeResource PhaseErrorSoftBorderBrush}" BorderThickness="1"
                        Visibility="{Binding Data.IsOverdue}" AutomationProperties.LiveSetting="Assertive" AutomationProperties.Name="{Binding Data.OverdueTitle}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="{utu:Responsive Narrowest=8, Normal=0, Layout={StaticResource ShellLayout}}">
                    <Grid Width="36" Height="36" VerticalAlignment="Center">
                      <Rectangle RadiusX="10" RadiusY="10" Fill="{ThemeResource AlertTileBrush}" />
                      <ContentControl Style="{StaticResource LineIcon16Bold}" Width="18" Height="18" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorDeepBrush}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Data.OverdueTitle}" Style="{StaticResource TypeTitleS}" Foreground="{ThemeResource PhaseErrorDeepBrush}" />
                      <TextBlock Text="{Binding Data.OverdueDetail}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource AlertInkBrush}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                    <Button x:Uid="Record_88" Grid.Column="{utu:Responsive Narrowest=1, Normal=2, Layout={StaticResource ShellLayout}}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0, Layout={StaticResource ShellLayout}}"
                            Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Left" VerticalAlignment="Center" Content="Record observations" Command="{Binding Parent.OpenPane}" CommandParameter="Monitor" />
                  </Grid>
                </Border>
                <muxc:InfoBar x:Uid="Record_89" Margin="0,16,0,0" Severity="Warning" Title="Latest recorded observations need attention" Message="{Binding Data.Alert}" IsOpen="{Binding Data.HasAlert}" Visibility="{Binding Data.HasAlert}" IsClosable="False" />

                <!-- 4. Procedure header: h2 20/28 + meta; Pre-op (secondary-l), Administer dose (primary-l + syringe) -->
                <Grid Margin="0,32,0,0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="{utu:Responsive Narrowest=12, Normal=0, Layout={StaticResource ShellLayout}}">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource TypeH2Section}" TextWrapping="WrapWholeWords" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding Data.ProcedureMeta}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                  </StackPanel>
                  <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Normal=1, Layout={StaticResource ShellLayout}}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0, Layout={StaticResource ShellLayout}}" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <Button x:Uid="Record_90" Style="{StaticResource ButtonSecondaryL}" Content="Pre-op" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" AutomationProperties.Name="Pre-op preparation" />
                    <Button x:Uid="Record_91" Style="{StaticResource ButtonPrimaryL}" IsEnabled="{Binding Data.CanChange}" Command="{Binding Parent.OpenPane}" CommandParameter="Dose" AutomationProperties.Name="Administer dose">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Uid="Record_92" Text="Administer dose" Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                        <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconSyringe}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Grid>
                <!-- xaml-lint: allow card - transient acknowledgement chip -->
                <Border Margin="0,12,0,0" Background="{ThemeResource PhaseAnesthesiaSoftBrush}" Padding="12,8" CornerRadius="12" HorizontalAlignment="Left" Visibility="{Binding Parent.ShowAcknowledgement}">
                  <StackPanel Orientation="Horizontal" Spacing="8"><controls:CareMark Width="18" Height="20" Acknowledge="{Binding Parent.ShowAcknowledgement}" ReduceMotion="{Binding Parent.ReduceMotion}" /><TextBlock x:Uid="Record_93" Text="Dose recorded · visual acknowledgement only" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" /></StackPanel>
                </Border>

                <!-- 5. Metric cards: 2.1fr | 1.2fr | 1fr | 1fr, gap 16 (five star columns so 2 x 2 below 1080 splits evenly) -->
                <Grid Margin="0,16,0,0" ColumnDefinitions="40.24*,9.76*,11.67*,19.16*,19.16*" RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="{utu:Responsive Narrowest=0, Normal=16, Layout={StaticResource ShellLayout}}" RowSpacing="16">

                  <!-- Card A: Anesthesia record -->
                  <utu:ShadowContainer Background="{ThemeResource Surface1Brush}" CornerRadius="18"
                                       Grid.ColumnSpan="{utu:Responsive Narrowest=5, Normal=2, Wide=1, Layout={StaticResource ShellLayout}}">
                    <utu:ShadowContainer.Shadows>
                      <utu:ShadowCollection><utu:Shadow OffsetY="1" BlurRadius="2" Opacity="0.05" Color="{StaticResource ShadowInkColor}" /></utu:ShadowCollection>
                    </utu:ShadowContainer.Shadows>
                    <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact shadow xs) -->
                    <Border CornerRadius="18" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" Padding="19,17">
                      <StackPanel>
                        <TextBlock x:Uid="Record_94" Text="Anesthesia record" Style="{StaticResource TypeH3Card}" />
                        <TextBlock x:Uid="Record_95" Text="Observed values · 5-minute strip" Style="{StaticResource TypeBodyS}" />
                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal" Spacing="14">
                          <StackPanel Orientation="Horizontal" Spacing="6"><Rectangle Width="12" Height="2" RadiusX="1" RadiusY="1" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="Record_96" Text="HR bpm" Style="{StaticResource TypeCaption}" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6"><Rectangle Width="4" Height="12" RadiusX="2" RadiusY="2" Fill="{ThemeResource PhaseRecoverySolidBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="Record_97" Text="BP mmHg" Style="{StaticResource TypeCaption}" /></StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{Binding Data.Chart.HasDue}"><Rectangle Width="8" Height="12" RadiusX="3" RadiusY="3" Fill="{ThemeResource PhaseErrorSoftBrush}" Stroke="{ThemeResource PhaseErrorSolidBrush}" StrokeThickness="1" StrokeDashArray="2,1" VerticalAlignment="Center" /><TextBlock Text="{Binding Data.Chart.DueLabel}" Style="{StaticResource TypeCaption}" /></StackPanel>
                        </StackPanel>
                        <!-- The chart: viewBox 400 x 188, scaled uniformly to the card (patient-care-values.md §3.4). -->
                        <Viewbox Margin="0,12,0,0" Stretch="Uniform" AutomationProperties.Name="{Binding Data.Chart.AccessibleName}">
                          <Grid Width="400" Height="188">
                            <Path Data="{Binding Data.Chart.DueBand}" Fill="{ThemeResource PhaseErrorSoftBrush}" />
                            <Path Data="{Binding Data.Chart.DueLine}" Stroke="{ThemeResource PhaseErrorSolidBrush}" StrokeThickness="1.5" StrokeDashArray="2,2" />
                            <!-- xaml-lint: allow icon - chart gridlines in the 400 x 188 viewBox, not an icon -->
                            <Path Data="M34,12H378M34,38H378M34,64.5H378" Stroke="{ThemeResource DividerBrush}" StrokeThickness="1" />
                            <TextBlock Margin="0,6,0,0" Text="{Binding Data.Chart.Hr0}" Style="{StaticResource AxisY}" />
                            <TextBlock Margin="0,32,0,0" Text="{Binding Data.Chart.Hr1}" Style="{StaticResource AxisY}" />
                            <TextBlock Margin="0,58,0,0" Text="{Binding Data.Chart.Hr2}" Style="{StaticResource AxisY}" />
                            <Path Data="{Binding Data.Chart.HrLine}" Stroke="{ThemeResource PhaseAnesthesiaSolidBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="{Binding Data.Chart.HrPoints}" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Stroke="{ThemeResource Surface1Brush}" StrokeThickness="2" />
                            <Path Data="{Binding Data.Chart.HrLast}" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Stroke="{ThemeResource Surface1Brush}" StrokeThickness="2" />
                            <!-- xaml-lint: allow icon - chart gridlines in the 400 x 188 viewBox, not an icon -->
                            <Path Data="M34,96.5H378M34,128H378M34,160H378" Stroke="{ThemeResource DividerBrush}" StrokeThickness="1" />
                            <TextBlock Margin="0,90,0,0" Text="{Binding Data.Chart.Bp0}" Style="{StaticResource AxisY}" />
                            <TextBlock Margin="0,122,0,0" Text="{Binding Data.Chart.Bp1}" Style="{StaticResource AxisY}" />
                            <TextBlock Margin="0,154,0,0" Text="{Binding Data.Chart.Bp2}" Style="{StaticResource AxisY}" />
                            <Path Data="{Binding Data.Chart.BpBars}" Stroke="{ThemeResource PhaseRecoverySolidBrush}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <TextBlock Margin="14,174,0,0" Text="{Binding Data.Chart.X0}" Style="{StaticResource AxisX}" />
                            <TextBlock Margin="82.8,174,0,0" Text="{Binding Data.Chart.X1}" Style="{StaticResource AxisX}" />
                            <TextBlock Margin="151.6,174,0,0" Text="{Binding Data.Chart.X2}" Style="{StaticResource AxisX}" />
                            <TextBlock Margin="220.4,174,0,0" Text="{Binding Data.Chart.X3}" Style="{StaticResource AxisX}" />
                            <TextBlock Margin="289.2,174,0,0" Text="{Binding Data.Chart.X4}" Style="{StaticResource AxisX}" />
