<Page x:Class="Vigil.Presentation.RecordPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" xmlns:mvux="using:Uno.Extensions.Reactive.UI" xmlns:uen="using:Uno.Extensions.Navigation.UI" xmlns:utu="using:Uno.Toolkit.UI" xmlns:local="using:Vigil.Presentation" xmlns:controls="using:Vigil.Controls" xmlns:domain="using:Vigil.Domain" Background="{ThemeResource BackgroundBrush}">
  <Grid utu:SafeArea.Insets="VisibleBounds" RowDefinitions="Auto,Auto,*">
    <Grid Padding="{utu:Responsive Narrow='16,12', Wide='32,16'}" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <Button x:Uid="Record_1" Style="{StaticResource CloverQuiet}" uen:Navigation.Request="-" AutomationProperties.Name="Back to today's patients"><FontIcon Glyph="&#xE72B;" FontSize="18" /></Button>
        <controls:CareMark Width="25" Height="29" /><TextBlock x:Uid="Record_2" Text="clover" Style="{StaticResource CloverHeading}" />
      </StackPanel>
      <utu:ChipGroup x:Name="RecordTabs" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource FilterChipGroupStyle}" SelectionMode="Single">
        <utu:Chip x:Uid="Record_159" Content="Today’s patients" uen:Navigation.Request="-" AutomationProperties.Name="Back to today’s patients" />
        <utu:Chip x:Uid="Record_3" x:Name="CareTab" Content="Patient care" IsChecked="True" AutomationProperties.Name="Patient care workspace" />
      </utu:ChipGroup>
      <TextBlock x:Uid="Record_5" Grid.Column="2" Text="CARE, CONTINUED." Style="{StaticResource CloverLabel}" VerticalAlignment="Center" Visibility="{utu:Responsive Narrowest=Collapsed, Wide=Visible}" />
    </Grid>
    <muxc:InfoBar x:Uid="Record_6" Grid.Row="1" Severity="Error" Title="Not saved" Message="{Binding SaveError}" IsOpen="{Binding HasSaveError}" IsClosable="False" Margin="16,0">
      <muxc:InfoBar.ActionButton><Button x:Uid="Record_7" Content="Dismiss" Command="{Binding DismissError}" /></muxc:InfoBar.ActionButton>
    </muxc:InfoBar>
    <mvux:FeedView x:Name="CaseFeed" Grid.Row="2" Source="{Binding Case}" RefreshingState="None" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Stretch" IsTabStop="False">
      <mvux:FeedView.ValueTemplate><DataTemplate><Grid>
        <SplitView PanePlacement="Right" DisplayMode="Overlay" OpenPaneLength="640" IsPaneOpen="{Binding Parent.PaneOpen, Mode=TwoWay}" PaneBackground="{ThemeResource BackgroundBrush}" SizeChanged="OnWorkspaceSizeChanged" PaneOpening="OnPaneOpening" PaneOpened="OnPaneOpened" PaneClosed="OnPaneClosed" KeyDown="OnWorkspaceKeyDown">
          <SplitView.Content>
            <ScrollViewer HorizontalScrollMode="Disabled">
              <StackPanel MaxWidth="1920" Padding="{utu:Responsive Narrow='12,12,12,28', Wide='24,20,24,32'}" Spacing="16">
                <Border CornerRadius="24" Background="{ThemeResource CloverSky}">
                  <Grid MinHeight="{utu:Responsive Narrowest=780, Normal=520, Wide=520}">
                    <controls:PetBackdrop Photo="{Binding Data.HeroPhoto}" Hero="True" Pulse="{Binding Parent.DosePulse}" ReduceMotion="{Binding Parent.ReduceMotion}" />
                    <Grid Padding="24" ColumnDefinitions="*,Auto" RowDefinitions="Auto,*,Auto" RowSpacing="12">
                      <StackPanel Spacing="8" MaxWidth="340" HorizontalAlignment="Left">
                        <Border Background="#EDF4EBCD" CornerRadius="15" Padding="12,6" HorizontalAlignment="Left"><TextBlock Text="{Binding Data.StatusText}" Foreground="#244936" FontFamily="{StaticResource CloverFont}" FontSize="13" /></Border>
                        <TextBlock Text="{Binding Data.Name}" Style="{StaticResource CloverDisplay}" FontSize="{utu:Responsive Narrowest=50, Wide=56}" Foreground="#203B2B" />
                        <TextBlock Text="{Binding Data.Breed}" Style="{StaticResource CloverTitle}" Foreground="#203B2B" FontWeight="Normal" />
                        <TextBlock Text="{Binding Data.AgeOwner}" Style="{StaticResource CloverBody}" Foreground="#41604A" />
                        <TextBlock x:Uid="Record_8" Text="Patient photo not added" Style="{StaticResource CloverBody}" Foreground="#41604A" Visibility="{Binding Data.HasNoPhoto}" />
                      </StackPanel>
                      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="2" Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}">
                        <Button x:Uid="Record_4" Content="Preparation" Style="{StaticResource CloverSidebar}" Foreground="#244936" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" />
                        <Button x:Uid="Record_37" Content="Vitals" Style="{StaticResource CloverSidebar}" Foreground="#244936" Command="{Binding Parent.OpenPane}" CommandParameter="Monitor" />
                        <Button x:Uid="Record_38" Content="Medical history" Style="{StaticResource CloverSidebar}" Foreground="#244936" Command="{Binding Parent.OpenPane}" CommandParameter="History" />
                        <Button x:Uid="Record_84" Content="Lab results" Style="{StaticResource CloverSidebar}" Foreground="#244936" Command="{Binding Parent.OpenPane}" CommandParameter="Labs" />
                        <Button x:Uid="Record_85" Content="Medications" Style="{StaticResource CloverSidebar}" Foreground="#244936" Command="{Binding Parent.OpenPane}" CommandParameter="Drugs" />
                      </StackPanel>
                      <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.RowSpan="{utu:Responsive Narrowest=1, Normal=3}" Width="{utu:Responsive Narrowest=260, Normal=258, Wide=280}" HorizontalAlignment="Right" VerticalAlignment="{utu:Responsive Narrowest=Bottom, Normal=Top}" Spacing="12">
                        <Border Style="{StaticResource CloverCard}" Background="{ThemeResource CloverGlass}" BorderThickness="0" Padding="22">
                          <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="4"><TextBlock x:Uid="Record_9" Text="WEIGHT AT THIS VISIT" Style="{StaticResource CloverIdLabel}" /><TextBlock Style="{StaticResource CloverHeading}"><Run Text="{Binding Data.WeightText}" /><Run x:Uid="Record_86" Text=" kg" FontSize="13" /></TextBlock></StackPanel><Border Grid.Column="1" Background="{ThemeResource CloverSage}" CornerRadius="10" Padding="8,4" VerticalAlignment="Top"><TextBlock Text="{Binding Data.Preop.AsaLabel}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" /></Border></Grid>
                            <TextBlock Text="{Binding Data.WeightDate}" Style="{StaticResource CloverBody}" FontSize="13" />
                            <Border Height="1" Background="{ThemeResource OutlineBrush}" />
                            <StackPanel Spacing="8" Visibility="{Binding Data.IsScheduled}">
                              <TextBlock x:Uid="Record_87" Text="BEFORE ANAESTHESIA" Style="{StaticResource CloverLabel}" />
                              <TextBlock Text="{Binding Data.PreopProgress}" Style="{StaticResource CloverTitle}" />
                              <ProgressBar Value="{Binding Data.Preop.DoneCount}" Maximum="5" Height="4" Foreground="{ThemeResource PrimaryBrush}" />
                              <Button x:Uid="Record_88" Content="Review preparation" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{Binding Data.IsAnesthetized}">
                              <TextBlock x:Uid="Record_92" Text="ANAESTHESIA TIME" Style="{StaticResource CloverLabel}" />
                              <TextBlock Text="{Binding Data.Elapsed}" Style="{StaticResource CodeTextStyle}" FontSize="40" Foreground="{ThemeResource OnSurfaceBrush}" />
                              <TextBlock Text="{Binding Data.InducedText}" Style="{StaticResource CloverBody}" FontSize="13" />
                              <TextBlock Text="{Binding Data.ClockText}" Style="{StaticResource CloverTitle}" FontSize="16" />
                              <TextBlock x:Uid="Record_93" Text="Reading overdue · record observations" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" />
                              <Button x:Uid="Record_94" Content="Record observations  ＋" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="Monitor" />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{Binding Data.IsRecovery}">
                              <TextBlock x:Uid="Record_89" Text="RECOVERY" Style="{StaticResource CloverLabel}" />
                              <TextBlock Text="{Binding Data.RecoveryAnchor}" Style="{StaticResource CodeTextStyle}" FontSize="40" Foreground="{ThemeResource OnSurfaceBrush}" />
                              <TextBlock Text="{Binding Data.RecoveryAnchorLabel}" Style="{StaticResource CloverBody}" FontSize="13" />
                              <TextBlock Text="{Binding Data.ExtubatedText}" Style="{StaticResource CloverBody}" FontSize="13" />
                              <Button x:Uid="Record_90" Content="Update recovery" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="Recovery" />
                            </StackPanel>
                            <StackPanel Spacing="8" Visibility="{Binding Data.IsSigned}">
                              <TextBlock x:Uid="Record_91" Text="RECORD COMPLETE" Style="{StaticResource CloverLabel}" />
                              <TextBlock Text="{Binding Data.SignedText}" Style="{StaticResource CloverBody}" FontSize="13" />
                              <Button x:Uid="Record_100" Content="Review record" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="History" />
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                      <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                        <StackPanel VerticalAlignment="Bottom" Spacing="6" MaxWidth="480" HorizontalAlignment="Left">
                          <Border Background="#EFFFFEF9" CornerRadius="12" Padding="12,8"><TextBlock Text="{Binding Data.Team}" Style="{StaticResource CloverBody}" Foreground="#244936" FontSize="13" /></Border>
                          <Border Background="{ThemeResource CloverLime}" Padding="12,8" CornerRadius="12" Visibility="{Binding Parent.ShowAcknowledgement}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:CareMark Width="18" Height="20" Acknowledge="{Binding Parent.ShowAcknowledgement}" ReduceMotion="{Binding Parent.ReduceMotion}" /><TextBlock x:Uid="Record_95" Text="Dose recorded · visual acknowledgement only" Style="{StaticResource CloverBody}" FontSize="13" AutomationProperties.LiveSetting="Polite" /></StackPanel></Border>
                        </StackPanel>
                        <Button x:Uid="Record_96" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" HorizontalAlignment="Right" Content="Pet-parent view  ↗" Style="{StaticResource CloverSecondary}" Background="{ThemeResource CloverGlass}" Command="{Binding Parent.OpenParentPreview}" />
                      </Grid>
                    </Grid>
                  </Grid>
                </Border>
                <Border Visibility="{Binding Data.IsOverdue}" Background="{ThemeResource ErrorContainerBrush}" BorderBrush="{ThemeResource ErrorBrush}" BorderThickness="1" CornerRadius="16" Padding="16,10">
                  <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="8">
                    <StackPanel Spacing="2" VerticalAlignment="Center"><TextBlock x:Uid="Record_138" Text="Reading overdue" Style="{StaticResource CloverTitle}" FontSize="14" Foreground="{ThemeResource OnErrorContainerBrush}" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{Binding Data.LastRecorded}" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource OnErrorContainerBrush}" /></StackPanel>
                    <Button x:Uid="Record_139" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Content="Record observations" Style="{StaticResource CloverSecondary}" Command="{Binding Parent.OpenPane}" CommandParameter="Monitor" />
                  </Grid>
                </Border>
                <muxc:InfoBar x:Uid="Record_97" Severity="Warning" Title="Latest recorded observations need attention" Message="{Binding Data.Alert}" IsOpen="{Binding Data.HasAlert}" IsClosable="False" />
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="8" ColumnSpacing="12" Margin="4,2">
                  <StackPanel Spacing="4"><TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource CloverTitle}" /><TextBlock Text="{Binding Data.LastRecorded}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
                  <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                    <Button x:Uid="Record_98" Content="Pre-op" Style="{StaticResource CloverSecondary}" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" />
                    <Button x:Uid="Record_99" Content="Administer dose" Style="{StaticResource CloverPrimary}" IsEnabled="{Binding Data.CanChange}" Command="{Binding Parent.OpenPane}" CommandParameter="Dose" />
                  </StackPanel>
                </Grid>
                <Grid Visibility="{Binding Data.IsScheduled}" ColumnDefinitions="1.5*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                  <Border Style="{StaticResource CloverCard}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}">
                    <StackPanel Spacing="14"><TextBlock x:Uid="Record_101" Text="Preoperative preparation" Style="{StaticResource CloverHeading}" /><TextBlock Text="{Binding Data.PreopProgress}" Style="{StaticResource CloverBody}" /><ProgressBar Value="{Binding Data.Preop.DoneCount}" Maximum="5" Foreground="{ThemeResource PrimaryBrush}" /><TextBlock x:Uid="Record_102" Text="Review fasting, IV access, equipment, consent and bloodwork before induction." Style="{StaticResource CloverBody}" /><Button x:Uid="Record_103" Content="Open preparation checklist" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Left" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" /></StackPanel>
                  </Border>
                  <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" Spacing="12">
                    <Button Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="Drugs"><StackPanel Padding="20" Spacing="8"><TextBlock x:Uid="Record_104" Text="MEDICATIONS THIS VISIT  ↗" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.MedicationSummary}" Style="{StaticResource CloverTitle}" /><TextBlock Text="{Binding Data.MedicationDetail}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel></Button>
                    <Button Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="History"><StackPanel Padding="20" Spacing="8"><TextBlock x:Uid="Record_105" Text="VISIT DETAILS  ↗" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource CloverTitle}" /><TextBlock Text="{Binding Data.VisitDate}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel></Button>
                  </StackPanel>
                </Grid>
                <Grid Visibility="{Binding Data.HasAnaesthesiaRecord}" ColumnDefinitions="2.1*,1.2*,1*,1*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                  <Border Style="{StaticResource CloverCard}" Grid.ColumnSpan="{utu:Responsive Narrowest=4, Normal=4, Widest=1}" Padding="20">
                    <StackPanel Spacing="6"><TextBlock x:Uid="Record_117" Text="Anaesthesia record" Style="{StaticResource CloverTitle}" /><TextBlock x:Uid="Record_118" Text="Observed values · five-minute strip" Style="{StaticResource CloverBody}" FontSize="13" /><controls:VitalsStrip Data="{Binding Data.Strip}" ReduceMotion="{Binding Parent.ReduceMotion}" Height="240" AutomationProperties.Name="{Binding Data.StripSummary}" /></StackPanel>
                  </Border>
                  <StackPanel Grid.Row="{utu:Responsive Narrowest=1, Normal=1, Widest=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0, Widest=1}" Grid.ColumnSpan="{utu:Responsive Narrowest=4, Normal=2, Widest=1}" Spacing="12">
                    <Button Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" Command="{Binding Parent.OpenPane}" CommandParameter="Drugs"><StackPanel Padding="20" Spacing="8"><TextBlock x:Uid="Record_119" Text="LATEST MEDICATION  ↗" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.MedicationSummary}" Style="{StaticResource CloverTitle}" FontSize="17" /><TextBlock Text="{Binding Data.MedicationDetail}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel></Button>
                    <Button Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" Background="{ThemeResource CloverLime}" Command="{Binding Parent.OpenPane}" CommandParameter="Recovery"><StackPanel Padding="20" Spacing="8"><TextBlock x:Uid="Record_120" Text="THE NEXT CHAPTER  ↗" Style="{StaticResource CloverLabel}" /><TextBlock x:Uid="Record_121" Text="Recovery &amp; handover" Style="{StaticResource CloverTitle}" FontSize="17" /><TextBlock x:Uid="Record_122" Text="Record milestones, then sign off." Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel></Button>
                  </StackPanel>
                  <Border Style="{StaticResource CloverCard}" Grid.Row="{utu:Responsive Narrowest=2, Normal=1, Widest=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=2, Widest=2}" Grid.ColumnSpan="{utu:Responsive Narrowest=4, Normal=1, Widest=1}">
                    <StackPanel Spacing="12"><TextBlock x:Uid="Record_123" Text="Circulation" Style="{StaticResource CloverTitle}" /><TextBlock x:Uid="Record_124" Text="HEART RATE · bpm" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.LastHr}" Style="{StaticResource CloverMetric}" /><Border BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel Spacing="8"><TextBlock x:Uid="Record_125" Text="BLOOD PRESSURE" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.LastBp}" Style="{StaticResource CloverHeading}" /><TextBlock x:Uid="Record_126" Text="mmHg · SYS / DIA" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel></Border><TextBlock Text="{Binding Data.LastRecorded}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
                  </Border>
                  <Border Style="{StaticResource CloverCard}" Grid.Row="{utu:Responsive Narrowest=3, Normal=1, Widest=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=3, Widest=3}" Grid.ColumnSpan="{utu:Responsive Narrowest=4, Normal=1, Widest=1}" Background="{ThemeResource CloverSky}">
                    <StackPanel Spacing="12"><TextBlock x:Uid="Record_127" Text="Respiration" Style="{StaticResource CloverTitle}" /><TextBlock x:Uid="Record_128" Text="OXYGEN SATURATION" Style="{StaticResource CloverLabel}" /><TextBlock Style="{StaticResource CloverMetric}"><Run Text="{Binding Data.LastSpo2}" /><Run Text=" %" FontSize="15" /></TextBlock><Border BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0"><StackPanel Spacing="8"><TextBlock x:Uid="Record_129" Text="END-TIDAL CO₂" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.LastEtCo2}" Style="{StaticResource CloverHeading}" /><TextBlock x:Uid="Record_130" Text="mmHg" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel></Border><TextBlock Text="{Binding Data.LastRecorded}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
                  </Border>
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" Margin="0,8"><controls:CareMark Width="15" Height="17" /><TextBlock x:Uid="Record_131" Text="Care, continued." Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
              </StackPanel>
            </ScrollViewer>
          </SplitView.Content>
<SplitView.Pane><Grid RowDefinitions="Auto,*" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1,0,0,0">
  <Grid ColumnDefinitions="*,Auto" Padding="24,16" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,1"><TextBlock Text="{Binding Parent.PaneTitle}" Style="{StaticResource CloverTitle}" VerticalAlignment="Center" /><Button x:Name="DrawerClose" x:Uid="Record_132" Grid.Column="1" Content="✕" Style="{StaticResource CloverQuiet}" Command="{Binding Parent.ClosePane}" AutomationProperties.Name="Close panel" /></Grid>
  <Grid Grid.Row="1"><Grid Visibility="{Binding Parent.PaneDose}"><Grid DataContext="{Binding Parent}"><Grid Padding="{utu:Responsive Narrow='16,8,16,16', Wide='24,8,24,24'}" ColumnSpacing="24" RowSpacing="16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- Drug list -->
      <Grid Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Uid="Record_140" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="DRUG · sample formulary, not for clinical use" TextWrapping="Wrap" />
        <ListView x:Uid="Record_141" Grid.Row="1"
                  ItemsSource="{Binding DoseDrugs}"
                  SelectionMode="Single"
                  AutomationProperties.Name="Drugs">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="domain:Drug">
              <Grid Padding="4,10" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                  <TextBlock Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{x:Bind Name}" />
                  <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind DrugClass}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center">
                  <Run Text="{x:Bind MgPerMl}" /><Run x:Uid="Record_142" Text=" mg/mL" />
                </TextBlock>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>

      <!-- Calculation: the computed volume is the sheet's anchor. -->
      <ScrollViewer Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"
                    Grid.Column="{utu:Responsive Narrowest=0, Normal=1}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}">
        <StackPanel Spacing="16">
          <TextBox x:Uid="Record_143" Header="Dose (mg/kg)"
                   InputScope="Number"
                   Text="{Binding DoseMgPerKg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Dose in milligrams per kilogram" />

          <mvux:FeedView Source="{Binding DoseCalculation}" IsTabStop="False" RefreshingState="None">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <StackPanel Spacing="6">
                  <TextBlock x:Uid="Record_144" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="DRAW UP" />
                  <TextBlock x:Uid="Record_145" Style="{StaticResource DisplayLarge}"
                             Foreground="{ThemeResource OnSurfaceBrush}"
                             Text="{Binding Data.VolumeText}"
                             AutomationProperties.Name="Volume to draw up" />
                  <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="Wrap">
                    <Run Text="{Binding Data.Formula}" />
                  </TextBlock>
                  <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}">
                    <Run x:Uid="Record_146" Text="Reference range" />
                    <Run Text="{Binding Data.ReferenceText}" />
                  </TextBlock>
                  <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{Binding Data.IsOutOfRange}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="18" Foreground="{ThemeResource ErrorBrush}" />
                    <TextBlock x:Uid="Record_147" Style="{StaticResource TitleSmall}" Foreground="{ThemeResource ErrorBrush}" Text="Outside the reference range: you will be asked to confirm." TextWrapping="WrapWholeWords" />
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <StackPanel Spacing="6">
                  <TextBlock x:Uid="Record_148" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="DRAW UP" />
                  <TextBlock x:Uid="Record_149" Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="Pick a drug" />
                  <TextBlock x:Uid="Record_150" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                             Text="The volume appears here with its formula once a drug and a dose in mg/kg are set." />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
          </mvux:FeedView>

          <muxc:RadioButtons x:Uid="Record_151" Header="Route" MaxColumns="4" SelectedIndex="{Binding DoseRouteIndex, Mode=TwoWay}">
            <RadioButton x:Uid="Record_152" Content="IV" />
            <RadioButton x:Uid="Record_153" Content="IM" />
            <RadioButton x:Uid="Record_154" Content="SC" />
            <RadioButton x:Uid="Record_155" Content="PO" />
          </muxc:RadioButtons>
          <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource ErrorBrush}" TextWrapping="WrapWholeWords" Text="{Binding DoseError}" />
        </StackPanel>
      </ScrollViewer>

      <Grid Grid.Row="2" Grid.ColumnSpan="2">
        <Button x:Uid="Record_156" Style="{StaticResource CloverPrimary}"
                HorizontalAlignment="Stretch"
                Content="Give dose"
                Visibility="{Binding DoseNotConfirming}"
                Command="{Binding GiveDose}"
                AutomationProperties.Name="Give dose" />
        <!-- Out-of-range confirmation, inline: the safe choice is the filled one. -->
        <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}"
                                HorizontalAlignment="Stretch"
                                Visibility="{Binding DoseConfirming}"
                                IsTabStop="False">
          <StackPanel Padding="16" Spacing="12">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <FontIcon Glyph="&#xE7BA;" FontSize="20" Foreground="{ThemeResource ErrorBrush}" />
              <TextBlock Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding DoseConfirmTitle}" />
            </StackPanel>
            <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="{Binding DoseConfirmText}"
                       AutomationProperties.LiveSetting="Assertive" />
            <Grid ColumnSpacing="12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button x:Uid="Record_157" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Stretch" Content="Change dose" Command="{Binding ChangeRecordedDose}" />
              <Button x:Uid="Record_158" Grid.Column="1" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Stretch" Content="Give anyway"
                      Command="{Binding GiveDoseAnyway}" AutomationProperties.Name="Give the out-of-range dose anyway" />
            </Grid>
          </StackPanel>
        </utu:CardContentControl>
      </Grid>
