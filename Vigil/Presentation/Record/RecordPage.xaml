                        <controls:VitalStepper x:Uid="Record_50" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="Rr" Label="RR" Unit="/min" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}" SpokenName="respiratory rate, breaths per minute" Text="{Binding Parent.Draft.Rr, Mode=TwoWay}" Flag="{Binding Parent.Flags.Rr}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_51" Grid.Row="{utu:Responsive Narrowest=2, Normal=1}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="SpO2" Label="SpO₂" Unit="%" Glyph="○" GlyphBrush="{ThemeResource VitalSpO2Brush}" SpokenName="oxygen saturation, percent" Text="{Binding Parent.Draft.SpO2, Mode=TwoWay}" Flag="{Binding Parent.Flags.SpO2}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_52" Grid.Row="{utu:Responsive Narrowest=3, Normal=1}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="EtCo2" Label="EtCO₂" Unit="mmHg" Glyph="×" GlyphBrush="{ThemeResource VitalEtCo2Brush}" SpokenName="end-tidal CO2, millimetres of mercury" Text="{Binding Parent.Draft.EtCo2, Mode=TwoWay}" Flag="{Binding Parent.Flags.EtCo2}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_53" Grid.Row="{utu:Responsive Narrowest=4, Normal=2}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Sys" Label="SYS" Unit="mmHg" Glyph="∨" GlyphBrush="{ThemeResource VitalBpBrush}" SpokenName="systolic pressure" Text="{Binding Parent.Draft.Sys, Mode=TwoWay}" Flag="{Binding Parent.Flags.Sys}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_54" Grid.Row="{utu:Responsive Narrowest=5, Normal=2}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="Dia" Label="DIA" Unit="mmHg" Glyph="∧" GlyphBrush="{ThemeResource VitalBpBrush}" SpokenName="diastolic pressure" Text="{Binding Parent.Draft.Dia, Mode=TwoWay}" Flag="{Binding Parent.Flags.Dia}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_55" Grid.Row="{utu:Responsive Narrowest=6, Normal=3}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Map" Label="MAP" Unit="mmHg" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}" SpokenName="mean arterial pressure" Text="{Binding Parent.Draft.Map, Mode=TwoWay}" Flag="{Binding Parent.Flags.Map}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_56" Grid.Row="{utu:Responsive Narrowest=7, Normal=3}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="TempC" Label="Temp" Unit="°C" Glyph="■" GlyphBrush="{ThemeResource VitalTempBrush}" SpokenName="temperature, degrees Celsius" Text="{Binding Parent.Draft.TempC, Mode=TwoWay}" Flag="{Binding Parent.Flags.TempC}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_57" Grid.Row="{utu:Responsive Narrowest=8, Normal=4}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Field="Vaporizer" Label="Sevo" Unit="%" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}" SpokenName="vaporizer setting, percent" Text="{Binding Parent.Draft.Vaporizer, Mode=TwoWay}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                        <controls:VitalStepper x:Uid="Record_58" Grid.Row="{utu:Responsive Narrowest=9, Normal=4}" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Field="O2" Label="O₂" Unit="L/min" Glyph="" GlyphBrush="{ThemeResource OnSurfaceVariantBrush}" SpokenName="oxygen flow, litres per minute" Text="{Binding Parent.Draft.O2, Mode=TwoWay}" Command="{Binding Parent.Step}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" />
                    </Grid>
                    <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords">
                      <Run x:Uid="Record_59" Text="MAP left blank is derived as (SYS + 2·DIA) / 3:" />
                      <Run Text="{Binding Parent.Flags.MapHint}" />
                    </TextBlock>
                    <muxc:RadioButtons x:Uid="Record_60" Header="Anesthetic plane" MaxColumns="3" SelectedIndex="{Binding Parent.Draft.PlaneIndex, Mode=TwoWay}">
                      <RadioButton x:Uid="Record_61" Content="Light" />
                      <RadioButton x:Uid="Record_62" Content="Surgical" />
                      <RadioButton x:Uid="Record_63" Content="Deep" />
                    </muxc:RadioButtons>
                    <TextBox x:Uid="Record_64" Header="Note (optional)" Text="{Binding Parent.Draft.Note, Mode=TwoWay}" AutomationProperties.Name="Note for this reading" />
                  </StackPanel>
                </Grid>
              </ScrollViewer>


              <ScrollViewer Visibility="{Binding Parent.PaneRecovery}">
                <StackPanel Padding="20,16,20,28" Spacing="24" MaxWidth="960" HorizontalAlignment="Stretch">


                  <StackPanel Spacing="8" Visibility="{Binding Data.IsAnesthetized}">
                    <TextBlock x:Uid="Record_65" Style="{StaticResource HeadlineMedium}" Foreground="{ThemeResource OnBackgroundBrush}" Text="Patient is under anesthesia" />
                    <TextBlock x:Uid="Record_66" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" Text="End anesthesia when the vaporizer is off. The reading clock stops and recovery starts." />
                    <Button x:Uid="Record_67" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Left" MinWidth="220" Content="End anesthesia" Command="{Binding Parent.EndAnesthesia}" AutomationProperties.Name="End anesthesia" />
                  </StackPanel>

                  <StackPanel Spacing="4" Visibility="{Binding Data.IsNotAnesthetized}">
                    <TextBlock x:Uid="Record_68" Style="{StaticResource LabelLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="RECOVERY" />
                    <TextBlock x:Uid="Record_69" Style="{StaticResource DisplayLarge}" Foreground="{ThemeResource OnBackgroundBrush}" Text="{Binding Data.RecoveryAnchor}" AutomationProperties.Name="Time in recovery" />
                    <TextBlock Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Data.RecoveryAnchorLabel}" />
                  </StackPanel>

                  <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False" Visibility="{Binding Data.IsNotAnesthetized}">
                    <StackPanel Padding="20" Spacing="12">
                      <TextBlock x:Uid="Record_70" Style="{StaticResource TitleLarge}" Foreground="{ThemeResource OnSurfaceBrush}" Text="Recovery log" />
                      <Grid ColumnSpacing="12" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6">
                          <Button x:Uid="Record_71" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Stretch" Content="Extubated now" Visibility="{Binding Data.IsNotExtubated}" Command="{Binding Parent.Extubate}" AutomationProperties.Name="Record extubation now" />
                          <TextBlock Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding Data.ExtubatedText}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6">
                          <Button x:Uid="Record_72" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Stretch" Content="Sternal now" Visibility="{Binding Data.IsNotSternal}" Command="{Binding Parent.Sternal}" AutomationProperties.Name="Record sternal recumbency now" />
                          <TextBlock Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnSurfaceBrush}" Text="{Binding Data.SternalText}" />
                        </StackPanel>
                      </Grid>
                      <muxc:RadioButtons x:Uid="Record_73" Header="Pain score (0 none to 4 severe)" MaxColumns="6" IsEnabled="{Binding Data.CanEditRecovery}" SelectedIndex="{Binding Parent.Recovery.PainIndex, Mode=TwoWay}">
                        <RadioButton x:Uid="Record_74" Content="Not scored" />
                        <RadioButton Content="0" />
                        <RadioButton Content="1" />
                        <RadioButton Content="2" />
                        <RadioButton Content="3" />
                        <RadioButton Content="4" />
                      </muxc:RadioButtons>
                      <TextBox x:Uid="Record_75" Header="Temperature (°C)" InputScope="Number" MaxWidth="240" HorizontalAlignment="Left" IsEnabled="{Binding Data.CanEditRecovery}" Text="{Binding Parent.Recovery.TempC, Mode=TwoWay}" />
                      <TextBox x:Uid="Record_76" Header="Notes" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" IsEnabled="{Binding Data.CanEditRecovery}" Text="{Binding Parent.Recovery.Notes, Mode=TwoWay}" />
                    </StackPanel>
                  </utu:CardContentControl>

                  <StackPanel Spacing="8">
                    <Button x:Uid="Record_77" Style="{StaticResource CloverPrimary}" HorizontalAlignment="Left" MinWidth="220" Content="Sign off" Visibility="{Binding Data.IsRecovery}" Command="{Binding Parent.OpenSignOff}" AutomationProperties.Name="Sign off the record" />
                    <TextBlock Style="{StaticResource TitleMedium}" Foreground="{ThemeResource OnBackgroundBrush}" TextWrapping="WrapWholeWords" Text="{Binding Data.SignedText}" />
                    <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{Binding Data.IsSigned}">
                      <Button x:Uid="Record_78" Style="{StaticResource CloverPrimary}" Content="Export CSV" Command="{Binding Parent.Export}" AutomationProperties.Name="Export the record as CSV" />
                      <Button x:Uid="Record_79" Style="{StaticResource CloverSecondary}" Content="Copy summary" Command="{Binding Parent.CopySummary}" AutomationProperties.Name="Copy a text summary" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{Binding Parent.Notice}" AutomationProperties.LiveSetting="Polite" />
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

    <ScrollViewer Visibility="{Binding Parent.PaneHistory}"><StackPanel Padding="24" Spacing="16"><TextBlock Text="{Binding Data.VisitDate}" Style="{StaticResource CloverLabel}" /><TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource CloverHeading}" /><TextBlock Text="{Binding Data.Team}" Style="{StaticResource CloverBody}" /><TextBlock x:Uid="Record_133" Text="Observations in this record" Style="{StaticResource CloverTitle}" /><ItemsControl x:Uid="Record_39" ItemsSource="{Binding Data.Readings}" AutomationProperties.Name="Readings table">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="local:ReadingRow">
                            <Grid Padding="0,8" ColumnSpacing="12" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,0,0,1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="*" />
                              </Grid.ColumnDefinitions>
                              <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind Time}" />
                              <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Style="{StaticResource CodeTextStyle}" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="Wrap">
                                  <Run x:Uid="Record_40" Text="HR" /> <Run Text="{x:Bind Hr}" />
                                  <Run x:Uid="Record_41" Text=" RR" /> <Run Text="{x:Bind Rr}" />
                                  <Run x:Uid="Record_42" Text=" SpO₂" /> <Run Text="{x:Bind SpO2}" />
                                  <Run x:Uid="Record_43" Text=" BP" /> <Run Text="{x:Bind Bp}" />
                                  <Run x:Uid="Record_44" Text=" MAP" /> <Run Text="{x:Bind Map}" />
                                  <Run x:Uid="Record_45" Text=" EtCO₂" /> <Run Text="{x:Bind EtCo2}" />
                                  <Run x:Uid="Record_46" Text=" T" /> <Run Text="{x:Bind Temp}" />
                                  <Run Text=" " /> <Run Text="{x:Bind Plane}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource LabelLarge}" Foreground="{ThemeResource ErrorBrush}" Text="{x:Bind Alarms}" />
                                <TextBlock Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="{x:Bind Note}" />
                              </StackPanel>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      </StackPanel></ScrollViewer>
    <StackPanel Visibility="{Binding Parent.PaneLabs}" Padding="24" Spacing="16"><FontIcon Glyph="&#xE9F9;" FontSize="32" HorizontalAlignment="Left" Foreground="{ThemeResource PrimaryBrush}" /><TextBlock x:Uid="Record_134" Text="Lab results stay with your practice" Style="{StaticResource CloverHeading}" /><TextBlock x:Uid="Record_135" Text="This anaesthesia record stores the pre-op bloodwork check. Lab reports and reference values are not connected here." Style="{StaticResource CloverBody}" /><CheckBox x:Uid="Record_136" Content="Pre-op bloodwork reviewed" IsChecked="{Binding Data.Preop.BloodworkReviewed}" IsEnabled="False" /><Button x:Uid="Record_137" Content="View preparation" Command="{Binding Parent.OpenPane}" CommandParameter="Preop" Style="{StaticResource CloverSecondary}" HorizontalAlignment="Left" /></StackPanel>
  </Grid>
</Grid></SplitView.Pane>
        </SplitView></Grid>
      </DataTemplate></mvux:FeedView.ValueTemplate>

      <!-- Loading: skeleton of the hero tray, the procedure header and the four cards (same footprint). -->
      <mvux:FeedView.ProgressTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest='20,20,20,40', Normal='40,20,40,40', Layout={StaticResource ShellLayout}}" AutomationProperties.AccessibilityView="Raw">
            <!-- xaml-lint: allow card - skeleton of the hero tray (same footprint as the loaded tray) -->
            <Border Height="{utu:Responsive Narrowest=720, Wide=452, Layout={StaticResource ShellLayout}}" CornerRadius="26" Padding="20" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="14">
                <Rectangle Style="{StaticResource Skeleton}" Width="140" Height="28" />
                <Rectangle Style="{StaticResource Skeleton}" Width="180" Height="56" />
                <Rectangle Style="{StaticResource Skeleton}" Width="150" Height="20" />
                <Rectangle Style="{StaticResource Skeleton}" Width="200" Height="200" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
            <Rectangle Style="{StaticResource Skeleton}" Margin="0,48,0,0" Width="320" Height="28" />
            <Rectangle Style="{StaticResource Skeleton}" Margin="0,6,0,0" Width="260" Height="20" />
            <!-- xaml-lint: allow card - skeleton of the anesthesia record card -->
            <Border Margin="0,16,0,0" Height="292" CornerRadius="18" Background="{ThemeResource Surface1Brush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" Padding="20,18">
              <StackPanel Spacing="10">
                <Rectangle Style="{StaticResource Skeleton}" Width="160" Height="20" />
                <Rectangle Style="{StaticResource Skeleton}" Width="220" Height="16" />
                <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="170" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ProgressTemplate>

      <mvux:FeedView.NoneTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest='20,20,20,40', Normal='40,20,40,40', Layout={StaticResource ShellLayout}}">
            <!-- xaml-lint: allow card - None state inside the hero tray footprint -->
            <Border MinHeight="452" CornerRadius="26" Padding="32" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Uid="Record_105" Text="This record no longer exists." Style="{StaticResource TypeTitleM}" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                <TextBlock x:Uid="Record_106" Text="It may have been cleared from this device." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" HorizontalAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.NoneTemplate>

      <mvux:FeedView.ErrorTemplate>
        <DataTemplate>
          <StackPanel Padding="{utu:Responsive Narrowest='20,20,20,40', Normal='40,20,40,40', Layout={StaticResource ShellLayout}}">
            <!-- xaml-lint: allow card - Error state inside the hero tray footprint -->
            <Border MinHeight="452" CornerRadius="26" Padding="32" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
              <StackPanel Spacing="12" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                  <ContentControl Style="{StaticResource LineIcon18}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Uid="Record_107" Text="Couldn't read this record." Style="{StaticResource TypeTitleM}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <TextBlock x:Uid="Record_108" Text="The record file could not be read. Nothing was changed." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" />
                <Button x:Uid="Record_109" Style="{StaticResource ButtonSecondaryL}" HorizontalAlignment="Center" Content="Retry" AutomationProperties.Name="Retry reading the record" Command="{Binding DataContext.Retry, ElementName=CaseFeed}" />
              </StackPanel>
            </Border>
          </StackPanel>
        </DataTemplate>
      </mvux:FeedView.ErrorTemplate>
    </mvux:FeedView>
  </Grid>
</Page>
