<!--
  The case form sheet, two routes over one view: New patient (!NewCase, NewCaseModel, opened from the sidebar) and Case
  details (!EditCase, EditCaseModel, from the record's Preparation drawer). v2 utility layout: serif title and muted
  subtitle (the model's Heading and Intro), the model's Note when it has one, then three panel cards (Patient,
  Procedure, Schedule). The Schedule card feeds Today's gantt and the Next surgery card; every field in it is optional.
  The action bar (the model's ActionLabel, Save) stays pinned under the scroll area.
-->
<Page x:Class="Vigil.Presentation.CaseFormPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="{ThemeResource BackgroundBrush}">

  <!-- Phones stack every field pair; from Normal they share rows. -->
  <Grid utu:SafeArea.Insets="VisibleBounds" MaxWidth="{StaticResource FormMaxWidth}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <utu:NavigationBar Content="" Background="Transparent">
      <utu:NavigationBar.MainCommand>
        <AppBarButton x:Uid="NewCase_1" Label="Cancel"
                      AutomationProperties.Name="Cancel and close the form"
                      Command="{Binding Cancel}">
          <AppBarButton.Icon>
            <SymbolIcon Symbol="Cancel" />
          </AppBarButton.Icon>
        </AppBarButton>
      </utu:NavigationBar.MainCommand>
    </utu:NavigationBar>

    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled">
      <StackPanel Padding="{StaticResource SheetInsetFlush}" Spacing="{StaticResource Space16}">
        <StackPanel Spacing="{StaticResource Space6}" Margin="{StaticResource GapBottom8}">
          <TextBlock Text="{Binding Heading}" Style="{StaticResource HeadlineLarge}" TextWrapping="WrapWholeWords" AutomationProperties.HeadingLevel="Level1" />
          <TextBlock Text="{Binding Intro}" Style="{StaticResource BodyLarge}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" />
          <TextBlock Text="{Binding Note}" Style="{StaticResource BodyMedium}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" TextWrapping="WrapWholeWords" Visibility="{Binding HasNote, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
        </StackPanel>

        <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
          <StackPanel Spacing="{StaticResource Space14}">
            <TextBlock x:Uid="NewCase_4" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="PATIENT" />
            <TextBox x:Uid="NewCase_5" Header="Name"
                     Text="{Binding Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Patient name" />
            <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space14}, Normal=0}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <ComboBox x:Uid="NewCase_6" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" x:Name="SpeciesBox"
                        Header="Species"
                        HorizontalAlignment="Stretch"
                        SelectedIndex="{Binding Draft.SpeciesIndex, Mode=TwoWay}"
                        AutomationProperties.Name="Species">
                <ComboBoxItem x:Uid="NewCase_7" Content="Canine" />
                <ComboBoxItem x:Uid="NewCase_8" Content="Feline" />
                <ComboBoxItem x:Uid="NewCase_9" Content="Other" />
              </ComboBox>
              <TextBox x:Uid="NewCase_10" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}"
                       Header="Breed"
                       Text="{Binding Draft.Breed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Breed" />
            </Grid>
            <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space14}, Normal=0}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <TextBox x:Uid="NewCase_11" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" Header="Weight (kg)"
                       InputScope="Number"
                       Text="{Binding Draft.WeightText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Weight in kilograms" />
              <TextBox x:Uid="NewCase_12" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}"
                       Header="Age (years)"
                       InputScope="Number"
                       Text="{Binding Draft.AgeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Age in years" />
            </Grid>
            <TextBox x:Uid="NewCase_13" Header="Owner"
                     Text="{Binding Draft.Owner, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Owner" />
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
          <StackPanel Spacing="{StaticResource Space14}">
            <TextBlock x:Uid="NewCase_14" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="PROCEDURE" />
            <TextBox x:Uid="NewCase_15" Header="Procedure"
                     Text="{Binding Draft.Procedure, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Procedure" />
            <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space14}, Normal=0}" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
              <TextBox x:Uid="NewCase_16" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" Header="Veterinarian"
                       Text="{Binding Draft.Veterinarian, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Veterinarian" />
              <TextBox x:Uid="NewCase_17" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}"
                       Header="Technician"
                       Text="{Binding Draft.Technician, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Technician" />
            </Grid>
          </StackPanel>
        </utu:CardContentControl>

        <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
          <StackPanel Spacing="{StaticResource Space14}">
            <StackPanel Spacing="{StaticResource Space4}">
              <TextBlock x:Uid="NewCase_18" Style="{StaticResource CaptionLarge}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceVariantBrush}" Text="SCHEDULE" />
              <TextBlock x:Uid="NewCase_19" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords"
                         Text="Optional. Times are like 14:00. A planned start puts the patient on Today's timeline and in the Next surgery card." />
            </StackPanel>
            <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space14}, Normal=0}" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto">
              <TextBox x:Uid="NewCase_20" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1}" Header="Room"
                       Text="{Binding Draft.OperatingRoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Operating room" />
              <TextBox x:Uid="NewCase_21" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1}"
                       Header="Planned start"
                       Text="{Binding Draft.PlannedStartText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Planned start time" />
              <TextBox x:Uid="NewCase_22" Grid.Column="{utu:Responsive Narrowest=0, Normal=2}" Grid.Row="{utu:Responsive Narrowest=2, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=3, Normal=1}"
                       Header="Length (min)"
                       InputScope="Number"
                       Text="{Binding Draft.PlannedMinutesText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Planned length in minutes" />
            </Grid>
            <Grid ColumnSpacing="{StaticResource Space12}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space14}, Normal=0}" ColumnDefinitions="*,2*" RowDefinitions="Auto,Auto">
              <TextBox x:Uid="NewCase_23" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" Header="Fasting since"
                       Text="{Binding Draft.FastingSinceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.Name="Fasting since, time of day" />
              <CheckBox x:Uid="NewCase_24" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1}" VerticalAlignment="Bottom"
                        Content="Pet parent told the plan"
                        IsChecked="{Binding Draft.ParentNotified, Mode=TwoWay}"
                        AutomationProperties.Name="Pet parent has been told the plan" />
            </Grid>
          </StackPanel>
        </utu:CardContentControl>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Padding="{StaticResource SheetInset}" Spacing="{StaticResource Space12}" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineVariantBrush}">
      <StackPanel Spacing="{StaticResource Space4}" Visibility="{Binding HasErrors, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
        <TextBlock x:Uid="NewCase_25" Style="{StaticResource BodySmall}"
                   Foreground="{ThemeResource ErrorBrush}"
                   TextWrapping="WrapWholeWords"
                   Text="{Binding ErrorText}"
                   AutomationProperties.LiveSetting="Assertive"
                   AutomationProperties.Name="Form errors" />
        <TextBlock Style="{StaticResource BodySmall}"
                   Foreground="{ThemeResource ErrorBrush}"
                   TextWrapping="WrapWholeWords"
                   Text="{Binding SaveError}" />
      </StackPanel>
      <Button Style="{StaticResource ButtonPrimaryXL}"
              HorizontalAlignment="Stretch"
              Content="{Binding ActionLabel}"
              AutomationProperties.Name="{Binding ActionLabel}"
              Command="{Binding Save}" />
    </StackPanel>
  </Grid>
</Page>
