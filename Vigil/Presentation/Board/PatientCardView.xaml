<!--
  Today patient card (docs/design/today-dashboard-values.md §2.4). DataContext: PatientCard. The card's look is driven
  by PatientCard.VisualStates through utu:VisualStateManagerExtensions (strip colour per stage, current stepper label,
  details open or closed); nothing is toggled in code-behind. The whole card opens the record (a transparent button
  under the content, the CSS "stretch link"); the Show details toggle sits above it and flips the model's per-card state.
  Motion (shell-and-tokens.md §6): details rows grow over 300 ms (MaxHeight, collapse snaps), fade in 240 ms after 60 ms
  (team line 160 ms), sliding from -8 px; chevron
  turns 180° in 300 ms, back in 200 ms; ease-standard (0.2,0 0,1). "Still" states skip it (Reduce motion).
-->
<UserControl x:Class="Vigil.Presentation.PatientCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:uen="using:Uno.Extensions.Navigation.UI"
             xmlns:utu="using:Uno.Toolkit.UI"
             utu:VisualStateManagerExtensions.States="{Binding VisualStates}">
  <UserControl.Resources>
    <!-- Whole-card hit target: no fill of its own (the card paints itself), focus ring on the card radius.
         xaml-lint: allow template - a borderless hit layer; Material button templates add elevation and overlays -->
    <Style x:Key="CardHitButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius18}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Show details toggle (.tg): 44 px, top divider, hover #F3F3F2, pressed #ECECEE, bottom corners 0 0 17 17.
         xaml-lint: allow template - exact hover/pressed fills and the divider edge -->
    <Style x:Key="CardToggleButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="44" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusToggleBottom}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource PageBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource PressedBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DetailRow" TargetType="Grid">
      <Setter Property="MinHeight" Value="44" />
      <Setter Property="Padding" Value="{StaticResource ToggleInset}" />
      <Setter Property="ColumnSpacing" Value="12" />
      <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
  </UserControl.Resources>

  <Grid>
    <VisualStateManager.VisualStateGroups>
      <VisualStateGroup x:Name="StripStates">
        <VisualState x:Name="Live">
          <VisualState.Setters>
            <Setter Target="StripFill.Background" Value="{ThemeResource PhaseAnesthesiaSoftBrush}" />
            <Setter Target="StripGround.BorderBrush" Value="{ThemeResource PhaseAnesthesiaSoftBorderBrush}" />
            <Setter Target="StripDot.Fill" Value="{ThemeResource PhaseAnesthesiaSolidBrush}" />
            <Setter Target="StripDot.Stroke" Value="{ThemeResource PhaseAnesthesiaSolidBrush}" />
            <Setter Target="StripLabel.Foreground" Value="{ThemeResource PhaseAnesthesiaDeepBrush}" />
            <Setter Target="PulseRing.Visibility" Value="Visible" />
          </VisualState.Setters>
          <!-- clv-pulse: ring 14 → 18 px around the 8 px dot, opacity .18 → .08, 2 s ease-in-out; stops with the state. -->
          <Storyboard RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX">
              <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.75" /><SplineDoubleKeyFrame KeyTime="0:0:1" Value="2.25" KeySpline="0.42,0 0.58,1" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.75" KeySpline="0.42,0 0.58,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY">
              <SplineDoubleKeyFrame KeyTime="0:0:0" Value="1.75" /><SplineDoubleKeyFrame KeyTime="0:0:1" Value="2.25" KeySpline="0.42,0 0.58,1" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="1.75" KeySpline="0.42,0 0.58,1" />
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PulseRing" Storyboard.TargetProperty="Opacity">
              <SplineDoubleKeyFrame KeyTime="0:0:0" Value="0.18" /><SplineDoubleKeyFrame KeyTime="0:0:1" Value="0.08" KeySpline="0.42,0 0.58,1" /><SplineDoubleKeyFrame KeyTime="0:0:2" Value="0.18" KeySpline="0.42,0 0.58,1" />
            </DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="LiveStill">
          <VisualState.Setters>
            <Setter Target="StripFill.Background" Value="{ThemeResource PhaseAnesthesiaSoftBrush}" />
            <Setter Target="StripGround.BorderBrush" Value="{ThemeResource PhaseAnesthesiaSoftBorderBrush}" />
            <Setter Target="StripDot.Fill" Value="{ThemeResource PhaseAnesthesiaSolidBrush}" />
            <Setter Target="StripDot.Stroke" Value="{ThemeResource PhaseAnesthesiaSolidBrush}" />
            <Setter Target="StripLabel.Foreground" Value="{ThemeResource PhaseAnesthesiaDeepBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Prep">
          <VisualState.Setters>
            <Setter Target="StripFill.Background" Value="{ThemeResource PhasePrepSoftBrush}" />
            <Setter Target="StripGround.BorderBrush" Value="{ThemeResource PhasePrepSoftBorderBrush}" />
            <Setter Target="StripDot.Fill" Value="{ThemeResource PhasePrepSolidBrush}" />
            <Setter Target="StripDot.Stroke" Value="{ThemeResource PhasePrepSolidBrush}" />
            <Setter Target="StripLabel.Foreground" Value="{ThemeResource PhasePrepDeepBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Recovery">
          <VisualState.Setters>
            <Setter Target="StripFill.Background" Value="{ThemeResource PhaseRecoverySoftBrush}" />
            <Setter Target="StripGround.BorderBrush" Value="{ThemeResource PhaseRecoverySoftBorderBrush}" />
            <Setter Target="StripDot.Stroke" Value="{ThemeResource PhaseRecoverySolidBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Booked">
          <VisualState.Setters>
            <Setter Target="StripGround.Background" Value="{ThemeResource BookedHatchBrush}" />
            <Setter Target="StripGround.BorderBrush" Value="{ThemeResource BookedEdgeBrush}" />
            <Setter Target="StripDot.Stroke" Value="{ThemeResource PhaseWaitingSolidBrush}" />
            <Setter Target="StripLabel.Foreground" Value="{ThemeResource InkMutedBrush}" />
          </VisualState.Setters>
        </VisualState>
        <VisualState x:Name="Home">
          <VisualState.Setters>
            <Setter Target="StripFill.Background" Value="{ThemeResource Surface2Brush}" />
            <Setter Target="StripGround.BorderBrush" Value="{ThemeResource EdgeBrush}" />
            <Setter Target="StripDot.Stroke" Value="{ThemeResource InkFaintBrush}" />
            <Setter Target="StripLabel.Foreground" Value="{ThemeResource InkMutedBrush}" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="StageStates">
        <VisualState x:Name="StageBooked"><VisualState.Setters><Setter Target="Step0.Foreground" Value="{ThemeResource InkBrush}" /><Setter Target="Step0.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
        <VisualState x:Name="StagePrep"><VisualState.Setters><Setter Target="Step1.Foreground" Value="{ThemeResource InkBrush}" /><Setter Target="Step1.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
        <VisualState x:Name="StageSurgery"><VisualState.Setters><Setter Target="Step2.Foreground" Value="{ThemeResource InkBrush}" /><Setter Target="Step2.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
        <VisualState x:Name="StageRecovery"><VisualState.Setters><Setter Target="Step3.Foreground" Value="{ThemeResource InkBrush}" /><Setter Target="Step3.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
        <VisualState x:Name="StageHome"><VisualState.Setters><Setter Target="Step4.Foreground" Value="{ThemeResource InkBrush}" /><Setter Target="Step4.FontWeight" Value="SemiBold" /></VisualState.Setters></VisualState>
      </VisualStateGroup>
      <VisualStateGroup x:Name="DetailStates">
        <VisualState x:Name="Collapsed">
          <Storyboard>
            <DoubleAnimation Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction></DoubleAnimation>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="Expanded">
          <VisualState.Setters>
            <Setter Target="Details.Visibility" Value="Visible" />
            <Setter Target="Team.Visibility" Value="Visible" />
          </VisualState.Setters>
          <Storyboard>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ChevronTurn" Storyboard.TargetProperty="Angle"><SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="180" KeySpline="0.2,0 0,1" /></DoubleAnimationUsingKeyFrames>
            <!-- Rows grow 0fr to 1fr: MaxHeight 0 to the three 44 px rows, then unclamped so a wrapped procedure fits. -->
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Details" Storyboard.TargetProperty="MaxHeight" EnableDependentAnimation="True"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="132" KeySpline="0.2,0 0,1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.31" Value="1000" /></DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Team" Storyboard.TargetProperty="MaxHeight" EnableDependentAnimation="True"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="20" KeySpline="0.2,0 0,1" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.31" Value="1000" /></DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Details" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" KeySpline="0.2,0 0,1" /></DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="DetailsSlide" Storyboard.TargetProperty="Y"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.06" Value="-8" /><SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" KeySpline="0.2,0 0,1" /></DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Team" Storyboard.TargetProperty="Opacity"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="0" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="0" /><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="1" KeySpline="0.2,0 0,1" /></DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TeamSlide" Storyboard.TargetProperty="Y"><DiscreteDoubleKeyFrame KeyTime="0:0:0" Value="-8" /><DiscreteDoubleKeyFrame KeyTime="0:0:0.16" Value="-8" /><SplineDoubleKeyFrame KeyTime="0:0:0.4" Value="0" KeySpline="0.2,0 0,1" /></DoubleAnimationUsingKeyFrames>
          </Storyboard>
        </VisualState>
        <VisualState x:Name="CollapsedStill" />
        <VisualState x:Name="ExpandedStill">
          <VisualState.Setters>
            <Setter Target="Details.Visibility" Value="Visible" />
            <Setter Target="Team.Visibility" Value="Visible" />
            <Setter Target="ChevronTurn.Angle" Value="180" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <!-- Outer shell (.sh): #F8F8F7, radius 22, tri-tone border, pad 3, shadow card 0 2 3 -1 .07 -->
    <utu:ShadowContainer Background="{ThemeResource Surface2Brush}" CornerRadius="{StaticResource Radius22}" Shadows="{StaticResource ShadowCard}">
      <!-- xaml-lint: allow card - tri-tone stroke over the ShadowContainer surface (gradient edge, exact card shadow) -->
      <Border CornerRadius="{StaticResource Radius22}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" Padding="{StaticResource Inset3}">
        <!-- Tray: #FCFBF9, radius 18, tri-tone border, shadow xs -->
        <utu:ShadowContainer Background="{ThemeResource Surface1Brush}" CornerRadius="{StaticResource Radius18}" Shadows="{StaticResource ShadowXs}">
          <Border CornerRadius="{StaticResource Radius18}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1">
            <Grid RowDefinitions="*,Auto">
              <Button x:Uid="PatientCard_1" Style="{StaticResource CardHitButton}" uen:Navigation.Request="Record" uen:Navigation.Data="{Binding Ref}" AutomationProperties.Name="{Binding AccessibleName}" />
              <StackPanel IsHitTestVisible="False">
                <!-- Header tray: #F3F3F2, bottom edge #E6E6E8, radius 0 0 18 18, pad 6 -->
                <utu:ShadowContainer Background="{ThemeResource PageBrush}" CornerRadius="{StaticResource RadiusTrayHeader}" Shadows="{StaticResource ShadowXs}">
                  <Grid Padding="{StaticResource CardHeaderInset}" ColumnSpacing="{StaticResource Space12}" ColumnDefinitions="88,*" BorderBrush="{ThemeResource TrayEdgeBrush}" BorderThickness="0,0,0,1" CornerRadius="{StaticResource RadiusTrayHeader}">
                    <!-- Photo 88 x 44, radius 12, placeholder #E9E9EB, the whole picture fitted (Uniform, user 2026-10-29): an ImageBrush ground, because a Border's radius does not clip an Image child on Skia. -->
                    <Grid Width="88" Height="44">
                      <Rectangle RadiusX="{StaticResource RectRadius12}" RadiusY="{StaticResource RectRadius12}" Fill="{ThemeResource MediaPlaceholderBrush}" />
                      <Rectangle RadiusX="{StaticResource RectRadius12}" RadiusY="{StaticResource RectRadius12}" Visibility="{Binding HasPhoto}">
                        <Rectangle.Fill><ImageBrush ImageSource="{Binding Photo}" Stretch="Uniform" /></Rectangle.Fill>
                      </Rectangle>
                      <TextBlock Text="{Binding Initials}" Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource InkMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasNoPhoto}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space12}">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource TypeH3CardName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Style="{StaticResource BadgeOutline}" Visibility="{Binding AsaKnown}" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Asa}" Style="{StaticResource TypeCaptionStrong}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                        </Border>
                        <!-- dashed-pending badge: no fill, 1 px dashed #A3A6AE -->
                        <Grid Grid.Column="1" Height="24" Visibility="{Binding AsaPending}" VerticalAlignment="Center">
                          <Rectangle RadiusX="{StaticResource RectRadius8}" RadiusY="{StaticResource RectRadius8}" Stroke="{ThemeResource InkFaintBrush}" StrokeThickness="1" StrokeDashArray="3,2" />
                          <TextBlock Text="{Binding Asa}" Style="{StaticResource TypeCaptionStrong}" Margin="9,0" VerticalAlignment="Center" />
                        </Grid>
                      </Grid>
                      <TextBlock Text="{Binding Sub}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </utu:ShadowContainer>

                <!-- Details (collapsed by default): procedure, weight, pet parent -->
                <StackPanel x:Name="Details" Visibility="Collapsed" Opacity="1">
                  <StackPanel.RenderTransform><TranslateTransform x:Name="DetailsSlide" /></StackPanel.RenderTransform>
                  <Grid Style="{StaticResource DetailRow}" ColumnDefinitions="Auto,*">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                      <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconStethoscope}" />
                      <TextBlock x:Uid="PatientCard_2" Text="Procedure" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Procedure}" Style="{StaticResource TypeBodyMedium}" TextWrapping="WrapWholeWords" TextAlignment="Right" VerticalAlignment="Center" />
                  </Grid>
                  <Grid Style="{StaticResource DetailRow}" ColumnDefinitions="Auto,*" Padding="{StaticResource InsetX14}">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                      <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconWeight}" />
                      <TextBlock x:Uid="PatientCard_3" Text="Weight" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource BadgeNeutral}" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Weight}" Style="{StaticResource TypeCaptionStrong}" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                  <Grid Style="{StaticResource DetailRow}" ColumnDefinitions="Auto,*" Padding="{StaticResource InsetX14}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                      <ContentControl Style="{StaticResource LineIcon16}" Content="{StaticResource IconUserRound}" />
                      <TextBlock x:Uid="PatientCard_4" Text="Pet parent" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" />
                    </StackPanel>
                    <Border Grid.Column="1" Style="{StaticResource BadgeNeutral}" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Owner}" Style="{StaticResource TypeCaptionStrong}" Foreground="{ThemeResource InkBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </Border>
                  </Grid>
                </StackPanel>

                <!-- Status strip: margin 6 6 0, h 44, pad 0 12, radius 12, inset shadow (0 1 3 / 12 %).
                     Fill, inset shade and edge are three rounded Borders: a filled ShadowContainer with an inner shadow
                     painted its fill square on Skia, under the rounded edge. The edge carries the booked hatch. -->
                <Grid x:Name="StripShell" Margin="{StaticResource CardTrayMargin}" Height="44">
                  <!-- xaml-lint: allow card - status strip fill, recoloured per stage by the StripStates visual states -->
                  <Border x:Name="StripFill" CornerRadius="{StaticResource Radius12}" Background="{ThemeResource Surface2Brush}" />
                  <!-- xaml-lint: allow card - inset shade over the fill (CSS inset 0 1px 3px) -->
                  <Border CornerRadius="{StaticResource Radius12}" Background="{ThemeResource InsetShadeBrush}" IsHitTestVisible="False" />
                  <!-- xaml-lint: allow card - status strip edge (and the booked hatch), recoloured per stage -->
                  <Border x:Name="StripGround" CornerRadius="{StaticResource Radius12}" BorderThickness="1" Background="Transparent" BorderBrush="{ThemeResource EdgeBrush}" />
                  <Grid Padding="{StaticResource InsetX12}" ColumnSpacing="{StaticResource Space12}" ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                      <Grid Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse x:Name="PulseRing" Width="8" Height="8" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Opacity="0.18" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                          <Ellipse.RenderTransform><ScaleTransform x:Name="PulseScale" ScaleX="1.75" ScaleY="1.75" /></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="StripDot" Width="8" Height="8" StrokeThickness="1.5" Fill="Transparent" Stroke="{ThemeResource InkFaintBrush}" />
                      </Grid>
                      <TextBlock x:Name="StripLabel" Text="{Binding StripLabel}" Style="{StaticResource TypeMonoLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="{StaticResource Space12}" VerticalAlignment="Center">
                      <!-- Recorded heart rate, last 12 readings (SPEC-v2 decision 3: not a decorative ECG). -->
                      <!-- Phones drop the sparkline: next to the status label and the timer it leaves the label no room. -->
                      <Grid Visibility="{utu:Responsive Narrowest=Collapsed, Normal=Visible}" VerticalAlignment="Center">
                      <Grid Width="72" Height="20" Visibility="{Binding HasSparkline}" VerticalAlignment="Center">
                        <Path Data="{Binding Sparkline}" Stroke="{ThemeResource PhaseAnesthesiaSolidBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                      </Grid>
                      </Grid>
                      <TextBlock Text="{Binding StripValue}" Style="{StaticResource TypeMonoTimerCard}" Visibility="{Binding StripIsClock}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding StripValue}" Style="{StaticResource TypeBodyMedium}" Visibility="{Binding StripIsText}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Grid>
                </Grid>

                <!-- Stage stepper: pad 12 14, gap 6 -->
                <StackPanel Padding="{StaticResource StatusCardInset}" Spacing="{StaticResource Space6}" AutomationProperties.Name="{Binding StageName}">
                  <Grid Height="20">
                    <Grid Height="6" VerticalAlignment="Top" Margin="0,7,0,0" ColumnSpacing="{StaticResource Space3}" ColumnDefinitions="*,*,*,*,*">
                      <Rectangle RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource StepDoneHatchBrush}" />
                      <Rectangle Grid.Column="1" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource TrackBrush}" />
                      <Rectangle Grid.Column="1" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource PhasePrepStepBrush}" Visibility="{Binding ReachedPrep}" />
                      <Rectangle Grid.Column="2" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource TrackBrush}" />
                      <Rectangle Grid.Column="2" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource PhaseAnesthesiaStepBrush}" Visibility="{Binding ReachedSurgery}" />
                      <Rectangle Grid.Column="3" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource TrackBrush}" />
                      <Rectangle Grid.Column="3" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource PhaseRecoveryStepBrush}" Visibility="{Binding ReachedRecovery}" />
                      <Rectangle Grid.Column="4" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource TrackBrush}" />
                      <Rectangle Grid.Column="4" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource PhaseHomeStepBrush}" Visibility="{Binding ReachedHome}" />
                    </Grid>
                    <!-- Knob: 20 px, centred on the current stage (10/30/50/70/90 %), shadow knob 0 1 3 .2 -->
                    <Grid ColumnSpacing="{StaticResource Space3}" ColumnDefinitions="*,*,*,*,*">
                      <utu:ShadowContainer Grid.Column="{Binding StageIndex}" Width="20" Height="20" HorizontalAlignment="Center" Background="Transparent" CornerRadius="{StaticResource Radius10}" Shadows="{StaticResource ShadowKnob}">
                        <Grid Width="20" Height="20">
                          <Ellipse Fill="{ThemeResource KnobBrush}" Stroke="{ThemeResource KnobEdgeBrush}" StrokeThickness="1" />
                          <Ellipse Width="6" Height="6" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Visibility="{Binding KnobLive}" />
                        </Grid>
                      </utu:ShadowContainer>
                    </Grid>
                  </Grid>
                  <Grid ColumnSpacing="{StaticResource Space3}" ColumnDefinitions="*,*,*,*,*">
                    <TextBlock x:Uid="PatientCard_5" x:Name="Step0" Text="Booked" Style="{StaticResource TypeCaption}" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="PatientCard_6" x:Name="Step1" Grid.Column="1" Text="Prep" Style="{StaticResource TypeCaption}" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="PatientCard_7" x:Name="Step2" Grid.Column="2" Text="Surgery" Style="{StaticResource TypeCaption}" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="PatientCard_8" x:Name="Step3" Grid.Column="3" Text="Recovery" Style="{StaticResource TypeCaption}" FontWeight="Medium" HorizontalAlignment="Center" />
                    <TextBlock x:Uid="PatientCard_9" x:Name="Step4" Grid.Column="4" Text="Home" Style="{StaticResource TypeCaption}" FontWeight="Medium" HorizontalAlignment="Center" />
                  </Grid>
                </StackPanel>

                <!-- Team line (opens with the details, 160 ms later) -->
                <TextBlock x:Name="Team" Text="{Binding Team}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Margin="{StaticResource CardBodyInset}" TextWrapping="WrapWholeWords" Visibility="Collapsed">
                  <TextBlock.RenderTransform><TranslateTransform x:Name="TeamSlide" /></TextBlock.RenderTransform>
                </TextBlock>
              </StackPanel>

              <Button Grid.Row="1" Style="{StaticResource CardToggleButton}"
                      Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ToggleDetails}" CommandParameter="{Binding}"
                      AutomationProperties.Name="{Binding ToggleText}">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                  <TextBlock Text="{Binding ToggleText}" Style="{StaticResource TypeBodyMedium}" Foreground="{ThemeResource InkMutedBrush}" VerticalAlignment="Center" />
                  <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconChevronDown}" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform><RotateTransform x:Name="ChevronTurn" /></ContentControl.RenderTransform>
                  </ContentControl>
                </StackPanel>
              </Button>
            </Grid>
          </Border>
        </utu:ShadowContainer>
      </Border>
    </utu:ShadowContainer>
  </Grid>
</UserControl>
