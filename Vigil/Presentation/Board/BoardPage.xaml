<!--
  Today (route Main/Today), docs/design/today-dashboard-values.md. Header, "Right now" hero (live case or next
  surgery, care gantt), today's patient cards, "Due next" and "Where care time went". Every async block is a FeedView
  inside its own section shell: Progress = skeleton, None = the block's empty copy, Error = message + Retry
  (Retry → BoardModel.Retry → Store.Reload; ErrorTemplate's DataContext is the exception, so it binds by ElementName).
  Breakpoints (Styles/Layout.xaml): the header stacks below Widest; the hero and bottom splits stack below SplitLayout's
  Widest (1280, the full sidebar's page needs it); cards fit 3 / 2 / 1 columns by width (CardColumnsLayout, 320 px
  minimum); the Due next status column folds under the task below Wide; phones stack the section headers.
-->
<Page x:Class="Vigil.Presentation.BoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:controls="using:Vigil.Controls"
      xmlns:local="using:Vigil.Presentation"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Transparent">
  <Page.Resources>
    <!-- Segmented control segment (.seg): 30 px, radius 8; the selected chrome lives in the content (seg-on shadow).
         xaml-lint: allow template - hover ink 5 % under a content-drawn selected surface -->
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius8}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource InkHoverBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource InkGridlineBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter Content="{TemplateBinding Content}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Due row hit layer (.row): hover #F8F8F7; opens the patient's record.
         xaml-lint: allow template - row hover fill under the row content -->
    <Style x:Key="RowHitButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{TemplateBinding Background}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource Surface2Brush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource PageBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ButtonSecondaryS" TargetType="Button" BasedOn="{StaticResource ButtonSecondaryM}">
      <Setter Property="Height" Value="32" />
    </Style>
    <!-- Section surfaces -->
    <Style x:Key="HeroSection" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius24}" />
      <Setter Property="Padding" Value="{StaticResource Inset24}" />
      <Setter Property="Background" Value="{ThemeResource HeroGradientBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource HeroEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="GlassEdge" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius22}" />
      <Setter Property="Padding" Value="{StaticResource Inset6}" />
      <Setter Property="BorderBrush" Value="{ThemeResource GlassEdgeBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="LiveCardSurface" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius16}" />
      <Setter Property="Padding" Value="{StaticResource LiveCardInset}" />
      <Setter Property="Background" Value="{ThemeResource Surface1Brush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource TriToneBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="QuietPanel" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius14}" />
      <Setter Property="Padding" Value="{StaticResource QuietPanelInset}" />
      <Setter Property="Background" Value="{ThemeResource PageBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource TriToneBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="IconTile" TargetType="Border">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius10}" />
    </Style>
    <Style x:Key="GanttName" TargetType="TextBlock" BasedOn="{StaticResource TypeBodyS}">
      <Setter Property="LineHeight" Value="16" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{ThemeResource InkBrush}" />
    </Style>

    <!-- A hero stat (label row with dot, mono value, sub). -->
    <DataTemplate x:Key="HeroStatTemplate">
      <StackPanel Spacing="{StaticResource Space2}">
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
          <Grid Width="6" Height="6" VerticalAlignment="Center">
            <Ellipse Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Visibility="{Binding IsLive}" />
            <Ellipse Fill="{ThemeResource PhasePrepSolidBrush}" Visibility="{Binding IsPrep}" />
            <Ellipse Fill="{ThemeResource PhaseErrorSolidBrush}" Visibility="{Binding IsError}" />
            <Ellipse Fill="{ThemeResource InkMutedBrush}" Visibility="{Binding IsMuted}" />
          </Grid>
          <TextBlock Text="{Binding Label}" Style="{StaticResource TypeBodyS}" />
        </StackPanel>
        <!-- Phones: the 16 px mono step, so a time still fits a third of the live card. -->
        <TextBlock Text="{Binding Value}" Style="{utu:Responsive Narrowest={StaticResource TypeMonoValueS}, Normal={StaticResource TypeMonoValue}}" Visibility="{Binding IsMono}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Value}" Style="{StaticResource TypeTitleS}" LineHeight="26" Visibility="{Binding IsText}" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Sub}" Style="{StaticResource TypeCaption}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
    </DataTemplate>

    <!-- Gantt mark: a phase segment (radius 4), a planned slot (hatch) or the now dot (16 px, 3 px white ring). -->
    <DataTemplate x:Key="GanttMarkTemplate">
      <Grid ToolTipService.ToolTip="{Binding Tooltip}" Background="Transparent">
        <Grid Height="12" Visibility="{Binding IsSegment}">
          <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhasePrepSolidBrush}" Visibility="{Binding IsPrep}" />
          <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Visibility="{Binding IsAnesthesia}" />
          <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhaseRecoverySolidBrush}" Visibility="{Binding IsRecovery}" />
          <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhaseWaitingSolidBrush}" Visibility="{Binding IsWaiting}" />
          <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PlannedHatchBrush}" Visibility="{Binding IsPlanned}" />
        </Grid>
        <utu:ShadowContainer Width="16" Height="16" CornerRadius="{StaticResource Radius8}" Background="{ThemeResource OnInkBrush}" Visibility="{Binding IsDot}" Shadows="{StaticResource ShadowGanttDot}">
          <Grid Width="16" Height="16">
            <Ellipse Width="10" Height="10" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Visibility="{Binding IsAnesthesia}" />
            <Ellipse Width="10" Height="10" Fill="{ThemeResource PhaseRecoverySolidBrush}" Visibility="{Binding IsRecovery}" />
            <Ellipse Width="10" Height="10" Fill="{ThemeResource PhasePrepSolidBrush}" Visibility="{Binding IsPrep}" />
          </Grid>
        </utu:ShadowContainer>
      </Grid>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="SpanItems"><controls:SpanPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="SpanLabelItems"><controls:SpanPanel HideOverlaps="True" /></ItemsPanelTemplate>
  </Page.Resources>

  <ScrollViewer x:Name="TodayScroll" HorizontalScrollMode="Disabled">
    <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageInsetNarrow}, Normal={StaticResource PageInsetNormal}}" MaxWidth="{StaticResource ContentMaxWidth}">

      <!-- 1. Header: greeting + recap, top bar cluster (top-aligned, gap 24) -->
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space24}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space16}, Widest=0}">
        <StackPanel Grid.Row="{utu:Responsive Narrowest=1, Widest=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1}">
          <!-- Newsreader sits 4 px lower than the browser places it at 40/46: pulled up to the render. -->
          <TextBlock Text="{Binding Greeting.Title}" Style="{StaticResource TypeDisplayTitle}" Margin="0,-4,0,0" />
          <!-- Recap: the most urgent fact in bold, then the other counts. -->
          <TextBlock Margin="{StaticResource GapTop10}" Style="{StaticResource TypeBodyL}" Foreground="{ThemeResource InkMutedBrush}" AutomationProperties.LiveSetting="Off"><Run Text="{Binding Greeting.Lead}" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" /><Run Text="{Binding Greeting.Rest}" /></TextBlock>
        </StackPanel>
        <controls:TopBarCluster Grid.Column="{utu:Responsive Narrowest=0, Widest=1}" VerticalAlignment="Top" />
      </Grid>

      <!-- 2. Hero "Right now": live card (448) | under care today + gantt; stacks below 1080 -->
      <!-- xaml-lint: allow card - hero section ground is the 110° gradient (§2.1), not a card surface -->
      <Border Style="{StaticResource HeroSection}" Margin="{StaticResource HeroTopGap}" Padding="{utu:Responsive Narrowest={StaticResource Inset12}, Normal={StaticResource Inset24}}">
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
              ColumnSpacing="{utu:Responsive Narrowest=0, Widest={StaticResource Space40}, Layout={StaticResource SplitLayout}}"
              RowSpacing="{utu:Responsive Narrowest={StaticResource Space24}, Widest=0, Layout={StaticResource SplitLayout}}">
          <mvux:FeedView x:Name="HeroFeed" Source="{Binding Hero}" RefreshingState="None" IsTabStop="False" VerticalAlignment="Center"
                         Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}" HorizontalContentAlignment="Stretch"
                         Width="{utu:Responsive Narrowest=NaN, Widest={StaticResource HeroCardWidth}, Layout={StaticResource SplitLayout}}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <!-- Glass shell: rgba(255,255,255,.5), radius 22, pad 6, edge .8 white, shadow glass 0 10 28 -16 .28 -->
                <utu:ShadowContainer Background="{ThemeResource GlassShellBrush}" CornerRadius="{StaticResource Radius22}" Shadows="{StaticResource ShadowGlass}">
                  <Border Style="{StaticResource GlassEdge}">
                    <Border Style="{StaticResource LiveCardSurface}" Padding="{utu:Responsive Narrowest={StaticResource LiveCardInsetNarrow}, Normal={StaticResource LiveCardInset}}">
                      <StackPanel AutomationProperties.Name="{Binding Data.AccessibleName}">
                        <!-- Row 1: icon tile, title + subtitle, Record / Start prep -->
                        <!-- Phones move Record / Start prep under the title so the title keeps the row. -->
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space10}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space10}, Normal=0}">
                          <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Grid Visibility="{Binding Data.IsLive}">
                              <Rectangle RadiusX="{StaticResource RectRadius9}" RadiusY="{StaticResource RectRadius9}" Fill="{ThemeResource PhaseAnesthesiaSoftBrush}" Stroke="{ThemeResource PhaseAnesthesiaSoftBorderBrush}" StrokeThickness="1" />
                              <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconActivity}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" />
                            </Grid>
                            <Grid Visibility="{Binding Data.IsNext}">
                              <Rectangle RadiusX="{StaticResource RectRadius9}" RadiusY="{StaticResource RectRadius9}" Fill="{ThemeResource PhasePrepSoftBrush}" Stroke="{ThemeResource PhasePrepSoftBorderBrush}" StrokeThickness="1" />
                              <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconCalendar}" Foreground="{ThemeResource PhasePrepDeepBrush}" />
                            </Grid>
                          </Grid>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Data.Title}" Style="{StaticResource TypeTitleS}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Data.Subtitle}" Style="{StaticResource TypeBodyS}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <Button x:Uid="TodayPage_1" Grid.Column="{utu:Responsive Narrowest=1, Normal=2}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" HorizontalAlignment="Left" Style="{StaticResource ButtonPrimaryS}" VerticalAlignment="Center" Visibility="{Binding Data.IsLive}"
                                  Command="{Binding Parent.OpenRecord}" CommandParameter="{Binding Data}" AutomationProperties.Name="Record observations">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                              <TextBlock x:Uid="TodayPage_2" Text="Record" Style="{StaticResource TypeButtonS}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                              <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconPlus}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Button>
                          <Button Grid.Column="{utu:Responsive Narrowest=1, Normal=2}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" HorizontalAlignment="Left" Style="{StaticResource ButtonSecondaryS}" VerticalAlignment="Center" Visibility="{Binding Data.CanStartPrep}"
                                  Command="{Binding Parent.StartPrep}" CommandParameter="{Binding Data}">
                            <TextBlock x:Uid="TodayPage_3" Text="Start prep" Style="{StaticResource TypeButtonS}" VerticalAlignment="Center" />
                          </Button>
                        </Grid>
                        <!-- Timer row: margin-top 14, baseline-aligned caption -->
                        <!-- Phones put the caption under the timer: side by side they need ~280 px. -->
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space12}" Margin="{StaticResource GapTop14}">
                          <TextBlock Text="{Binding Data.Timer}" Style="{StaticResource TypeMonoHero}" />
                          <!-- 11 px: the caption's baseline on the timer's (optical, as the prototype's align-items: baseline). -->
                          <TextBlock Text="{Binding Data.TimerCaption}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"
                                     Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Margin="{utu:Responsive Narrowest='0', Normal='0,0,0,11'}" />
                        </Grid>
                        <!-- Chip row: margin-top 8 -->
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space10}" Margin="{StaticResource GapTop8}" Height="26">
                          <Border Style="{StaticResource ChipErrorSoft}" Visibility="{Binding Data.ShowErrorChip}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                              <ContentControl Style="{StaticResource LineIcon14Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Data.ChipText}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <Border Style="{StaticResource ChipLiveSoft}" Height="26" Padding="{StaticResource InsetX8}" Visibility="{Binding Data.ShowReadyChip}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                              <ContentControl Style="{StaticResource LineIcon14Bold}" Content="{StaticResource IconCheck}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Data.ChipText}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                          </Border>
                          <Border Style="{StaticResource BadgeNeutral}" Height="26" Visibility="{Binding Data.ShowNeutralChip}">
                            <TextBlock Text="{Binding Data.ChipText}" Style="{StaticResource TypeBodyS}" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" VerticalAlignment="Center" />
                          </Border>
                          <!-- One chip shows at a time (they share the first cell); the note trims. -->
                          <TextBlock Grid.Column="1" Text="{Binding Data.ChipNote}" Style="{StaticResource TypeBodyS}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>
                        <!-- Stats: margin-top 16, pad-top 14, top divider; 2 and 3 have a left divider + 16 -->
                        <Grid Margin="{StaticResource GapTop16}" Padding="{StaticResource GapTop14}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" ColumnDefinitions="*,*,*" ColumnSpacing="{utu:Responsive Narrowest={StaticResource Space8}, Normal={StaticResource Space16}}">
                          <ContentControl Content="{Binding Data.First}" ContentTemplate="{StaticResource HeroStatTemplate}" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                          <Grid Grid.Column="1" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0" Padding="{utu:Responsive Narrowest={StaticResource GapStart8}, Normal={StaticResource GapStart16}}">
                            <ContentControl Content="{Binding Data.Second}" ContentTemplate="{StaticResource HeroStatTemplate}" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                          </Grid>
                          <Grid Grid.Column="2" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="1,0,0,0" Padding="{utu:Responsive Narrowest={StaticResource GapStart8}, Normal={StaticResource GapStart16}}">
                            <ContentControl Content="{Binding Data.Third}" ContentTemplate="{StaticResource HeroStatTemplate}" HorizontalContentAlignment="Stretch" IsTabStop="False" />
                          </Grid>
                        </Grid>
                      </StackPanel>
                    </Border>
                  </Border>
                </utu:ShadowContainer>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <Border Style="{StaticResource GlassEdge}" Background="{ThemeResource GlassShellBrush}" AutomationProperties.AccessibilityView="Raw">
                  <Border Style="{StaticResource LiveCardSurface}" Height="287">
                    <StackPanel Spacing="{StaticResource Space14}">
                      <Rectangle Style="{StaticResource Skeleton}" Width="220" Height="30" />
                      <Rectangle Style="{StaticResource Skeleton}" Width="160" Height="64" />
                      <Rectangle Style="{StaticResource Skeleton}" Width="200" Height="26" />
                      <Rectangle Style="{StaticResource Skeleton}" Width="340" Height="60" />
                    </StackPanel>
                  </Border>
                </Border>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <Border Style="{StaticResource GlassEdge}" Background="{ThemeResource GlassShellBrush}">
                  <Border Style="{StaticResource LiveCardSurface}" MinHeight="287">
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space6}" AutomationProperties.LiveSetting="Polite">
                      <TextBlock x:Uid="TodayPage_4" Text="Nothing in surgery" Style="{StaticResource TypeTitleS}" />
                      <TextBlock x:Uid="TodayPage_5" Text="No surgery is running and none is booked for later today." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                    </StackPanel>
                  </Border>
                </Border>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
            <mvux:FeedView.ErrorTemplate>
              <DataTemplate>
                <Border Style="{StaticResource GlassEdge}" Background="{ThemeResource GlassShellBrush}">
                  <Border Style="{StaticResource LiveCardSurface}" MinHeight="287">
                    <StackPanel VerticalAlignment="Center" Spacing="{StaticResource Space10}" AutomationProperties.LiveSetting="Polite">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                        <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                        <TextBlock x:Uid="TodayPage_6" Text="Couldn't read the case in surgery." Style="{StaticResource TypeTitleS}" />
                      </StackPanel>
                      <Button x:Uid="TodayPage_7" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=HeroFeed}" AutomationProperties.Name="Retry reading records">
                        <TextBlock x:Uid="TodayPage_8" Text="Retry" Style="{StaticResource TypeButtonS}" />
                      </Button>
                    </StackPanel>
                  </Border>
                </Border>
              </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>

          <!-- Care timeline: under care today + gantt (§2.2), pad T4 R4 -->
          <mvux:FeedView x:Name="TimelineFeed" Source="{Binding Timeline}" RefreshingState="None" IsTabStop="False" VerticalAlignment="Center" HorizontalContentAlignment="Stretch"
                         Grid.Column="{utu:Responsive Narrowest=0, Widest=1, Layout={StaticResource SplitLayout}}"
                         Grid.Row="{utu:Responsive Narrowest=1, Widest=0, Layout={StaticResource SplitLayout}}"
                         Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <StackPanel Padding="{StaticResource TimelineInset}">
                  <TextBlock x:Uid="TodayPage_9" Text="Under care today" Style="{StaticResource TypeBodyMedium}" Foreground="{ThemeResource InkMutedBrush}" />
                  <TextBlock Text="{Binding Data.TotalText}" Style="{StaticResource TypeMonoStat}" Margin="{StaticResource GapTop2}" />
                  <TextBlock Text="{Binding Data.DayLine}" Style="{StaticResource TypeBodyS}" Margin="{StaticResource GapTop4}" />
                  <StackPanel Margin="{StaticResource GapTop14}" AutomationProperties.Name="{Binding Data.AccessibleName}">
                    <!-- Now pill: 20 px, radius 6, ink ground, centred on now -->
                    <controls:SpanPanel Margin="56,0,0,0" Height="22">
                      <!-- xaml-lint: allow card - 20 px "Now" pill, display-only -->
                      <Border controls:SpanPanel.Start="{Binding Data.NowFraction}" Height="20" Padding="{StaticResource InsetX6}" CornerRadius="{StaticResource Radius6}" Background="{ThemeResource InkBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Data.NowText}" Style="{StaticResource TypeMonoAxis}" Foreground="{ThemeResource OnInkBrush}" VerticalAlignment="Center" />
                      </Border>
                    </controls:SpanPanel>
                    <Grid>
                      <!-- Hour gridlines and the now line under the rows -->
                      <ItemsControl Margin="56,0,0,0" ItemsSource="{Binding Data.Ticks}" ItemsPanel="{StaticResource SpanItems}" IsTabStop="False">
                        <ItemsControl.ItemTemplate><DataTemplate><Rectangle Width="1" Fill="{ThemeResource InkGridlineBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <controls:SpanPanel Margin="56,-2,0,0">
                        <Rectangle controls:SpanPanel.Start="{Binding Data.NowFraction}" Width="1" Fill="{ThemeResource InkBrush}" />
                      </controls:SpanPanel>
                      <ItemsControl ItemsSource="{Binding Data.Rows}" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Grid Height="30" ColumnDefinitions="56,*">
                              <TextBlock Text="{Binding Name}" Style="{StaticResource GanttName}" VerticalAlignment="Center" />
                              <Grid Grid.Column="1" Height="12" VerticalAlignment="Center">
                                <Rectangle RadiusX="{StaticResource RectRadius6}" RadiusY="{StaticResource RectRadius6}" Fill="{ThemeResource GanttTrackBrush}" />
                                <ItemsControl ItemsSource="{Binding Marks}" ItemsPanel="{StaticResource SpanItems}" ItemTemplate="{StaticResource GanttMarkTemplate}" IsTabStop="False" />
                              </Grid>
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Grid>
                    <!-- Axis labels: margin-top 6, Martian Mono 11/16 -->
                    <ItemsControl Margin="56,6,0,0" Height="16" ItemsSource="{Binding Data.Ticks}" ItemsPanel="{StaticResource SpanLabelItems}" IsTabStop="False">
                      <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" Style="{StaticResource TypeMonoAxis}" /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Legend: margin T14 L56 (under the tracks), gap 16. Phones start it at the edge and wrap it onto two rows (three, then two). -->
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{utu:Responsive Narrowest={StaticResource Space10}, Normal={StaticResource Space16}}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space6}, Normal=0}" Margin="{utu:Responsive Narrowest={StaticResource GapTop14}, Normal='56,14,0,0'}">
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Grid.Column="{utu:Responsive Narrowest=0, Normal=0}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}"><Ellipse Width="8" Height="8" Fill="{ThemeResource PhasePrepSolidBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="TodayPage_10" Text="Prep" Style="{StaticResource TypeCaption}" /></StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Grid.Column="{utu:Responsive Narrowest=1, Normal=1}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}"><Ellipse Width="8" Height="8" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="TodayPage_11" Text="Anesthesia" Style="{StaticResource TypeCaption}" /></StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Grid.Column="{utu:Responsive Narrowest=2, Normal=2}" Grid.Row="{utu:Responsive Narrowest=0, Normal=0}"><Ellipse Width="8" Height="8" Fill="{ThemeResource PhaseRecoverySolidBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="TodayPage_12" Text="Recovery" Style="{StaticResource TypeCaption}" /></StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Grid.Column="{utu:Responsive Narrowest=0, Normal=3}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"><Ellipse Width="8" Height="8" Fill="{ThemeResource PhaseWaitingSolidBrush}" VerticalAlignment="Center" /><TextBlock x:Uid="TodayPage_13" Text="Waiting" Style="{StaticResource TypeCaption}" /></StackPanel>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Grid.Column="{utu:Responsive Narrowest=1, Normal=4}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}"><Rectangle Width="14" Height="8" RadiusX="{StaticResource RectRadius3}" RadiusY="{StaticResource RectRadius3}" Fill="{ThemeResource PlannedHatchBrush}" Stroke="{ThemeResource InkGridlineBrush}" StrokeThickness="0.5" VerticalAlignment="Center" /><TextBlock x:Uid="TodayPage_14" Text="Planned" Style="{StaticResource TypeCaption}" /></StackPanel>
                    </Grid>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <StackPanel Padding="{StaticResource TimelineInset}" Spacing="{StaticResource Space10}" AutomationProperties.AccessibilityView="Raw">
                  <Rectangle Style="{StaticResource Skeleton}" Width="120" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" Width="140" Height="30" />
                  <Rectangle Style="{StaticResource Skeleton}" Width="240" Height="14" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="170" Margin="{StaticResource GapTop8}" />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <StackPanel Padding="{StaticResource TimelineInset}" Spacing="{StaticResource Space4}" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Uid="TodayPage_15" Text="Under care today" Style="{StaticResource TypeBodyMedium}" Foreground="{ThemeResource InkMutedBrush}" />
                  <TextBlock x:Uid="TodayPage_16" Text="0h 0m" Style="{StaticResource TypeMonoStat}" />
                  <TextBlock x:Uid="TodayPage_17" Text="No care recorded yet today. The timeline fills in as patients are prepared." Style="{StaticResource TypeBodyS}" TextWrapping="WrapWholeWords" />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
            <mvux:FeedView.ErrorTemplate>
              <DataTemplate>
                <StackPanel Padding="{StaticResource TimelineInset}" Spacing="{StaticResource Space10}" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Uid="TodayPage_18" Text="Couldn't build today's timeline." Style="{StaticResource TypeTitleS}" />
                  <Button x:Uid="TodayPage_19" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=TimelineFeed}" AutomationProperties.Name="Retry reading records">
                    <TextBlock x:Uid="TodayPage_20" Text="Retry" Style="{StaticResource TypeButtonS}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
        </Grid>
      </Border>

      <!-- 3. Today's patients: header (segmented filter, All records), 3 / 2 / 1 column card grid -->
      <!-- Below Wide the title and All records share the first row and the filter takes the second; from Wide one row. -->
      <Grid Margin="{StaticResource GapTop40}" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space16}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space12}, Wide=0}">
        <TextBlock x:Uid="TodayPage_21" Text="Today's patients" Style="{StaticResource TypeH2Section}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1}"
                    Grid.Row="{utu:Responsive Narrowest=1, Wide=0}">
          <!-- Segmented control: pad 3, radius 11, #F3F3F2, border #E8E8EA, gap 2 -->
          <!-- xaml-lint: allow card - segmented-control track, not a surface -->
          <Border x:Uid="TodayPage_22" Padding="{StaticResource Inset3}" CornerRadius="{StaticResource Radius11}" Background="{ThemeResource PageBrush}" BorderBrush="{ThemeResource SegmentTrackEdgeBrush}" BorderThickness="1" AutomationProperties.Name="Filter patients">
            <ItemsControl ItemsSource="{Binding Tabs}" IsTabStop="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SegmentButton}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ShowFilter}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid>
                      <utu:ShadowContainer Background="{ThemeResource Surface1Brush}" CornerRadius="{StaticResource Radius8}" Visibility="{Binding IsSelected}" Shadows="{StaticResource ShadowSegOn}">
                        <Border CornerRadius="{StaticResource Radius8}" BorderBrush="{ThemeResource EdgeBrush}" BorderThickness="1" />
                      </utu:ShadowContainer>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Padding="{StaticResource InsetX12}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkBrush}" FontWeight="SemiBold" Visibility="{Binding IsSelected}" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkBrush}" FontWeight="Medium" Visibility="{Binding IsUnselected}" />
                        <TextBlock Text="{Binding Count}" Style="{StaticResource TypeBodyS}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
        <Button x:Uid="TodayPage_23" Grid.Column="2" Style="{StaticResource LinkButton}" Content="All records" Command="{Binding OpenPatients}" VerticalAlignment="Center" />
      </Grid>
      <mvux:FeedView x:Name="CardsFeed" Source="{Binding Cards}" Margin="{StaticResource GapTop16}" MinHeight="227" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <muxc:ItemsRepeater x:Uid="TodayPage_24" ItemsSource="{Binding Data}" AutomationProperties.Name="Patient cards">
              <muxc:ItemsRepeater.Layout><controls:CardColumnsLayout MinColumnWidth="{StaticResource CardMinColumnWidth}" MaxColumns="3" ColumnSpacing="{StaticResource Space24}" RowSpacing="{StaticResource Space24}" /></muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate><local:PatientCardView /></DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.ProgressTemplate>
          <DataTemplate>
            <!-- Skeleton: the collapsed card's footprint (photo, two text bars, strip, stepper, toggle), 227 px -->
            <muxc:ItemsRepeater ItemsSource="{Binding DataContext.Skeleton, ElementName=CardsFeed}" AutomationProperties.AccessibilityView="Raw">
              <muxc:ItemsRepeater.Layout><controls:CardColumnsLayout MinColumnWidth="{StaticResource CardMinColumnWidth}" MaxColumns="3" ColumnSpacing="{StaticResource Space24}" RowSpacing="{StaticResource Space24}" /></muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <!-- xaml-lint: allow card - skeleton of the patient card shell -->
                  <Border Height="227" CornerRadius="{StaticResource Radius22}" Background="{ThemeResource Surface2Brush}" BorderBrush="{ThemeResource TriToneBorderBrush}" BorderThickness="1" Padding="{StaticResource CardSkeletonInset}">
                    <Grid RowDefinitions="44,Auto,Auto,*" RowSpacing="{StaticResource Space12}">
                      <Grid ColumnDefinitions="88,*" ColumnSpacing="{StaticResource Space12}">
                        <Rectangle Style="{StaticResource Skeleton}" Width="88" Height="44" RadiusX="{StaticResource RectRadius12}" RadiusY="{StaticResource RectRadius12}" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                          <Rectangle Style="{StaticResource Skeleton}" Width="90" Height="16" />
                          <Rectangle Style="{StaticResource Skeleton}" Width="150" Height="12" />
                        </StackPanel>
                      </Grid>
                      <Rectangle Grid.Row="1" Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="44" RadiusX="{StaticResource RectRadius12}" RadiusY="{StaticResource RectRadius12}" />
                      <Rectangle Grid.Row="2" Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="6" Margin="{StaticResource SkeletonStepperMargin}" />
                      <Rectangle Grid.Row="3" Style="{StaticResource Skeleton}" HorizontalAlignment="Center" Width="100" Height="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>
        </mvux:FeedView.ProgressTemplate>
        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <Border Style="{StaticResource QuietPanel}" MinHeight="227" Padding="{StaticResource Inset24}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="{StaticResource Space8}" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{Binding DataContext.CardsEmpty.Title, ElementName=CardsFeed}" Style="{StaticResource TypeTitleS}" TextWrapping="WrapWholeWords" />
                <TextBlock Text="{Binding DataContext.CardsEmpty.Body, ElementName=CardsFeed}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space10}" Margin="{StaticResource GapTop8}" Visibility="{Binding DataContext.CardsEmpty.ShowActions, ElementName=CardsFeed, FallbackValue=Collapsed}">
                  <Button x:Uid="TodayPage_25" Style="{StaticResource ButtonPrimaryM}" Command="{Binding DataContext.NewCase, ElementName=CardsFeed}" AutomationProperties.Name="New patient">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                      <TextBlock x:Uid="TodayPage_26" Text="New patient" Style="{StaticResource TypeButtonS}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                      <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconPlus}" Foreground="{ThemeResource OnPrimaryInkBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource ButtonSecondaryM}" Command="{Binding DataContext.OpenAgenda, ElementName=CardsFeed}">
                    <TextBlock x:Uid="TodayPage_27" Text="Open agenda" Style="{StaticResource TypeButtonS}" VerticalAlignment="Center" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>
        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <Border Style="{StaticResource QuietPanel}" MinHeight="227" Padding="{StaticResource Inset24}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="{StaticResource Space10}" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                  <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Uid="TodayPage_28" Text="Couldn't read saved records." Style="{StaticResource TypeTitleS}" />
                </StackPanel>
                <Button x:Uid="TodayPage_29" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=CardsFeed}" AutomationProperties.Name="Retry reading records">
                  <TextBlock x:Uid="TodayPage_30" Text="Retry" Style="{StaticResource TypeButtonS}" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>

      <!-- 4. Bottom split: Due next (1.55fr) | Where care time went (1fr, left divider + 40); stacks below SplitLayout's Widest -->
      <Grid Margin="{StaticResource GapTop48}" RowDefinitions="Auto,Auto"
            ColumnSpacing="{utu:Responsive Narrowest=0, Widest={StaticResource Space40}, Layout={StaticResource SplitLayout}}"
            RowSpacing="{utu:Responsive Narrowest={StaticResource Space40}, Widest=0, Layout={StaticResource SplitLayout}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space16}">
            <StackPanel>
              <TextBlock x:Uid="TodayPage_31" Text="Due next" Style="{StaticResource TypeH2Section}" />
              <TextBlock Text="{Binding DueHeader.Summary}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Margin="{StaticResource GapTop2}" />
            </StackPanel>
            <Button x:Uid="TodayPage_32" Grid.Column="1" Style="{StaticResource LinkButton}" Content="Open agenda" Command="{Binding OpenAgenda}" VerticalAlignment="Bottom" />
          </Grid>
          <!-- Status (148) from Wide; below it the column is empty (Auto, 0 wide) and the status folds under the task.
               Phones tighten the gaps so the task keeps ~130 px next to the time chip and the action. -->
          <Grid Margin="{StaticResource GapTop16}" Padding="{StaticResource GapBottom8}" ColumnSpacing="{utu:Responsive Narrowest={StaticResource Space10}, Normal={StaticResource Space16}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Uid="TodayPage_33" Text="Due" Style="{StaticResource TypeCaptionStrong}" />
            <TextBlock x:Uid="TodayPage_34" Grid.Column="1" Text="Task" Style="{StaticResource TypeCaptionStrong}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}" />
            <TextBlock x:Uid="TodayPage_35" Grid.Column="2" Text="Status" Style="{StaticResource TypeCaptionStrong}" Width="{StaticResource DueStatusWidth}" Visibility="{utu:Responsive Narrowest=Collapsed, Wide=Visible}" />
            <!-- Holds the action column at its 96 px in the header row too. -->
            <Border Grid.Column="3" Width="{StaticResource DueActionWidth}" />
          </Grid>
          <mvux:FeedView x:Name="DueFeed" Source="{Binding DueRows}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch" MinHeight="72">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <muxc:ItemsRepeater x:Uid="TodayPage_36" ItemsSource="{Binding Data}" AutomationProperties.Name="Due next">
                  <muxc:ItemsRepeater.ItemTemplate>
                    <DataTemplate>
                      <!-- Row: min-h 72, pad 10 8, bleeds 8 px each side, top divider, hover #F8F8F7 -->
                      <Grid Margin="-8,0" MinHeight="72" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource RowHitButton}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.OpenRow}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}" />
                        <Grid Padding="{StaticResource DueRowInset}" ColumnSpacing="{utu:Responsive Narrowest={StaticResource Space10}, Normal={StaticResource Space16}}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                          <!-- Time chip 56 x 46, radius 10 -->
                          <Grid Width="56" Height="46" HorizontalAlignment="Left" IsHitTestVisible="False">
                            <Rectangle RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" Fill="{ThemeResource PageBrush}" Stroke="{ThemeResource EdgeBrush}" StrokeThickness="1" Visibility="{Binding IsDue}" />
                            <Rectangle RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" Fill="{ThemeResource PhaseErrorSoftBrush}" Stroke="{ThemeResource PhaseErrorSoftBorderBrush}" StrokeThickness="1" Visibility="{Binding IsLate}" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                              <TextBlock Text="{Binding DueLabel}" Style="{StaticResource TypeMicro}" HorizontalAlignment="Center" Visibility="{Binding IsDue}" />
                              <TextBlock Text="{Binding DueLabel}" Style="{StaticResource TypeMicro}" FontWeight="SemiBold" Foreground="{ThemeResource PhaseErrorSolidBrush}" HorizontalAlignment="Center" Visibility="{Binding IsLate}" />
                              <TextBlock Text="{Binding Time}" Style="{StaticResource TypeMonoCell}" HorizontalAlignment="Center" />
                            </StackPanel>
                          </Grid>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource TypeTitleS}" TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                              <Grid Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Visibility="{Binding IsAnesthesia}" />
                                <Ellipse Fill="{ThemeResource PhaseRecoverySolidBrush}" Visibility="{Binding IsRecovery}" />
                                <Ellipse Fill="{ThemeResource PhasePrepSolidBrush}" Visibility="{Binding IsPrep}" />
                                <Ellipse Fill="{ThemeResource PhaseWaitingSolidBrush}" Visibility="{Binding IsWaiting}" />
                                <Ellipse Fill="{ThemeResource InkMutedBrush}" Visibility="{Binding IsHome}" />
                              </Grid>
                              <TextBlock Style="{StaticResource TypeBodyS}" TextTrimming="CharacterEllipsis"><Run Text="{Binding PatientName}" FontWeight="Medium" Foreground="{ThemeResource InkBrush}" /><Run Text=" · " /><Run Text="{Binding Meta}" /></TextBlock>
                            </StackPanel>
                            <!-- Below Wide the status column folds under the task -->
                            <TextBlock Text="{Binding Status}" Style="{StaticResource TypeBodyS}" Visibility="{utu:Responsive Narrowest=Visible, Wide=Collapsed}" />
                          </StackPanel>
                          <Grid Grid.Column="2" Width="{StaticResource DueStatusWidth}" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="{utu:Responsive Narrowest=Collapsed, Wide=Visible}">
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Visibility="{Binding IsOverdue}">
                              <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource PhaseErrorSolidBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Status}" Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource PhaseErrorSolidBrush}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Visibility="{Binding IsReady}">
                              <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconCheck}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" VerticalAlignment="Center" />
                              <TextBlock Text="{Binding Status}" Style="{StaticResource TypeBodyStrong}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" />
                            </StackPanel>
                            <TextBlock Text="{Binding Status}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Visibility="{Binding IsNeutral}" />
                          </Grid>
                          <Grid Grid.Column="3" MinWidth="{StaticResource DueActionWidth}" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource ButtonPrimaryM}" Visibility="{Binding IsPrimary}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.OpenTask}" CommandParameter="{Binding}">
                              <TextBlock Text="{Binding ActionLabel}" Style="{StaticResource TypeButtonS}" Foreground="{ThemeResource OnPrimaryInkBrush}" />
                            </Button>
                            <Button Style="{StaticResource ButtonSecondaryM}" Visibility="{Binding IsSecondary}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.OpenTask}" CommandParameter="{Binding}">
                              <TextBlock Text="{Binding ActionLabel}" Style="{StaticResource TypeButtonS}" />
                            </Button>
                          </Grid>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </muxc:ItemsRepeater.ItemTemplate>
                </muxc:ItemsRepeater>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <StackPanel AutomationProperties.AccessibilityView="Raw">
                  <Grid Height="72" ColumnDefinitions="64,*" ColumnSpacing="{StaticResource Space16}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Rectangle Style="{StaticResource Skeleton}" Width="56" Height="46" RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space8}" VerticalAlignment="Center"><Rectangle Style="{StaticResource Skeleton}" Width="160" Height="14" /><Rectangle Style="{StaticResource Skeleton}" Width="220" Height="12" /></StackPanel>
                  </Grid>
                  <Grid Height="72" ColumnDefinitions="64,*" ColumnSpacing="{StaticResource Space16}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Rectangle Style="{StaticResource Skeleton}" Width="56" Height="46" RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space8}" VerticalAlignment="Center"><Rectangle Style="{StaticResource Skeleton}" Width="120" Height="14" /><Rectangle Style="{StaticResource Skeleton}" Width="200" Height="12" /></StackPanel>
                  </Grid>
                  <Grid Height="72" ColumnDefinitions="64,*" ColumnSpacing="{StaticResource Space16}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
                    <Rectangle Style="{StaticResource Skeleton}" Width="56" Height="46" RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" />
                    <StackPanel Grid.Column="1" Spacing="{StaticResource Space8}" VerticalAlignment="Center"><Rectangle Style="{StaticResource Skeleton}" Width="140" Height="14" /><Rectangle Style="{StaticResource Skeleton}" Width="180" Height="12" /></StackPanel>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <!-- Nothing due: green check tile, "All caught up", what is next -->
                <Grid MinHeight="72" Padding="{StaticResource InsetY14}" ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space12}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" AutomationProperties.LiveSetting="Polite">
                  <Grid Width="32" Height="32" VerticalAlignment="Center">
                    <Rectangle RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" Fill="{ThemeResource PhaseAnesthesiaSoftBrush}" Stroke="{ThemeResource PhaseAnesthesiaSoftBorderBrush}" StrokeThickness="1" />
                    <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconCheck}" Foreground="{ThemeResource PhaseAnesthesiaDeepBrush}" />
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Uid="TodayPage_37" Text="All caught up" Style="{StaticResource TypeTitleS}" />
                    <TextBlock Text="{Binding DataContext.DueHeader.NextUp, ElementName=DueFeed}" Style="{StaticResource TypeBodyS}" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
            <mvux:FeedView.ErrorTemplate>
              <DataTemplate>
                <StackPanel Padding="{StaticResource InsetY14}" Spacing="{StaticResource Space10}" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Uid="TodayPage_38" Text="Couldn't work out what is due." Style="{StaticResource TypeTitleS}" />
                  <Button x:Uid="TodayPage_39" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=DueFeed}" AutomationProperties.Name="Retry reading records">
                    <TextBlock x:Uid="TodayPage_40" Text="Retry" Style="{StaticResource TypeButtonS}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
        </StackPanel>

        <!-- Where care time went: pad-left 40, left divider (dropped when stacked) -->
        <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Widest=1, Layout={StaticResource SplitLayout}}"
                    Grid.Row="{utu:Responsive Narrowest=1, Widest=0, Layout={StaticResource SplitLayout}}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}"
                    Padding="{utu:Responsive Narrowest='0', Widest={StaticResource GapStart40}, Layout={StaticResource SplitLayout}}"
                    BorderThickness="{utu:Responsive Narrowest='0', Widest='1,0,0,0', Layout={StaticResource SplitLayout}}"
                    BorderBrush="{ThemeResource DividerBrush}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource Space16}">
            <StackPanel>
              <TextBlock x:Uid="TodayPage_41" Text="Where care time went" Style="{StaticResource TypeH2Section}" />
              <TextBlock Text="{Binding CareTime.Summary}" Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" Margin="{StaticResource GapTop2}" />
            </StackPanel>
            <Grid Grid.Column="1" Background="Transparent" VerticalAlignment="Top">
              <ToolTipService.ToolTip><ToolTip x:Uid="TodayPage_42" Content="Coming soon" /></ToolTipService.ToolTip>
              <Button x:Uid="TodayPage_43" Style="{StaticResource ButtonIconSecondaryS}" IsEnabled="False" IsHitTestVisible="False" AutomationProperties.Name="Open the care time report, coming soon">
                <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconArrowUpRight}" Foreground="{ThemeResource InkBrush}" />
              </Button>
            </Grid>
          </Grid>
          <mvux:FeedView x:Name="CareFeed" Source="{Binding CareTime}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch" Margin="{StaticResource GapTop20}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Data.Bars}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="36" ColumnSpacing="{StaticResource Space12}" ToolTipService.ToolTip="{Binding Tooltip}" Background="Transparent" AutomationProperties.Name="{Binding Tooltip}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource TypeBody}" VerticalAlignment="Center" />
                          <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                            <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource TrackBrush}" />
                            <controls:SpanPanel>
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhaseAnesthesiaSolidBrush}" Visibility="{Binding IsAnesthesia}" />
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhasePrepSolidBrush}" Visibility="{Binding IsPrep}" />
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhaseRecoverySolidBrush}" Visibility="{Binding IsRecovery}" />
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PhaseWaitingSolidBrush}" Visibility="{Binding IsWaiting}" />
                            </controls:SpanPanel>
                          </Grid>
                          <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource TypeMonoNum}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource TypeBodyS}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Insight card: margin-top 24, pad 14 16, radius 14, #F3F3F2, tri-tone -->
                  <Border Style="{StaticResource QuietPanel}" Margin="{StaticResource GapTop24}" Visibility="{Binding Data.HasInsight}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space12}">
                      <Grid Width="32" Height="32" VerticalAlignment="Top">
                        <Rectangle RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" Fill="{ThemeResource PhasePrepSoftBrush}" />
                        <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconLightbulb}" Foreground="{ThemeResource PhasePrepDeepBrush}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}">
                        <TextBlock Text="{Binding Data.Insight}" Style="{StaticResource TypeBody}" TextWrapping="WrapWholeWords" />
                        <Grid Background="Transparent" HorizontalAlignment="Left">
                          <ToolTipService.ToolTip><ToolTip x:Uid="TodayPage_44" Content="Coming soon" /></ToolTipService.ToolTip>
                          <Button x:Uid="TodayPage_45" Style="{StaticResource LinkButton}" Content="See the prep checklist" IsEnabled="False" IsHitTestVisible="False" AutomationProperties.Name="See the prep checklist, coming soon" />
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <StackPanel Spacing="{StaticResource Space20}" AutomationProperties.AccessibilityView="Raw">
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <TextBlock x:Uid="TodayPage_46" Text="No care time recorded yet today." Style="{StaticResource TypeBody}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" AutomationProperties.LiveSetting="Polite" />
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
            <mvux:FeedView.ErrorTemplate>
              <DataTemplate>
                <StackPanel Spacing="{StaticResource Space10}" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Uid="TodayPage_47" Text="Couldn't total today's care time." Style="{StaticResource TypeTitleS}" />
                  <Button x:Uid="TodayPage_48" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=CareFeed}" AutomationProperties.Name="Retry reading records">
                    <TextBlock x:Uid="TodayPage_49" Text="Retry" Style="{StaticResource TypeButtonS}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
