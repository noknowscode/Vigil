<Page x:Class="Vigil.Presentation.BoardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" xmlns:controls="using:Vigil.Controls" xmlns:mvux="using:Uno.Extensions.Reactive.UI" xmlns:uen="using:Uno.Extensions.Navigation.UI" xmlns:utu="using:Uno.Toolkit.UI" Background="Transparent">
  <Page.Resources>
    <!-- Board thresholds: 600 padding, 660 live band stacks, 760 header cluster beside the title. The sidebar is the shell's (ShellPage). -->
    <utu:ResponsiveLayout x:Key="BoardLayout" Narrowest="0" Narrow="600" Normal="660" Wide="760" Widest="1120" />
  </Page.Resources>
  <!-- Today, inside the shell frame. Phase 4 rebuilds the content (hero, cards, due next, care time); the header carries the top bar cluster now. -->
    <ScrollViewer x:Name="PatientScroll" HorizontalScrollMode="Disabled">
      <StackPanel Padding="{utu:Responsive Narrowest='20,28,20,40', Narrow='40,36,40,40', Layout={StaticResource BoardLayout}}" Spacing="18">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="16">
          <StackPanel Spacing="8" Grid.Row="{utu:Responsive Narrowest=1, Wide=0, Layout={StaticResource BoardLayout}}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1, Layout={StaticResource BoardLayout}}">
            <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource CloverLabel}" />
            <TextBlock Text="{Binding Greeting.Title}" Style="{StaticResource TypeDisplayTitle}" />
            <!-- Recap of the day: the most urgent fact in bold, then the other counts. -->
            <TextBlock Style="{StaticResource TypeBodyL}" Foreground="{ThemeResource InkMutedBrush}" AutomationProperties.LiveSetting="Off"><Run Text="{Binding Greeting.Lead}" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" /><Run Text="{Binding Greeting.Rest}" /></TextBlock>
          </StackPanel>
          <controls:TopBarCluster Grid.Column="{utu:Responsive Narrowest=0, Wide=1, Layout={StaticResource BoardLayout}}" VerticalAlignment="Top" HorizontalAlignment="Left" />
        </Grid>
        <mvux:FeedView Source="{Binding Live}" RefreshingState="None" IsTabStop="False">
          <mvux:FeedView.ValueTemplate><DataTemplate>
            <Button uen:Navigation.Request="Record" uen:Navigation.Data="{Binding Data}" Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Data.AccessibleName}">
              <Grid Padding="10" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="20" CornerRadius="23" Background="{ThemeResource CloverLiveBand}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1, Layout={StaticResource BoardLayout}}" Background="{ThemeResource CloverGlass}" CornerRadius="15" Padding="12" BorderBrush="{ThemeResource CloverGlassEdge}" BorderThickness="1">
                  <StackPanel Spacing="2"><TextBlock x:Uid="Board_9" Text="IN SURGERY" Style="{StaticResource CloverLabel}" FontSize="12" LineHeight="16" Foreground="{ThemeResource CloverLiveInk}" /><TextBlock Text="{Binding Data.Name}" Style="{StaticResource CloverHeading}" Foreground="{ThemeResource OnSurfaceBrush}" FontSize="26" /><TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource CloverBody}" Foreground="{ThemeResource CloverLiveInk}" FontSize="13" /><TextBlock Text="{Binding Data.Others}" Style="{StaticResource CloverBody}" Foreground="{ThemeResource CloverLiveInk}" Visibility="{Binding Data.HasOthers}" /></StackPanel>
                </Border>
                <Grid Grid.Column="{utu:Responsive Narrowest=0, Normal=1, Layout={StaticResource BoardLayout}}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0, Layout={StaticResource BoardLayout}}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1, Layout={StaticResource BoardLayout}}" ColumnDefinitions="*,*" ColumnSpacing="16" VerticalAlignment="Center" Margin="8,6,10,6">
                  <StackPanel Spacing="5"><TextBlock x:Uid="Board_21" Text="Elapsed · h:mm" FontSize="12" Foreground="{ThemeResource CloverLiveInk}" /><TextBlock Text="{Binding Data.Elapsed}" Style="{StaticResource CodeTextStyle}" FontSize="30" Foreground="{ThemeResource PrimaryBrush}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Data.NextLabel}" FontSize="13" Foreground="{ThemeResource CloverLiveInk}" Visibility="{Binding Data.IsWaiting}" /><TextBlock Text="{Binding Data.NextLabel}" FontSize="13" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" /><TextBlock Text="{Binding Data.NextText}" Style="{StaticResource CodeTextStyle}" FontSize="25" Foreground="{ThemeResource PrimaryBrush}" /></StackPanel>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate></mvux:FeedView.ValueTemplate>
          <mvux:FeedView.NoneTemplate><DataTemplate><Border /></DataTemplate></mvux:FeedView.NoneTemplate>
          <mvux:FeedView.ErrorTemplate><DataTemplate><TextBlock x:Uid="Board_10" Text="Active case unavailable. Retry the patient list below." Style="{StaticResource CloverBody}" /></DataTemplate></mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock x:Uid="Board_5" Text="Today's patients" Style="{StaticResource CloverHeading}" FontSize="22" VerticalAlignment="Center" />
          <utu:ChipGroup Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Style="{StaticResource FilterChipGroupStyle}" SelectionMode="Single">
            <utu:Chip x:Uid="Board_11" Content="Today" IsChecked="True" Command="{Binding ShowToday}" AutomationProperties.Name="Show today's cases" />
            <utu:Chip x:Uid="Board_12" Content="All records" Command="{Binding ShowAll}" AutomationProperties.Name="Show all cases" />
          </utu:ChipGroup>
        </Grid>
        <mvux:FeedView x:Name="CasesFeed" Source="{Binding Today}" MinHeight="300" VerticalContentAlignment="Top" RefreshingState="None" IsTabStop="False">
          <mvux:FeedView.ValueTemplate><DataTemplate>
            <muxc:ItemsRepeater x:Uid="Board_13" ItemsSource="{Binding Data}" ItemTemplate="{StaticResource CaseCardTemplate}" AutomationProperties.Name="Patient cards">
              <muxc:ItemsRepeater.Layout><muxc:UniformGridLayout MaximumRowsOrColumns="3" ItemsStretch="Fill" MinItemWidth="280" MinColumnSpacing="20" MinRowSpacing="24" /></muxc:ItemsRepeater.Layout>
              
            </muxc:ItemsRepeater>
          </DataTemplate></mvux:FeedView.ValueTemplate>
          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <!-- Skeleton: three case cards at the populated card's size. -->
              <StackPanel Spacing="16">
                <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                  <StackPanel Padding="16" Spacing="10">
                    <Rectangle Width="120" Height="20" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="220" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="260" Height="16" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="100" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>
                <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                  <StackPanel Padding="16" Spacing="10">
                    <Rectangle Width="140" Height="20" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="200" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="240" Height="16" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="90" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>
                <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                  <StackPanel Padding="16" Spacing="10">
                    <Rectangle Width="100" Height="20" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="230" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="200" Height="16" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="110" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                <StackPanel Padding="24" Spacing="12" HorizontalAlignment="Left">
                  <controls:CareGreeting Width="140" Height="124" HorizontalAlignment="Left" />
                  <TextBlock x:Uid="Board_14" Style="{StaticResource TitleLarge}"
                             Foreground="{ThemeResource OnSurfaceBrush}"
                             Text="No cases today. Start the first one." />
                  <TextBlock x:Uid="Board_15" Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextWrapping="WrapWholeWords"
                             Text="A case holds one anesthetic procedure: pre-op check, doses, vitals every five minutes, recovery and sign-off." />
                  <Button x:Uid="Board_16" Style="{StaticResource OutlinedButtonStyle}"
                          HorizontalAlignment="Left"
                          Content="New case"
                          Command="{Binding DataContext.NewCase, ElementName=CasesFeed}" />
                </StackPanel>
              </utu:CardContentControl>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                <StackPanel Padding="24" Spacing="12" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="{ThemeResource ErrorBrush}" />
                    <TextBlock x:Uid="Board_17" Style="{StaticResource TitleLarge}"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               Text="Couldn't read saved records." />
                  </StackPanel>
                  <TextBlock Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextWrapping="WrapWholeWords"
                             Text="{Binding Message}" />
                  <!-- ErrorTemplate DataContext is the Exception: reach the page model by ElementName. -->
                  <Button x:Uid="Board_18" Style="{StaticResource OutlinedButtonStyle}"
                          HorizontalAlignment="Left"
                          Content="Retry"
                          AutomationProperties.Name="Retry reading records"
                          Command="{Binding DataContext.Retry, ElementName=CasesFeed}" />
                </StackPanel>
              </utu:CardContentControl>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>

        </mvux:FeedView>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0"><controls:CareMark Width="15" Height="17" /><TextBlock x:Uid="Board_20" Text="Care, continued.  ·  Clover" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
      </StackPanel>
    </ScrollViewer>
</Page>
