<Page x:Class="Vigil.Presentation.BoardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" xmlns:controls="using:Vigil.Controls" xmlns:mvux="using:Uno.Extensions.Reactive.UI" xmlns:uen="using:Uno.Extensions.Navigation.UI" xmlns:utu="using:Uno.Toolkit.UI" Background="{ThemeResource CloverCanvas}">
  <Page.Resources>
    <!-- Board thresholds: 600 frame margin, 660 live band stacks, 760 tabs drop to a second row, 1120 agenda docks (below it opens as the !Agenda flyout). -->
    <utu:ResponsiveLayout x:Key="BoardLayout" Narrowest="0" Narrow="600" Normal="660" Wide="760" Widest="1120" />
  </Page.Resources>
  <Grid x:Name="AppFrame" utu:SafeArea.Insets="VisibleBounds" Margin="{utu:Responsive Narrowest='8', Narrow='20,8,20,20', Layout={StaticResource BoardLayout}}" RowDefinitions="Auto,*">
    <Grid x:Name="TopBar" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10" Padding="12,10,12,20">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><controls:CareMark Width="25" Height="29" /><TextBlock x:Uid="Board_1" Text="clover" Style="{StaticResource CloverHeading}" FontSize="28" /></StackPanel>
      <Border x:Name="TopTabs" Grid.Column="{utu:Responsive Narrowest=0, Wide=1, Layout={StaticResource BoardLayout}}" Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1, Layout={StaticResource BoardLayout}}" Grid.Row="{utu:Responsive Narrowest=1, Wide=0, Layout={StaticResource BoardLayout}}" Background="{ThemeResource CloverSage}" CornerRadius="14" Padding="4" HorizontalAlignment="Center" VerticalAlignment="Center">
        <utu:ChipGroup Style="{StaticResource FilterChipGroupStyle}" SelectionMode="Single">
          <utu:Chip x:Uid="Board_2" x:Name="HomeTab" Content="Today's patients" IsChecked="True" AutomationProperties.Name="Today's patients" />
          <utu:Chip x:Uid="Board_3" Content="Patient care" Command="{Binding OpenPatient}" IsEnabled="{Binding CanOpenPatient}" ToolTipService.ToolTip="{Binding PatientTabHint}" AutomationProperties.Name="Open current patient care workspace" />
        </utu:ChipGroup>
      </Border>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4"><Button x:Uid="Board_22" x:Name="AgendaToggle" Style="{StaticResource CloverQuiet}" uen:Navigation.Request="!Agenda" Visibility="{utu:Responsive Narrowest=Visible, Widest=Collapsed, Layout={StaticResource BoardLayout}}" AutomationProperties.Name="Open today's agenda"><FontIcon Glyph="&#xE787;" FontSize="20" /></Button><Button x:Uid="Board_4" Style="{StaticResource CloverQuiet}" uen:Navigation.Request="Settings" AutomationProperties.Name="Settings"><FontIcon Glyph="&#xE713;" FontSize="20" /></Button></StackPanel>
    </Grid>
    <Grid x:Name="HomeWorkspace" Grid.Row="1" ColumnDefinitions="352,*" ColumnSpacing="20">
    <!-- WORKAROUND(Nested default route into a collapsed region blocks startup navigation): the dock stays Visible and
         shrinks to 0 px and disabled below 1120 instead of collapsing; remove when the Agenda route loads into a collapsed region. -->
    <ContentControl x:Name="AgendaDock" Grid.Column="0" uen:Region.Attached="True" HorizontalAlignment="Left" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Width="{utu:Responsive Narrowest=0, Widest=352, Layout={StaticResource BoardLayout}}" IsEnabled="{utu:Responsive Narrowest=False, Widest=True, Layout={StaticResource BoardLayout}}" />
      <Border x:Name="HomeShell" Grid.Column="{utu:Responsive Narrowest=0, Widest=1, Layout={StaticResource BoardLayout}}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource BoardLayout}}" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1" CornerRadius="{utu:Responsive Narrowest=24, Wide=32, Layout={StaticResource BoardLayout}}">
    <ScrollViewer x:Name="PatientScroll" HorizontalScrollMode="Disabled">
      <StackPanel MaxWidth="1680" Padding="{utu:Responsive Narrow='20,28,20,40', Wide='28,26,26,40'}" Spacing="18">
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding TodayLabel}" Style="{StaticResource CloverLabel}" />
            <TextBlock x:Uid="Board_5" Text="Today's patients" Style="{StaticResource CloverDisplay}" FontSize="{utu:Responsive Narrowest=34, Wide=42}" />
            <TextBlock x:Uid="Board_6" Text="A little more comfort. A lot of care." Style="{StaticResource CloverBody}" FontSize="16" />
          </StackPanel>
          <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center"><controls:CareGreeting Width="100" Height="94" Visibility="{utu:Responsive Narrowest=Collapsed, Wide=Visible}" /><Button x:Name="PatientNewButton" x:Uid="Board_7" Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource CloverPrimary}" Command="{Binding NewCase}" Content="＋  New patient" AutomationProperties.Name="New patient record" /></StackPanel>
        </Grid>
        <mvux:FeedView Source="{Binding Live}" RefreshingState="None" IsTabStop="False">
          <mvux:FeedView.ValueTemplate><DataTemplate>
            <Button uen:Navigation.Request="Record" uen:Navigation.Data="{Binding Data}" Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" AutomationProperties.Name="{Binding Data.AccessibleName}">
              <Grid Padding="10" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="20" CornerRadius="23" Background="{ThemeResource CloverLiveBand}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1, Layout={StaticResource BoardLayout}}" Background="{ThemeResource CloverGlass}" CornerRadius="15" Padding="12" BorderBrush="{ThemeResource CloverGlassEdge}" BorderThickness="1">
                  <StackPanel Spacing="2"><TextBlock x:Uid="Board_9" Text="IN SURGERY" Style="{StaticResource CloverLabel}" FontSize="12" LineHeight="16" Foreground="{ThemeResource CloverLiveInk}" /><TextBlock Text="{Binding Data.Name}" Style="{StaticResource CloverHeading}" Foreground="{ThemeResource OnSurfaceBrush}" FontSize="26" /><TextBlock Text="{Binding Data.Procedure}" Style="{StaticResource CloverBody}" Foreground="{ThemeResource CloverLiveInk}" FontSize="13" /><TextBlock Text="{Binding Data.Others}" Style="{StaticResource CloverBody}" Foreground="{ThemeResource CloverLiveInk}" Visibility="{Binding Data.HasOthers}" /></StackPanel>
                </Border>
                <Grid Grid.Column="{utu:Responsive Narrowest=0, Normal=1, Layout={StaticResource BoardLayout}}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0, Layout={StaticResource BoardLayout}}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Normal=1, Layout={StaticResource BoardLayout}}" ColumnDefinitions="*,*" ColumnSpacing="16" VerticalAlignment="Center" Margin="8,6,10,6">
                  <StackPanel Spacing="5"><TextBlock x:Uid="Board_21" Text="Elapsed · h:mm" FontSize="12" Foreground="{ThemeResource CloverLiveInk}" /><TextBlock Text="{Binding Data.Elapsed}" Style="{StaticResource CodeTextStyle}" FontSize="30" Foreground="{ThemeResource PrimaryBrush}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="7"><TextBlock Text="{Binding Data.NextLabel}" FontSize="13" Foreground="{ThemeResource CloverLiveInk}" Visibility="{Binding Data.IsWaiting}" /><TextBlock Text="{Binding Data.NextLabel}" FontSize="13" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" /><TextBlock Text="{Binding Data.NextText}" Style="{StaticResource CodeTextStyle}" FontSize="25" Foreground="{ThemeResource PrimaryBrush}" /></StackPanel>
                </Grid>
              </Grid>
            </Button>
          </DataTemplate></mvux:FeedView.ValueTemplate>
          <mvux:FeedView.NoneTemplate><DataTemplate><Border /></DataTemplate></mvux:FeedView.NoneTemplate>
          <mvux:FeedView.ErrorTemplate><DataTemplate><TextBlock x:Uid="Board_10" Text="Active case unavailable. Retry the patient list below." Style="{StaticResource CloverBody}" /></DataTemplate></mvux:FeedView.ErrorTemplate>
        </mvux:FeedView>
        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="12">
          <TextBlock Text="{Binding DaySummary}" Style="{StaticResource CloverBody}" VerticalAlignment="Center" />
          <utu:ChipGroup Grid.Column="{utu:Responsive Narrowest=0, Normal=1}" Grid.Row="{utu:Responsive Narrowest=1, Normal=0}" Style="{StaticResource FilterChipGroupStyle}" SelectionMode="Single">
            <utu:Chip x:Uid="Board_11" Content="Today" IsChecked="True" Command="{Binding ShowToday}" AutomationProperties.Name="Show today's cases" />
            <utu:Chip x:Uid="Board_12" Content="All records" Command="{Binding ShowAll}" AutomationProperties.Name="Show all cases" />
          </utu:ChipGroup>
        </Grid>
        <mvux:FeedView x:Name="CasesFeed" Source="{Binding Today}" MinHeight="300" VerticalContentAlignment="Top" RefreshingState="None" IsTabStop="False">
          <mvux:FeedView.ValueTemplate><DataTemplate>
            <muxc:ItemsRepeater x:Uid="Board_13" ItemsSource="{Binding Data}" AutomationProperties.Name="Patient cards">
              <muxc:ItemsRepeater.Layout><muxc:UniformGridLayout MaximumRowsOrColumns="3" ItemsStretch="Fill" MinItemWidth="280" MinColumnSpacing="20" MinRowSpacing="24" /></muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource CloverPatientCard}" HorizontalAlignment="Stretch" uen:Navigation.Request="Record" uen:Navigation.Data="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                  <StackPanel>
                    <Grid Height="236" CornerRadius="23,23,0,0" Background="{ThemeResource CloverSky}">
                      <controls:PetBackdrop Photo="{Binding Photo}" />
                      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{Binding HasNoPhoto}">
                        <TextBlock Text="{Binding Initials}" Style="{StaticResource CloverDisplay}" FontSize="70" HorizontalAlignment="Center" Foreground="{ThemeResource OnSurfaceBrush}" />
                        <TextBlock x:Uid="Board_19" Text="PHOTO NOT ADDED" Style="{StaticResource CloverLabel}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                      <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" CornerRadius="16" Background="{ThemeResource CloverGlass}" Padding="12,7">
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource CloverBody}" Foreground="{ThemeResource OnSurfaceBrush}" FontSize="13" />
                      </Border>
                      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14" Background="{ThemeResource CloverGlass}" Width="36" Height="36" CornerRadius="18"><FontIcon Glyph="&#xE8A7;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" /></Border>
                    </Grid>
                    <StackPanel Padding="20,18,20,20" Spacing="14">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource CloverEditorialFont}" FontSize="32" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1" Background="{ThemeResource CloverSage}" CornerRadius="10" Padding="8,4" VerticalAlignment="Center"><TextBlock Text="{Binding Asa}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" Foreground="{ThemeResource PrimaryBrush}" /></Border>
                      </Grid>
                      <Grid ColumnDefinitions=".8*,1.4*,.85*" ColumnSpacing="10">
                        <StackPanel Spacing="4"><TextBlock x:Uid="Board_27" Text="SPECIES" Style="{StaticResource CloverIdLabel}" /><TextBlock Text="{Binding SpeciesText}" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Uid="Board_31" Text="BREED" Style="{StaticResource CloverIdLabel}" /><TextBlock Text="{Binding Breed}" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}" /></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4" ToolTipService.ToolTip="{Binding WeightDate}"><TextBlock x:Uid="Board_38" Text="WEIGHT" Style="{StaticResource CloverIdLabel}" /><TextBlock Text="{Binding Weight}" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}" /></StackPanel>
                      </Grid>
                      <Grid ColumnDefinitions=".8*,2.25*" ColumnSpacing="10">
                        <StackPanel Spacing="4"><TextBlock x:Uid="Board_39" Text="AGE" Style="{StaticResource CloverIdLabel}" /><TextBlock Text="{Binding Age}" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}" /></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4"><TextBlock x:Uid="Board_40" Text="PET PARENT" Style="{StaticResource CloverIdLabel}" /><TextBlock Text="{Binding Owner}" Style="{StaticResource CloverBody}" FontSize="13" Foreground="{ThemeResource OnSurfaceBrush}" /></StackPanel>
                      </Grid>
                      <Border BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                        <StackPanel Spacing="6"><TextBlock x:Uid="Board_41" Text="PROCEDURE" Style="{StaticResource CloverIdLabel}" /><TextBlock Text="{Binding Procedure}" FontFamily="{StaticResource CloverEditorialFont}" FontStyle="Italic" FontSize="19" LineHeight="25" TextWrapping="Wrap" Foreground="{ThemeResource OnSurfaceBrush}" /></StackPanel>
                      </Border>
                      <StackPanel Spacing="5"><TextBlock Text="{Binding TimeText}" Style="{StaticResource CloverLabel}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" CharacterSpacing="0" /><TextBlock Text="{Binding Team}" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
                    </StackPanel>
                  </StackPanel>
                </Button>
              </DataTemplate></muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate></mvux:FeedView.ValueTemplate>
          <mvux:FeedView.ProgressTemplate>
            <DataTemplate>
              <!-- Skeleton: three case cards at the populated card's size. -->
              <StackPanel Spacing="16">
                <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                  <StackPanel Padding="16" Spacing="10">
                    <Rectangle Width="120" Height="20" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="220" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="260" Height="16" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="100" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>
                <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                  <StackPanel Padding="16" Spacing="10">
                    <Rectangle Width="140" Height="20" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="200" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="240" Height="16" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="90" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>
                <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                  <StackPanel Padding="16" Spacing="10">
                    <Rectangle Width="100" Height="20" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="230" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="200" Height="16" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                    <Rectangle Width="110" Height="14" HorizontalAlignment="Left" RadiusX="6" RadiusY="6" Fill="{ThemeResource SurfaceVariantBrush}" />
                  </StackPanel>
                </utu:CardContentControl>
              </StackPanel>
            </DataTemplate>
          </mvux:FeedView.ProgressTemplate>

          <mvux:FeedView.NoneTemplate>
            <DataTemplate>
              <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                <StackPanel Padding="24" Spacing="12" HorizontalAlignment="Left">
                  <controls:CareGreeting Width="140" Height="124" HorizontalAlignment="Left" />
                  <TextBlock x:Uid="Board_14" Style="{StaticResource TitleLarge}"
                             Foreground="{ThemeResource OnSurfaceBrush}"
                             Text="No cases today. Start the first one." />
                  <TextBlock x:Uid="Board_15" Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextWrapping="WrapWholeWords"
                             Text="A case holds one anesthetic procedure: pre-op check, doses, vitals every five minutes, recovery and sign-off." />
                  <Button x:Uid="Board_16" Style="{StaticResource OutlinedButtonStyle}"
                          HorizontalAlignment="Left"
                          Content="New case"
                          Command="{Binding DataContext.NewCase, ElementName=CasesFeed}" />
                </StackPanel>
              </utu:CardContentControl>
            </DataTemplate>
          </mvux:FeedView.NoneTemplate>

          <mvux:FeedView.ErrorTemplate>
            <DataTemplate>
              <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" HorizontalAlignment="Stretch" IsTabStop="False">
                <StackPanel Padding="24" Spacing="12" HorizontalAlignment="Left">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE783;" FontSize="20" Foreground="{ThemeResource ErrorBrush}" />
                    <TextBlock x:Uid="Board_17" Style="{StaticResource TitleLarge}"
                               Foreground="{ThemeResource OnSurfaceBrush}"
                               Text="Couldn't read saved records." />
                  </StackPanel>
                  <TextBlock Style="{StaticResource BodyMedium}"
                             Foreground="{ThemeResource OnSurfaceVariantBrush}"
                             TextWrapping="WrapWholeWords"
                             Text="{Binding Message}" />
                  <!-- ErrorTemplate DataContext is the Exception: reach the page model by ElementName. -->
                  <Button x:Uid="Board_18" Style="{StaticResource OutlinedButtonStyle}"
                          HorizontalAlignment="Left"
                          Content="Retry"
                          AutomationProperties.Name="Retry reading records"
                          Command="{Binding DataContext.Retry, ElementName=CasesFeed}" />
                </StackPanel>
              </utu:CardContentControl>
            </DataTemplate>
          </mvux:FeedView.ErrorTemplate>

        </mvux:FeedView>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0"><controls:CareMark Width="15" Height="17" /><TextBlock x:Uid="Board_20" Text="Care, continued.  ·  Clover" Style="{StaticResource CloverBody}" FontSize="13" /></StackPanel>
      </StackPanel>
    </ScrollViewer>

      </Border>
    </Grid>
  </Grid>
</Page>
