<!--
  Today (route Main/Today), docs/design/today-dashboard-values.md. Header, "Right now" hero (live case or next
  surgery, care gantt), today's patient cards, "Due next" and "Where care time went". Every async block is a FeedView
  inside its own section shell: Progress = skeleton, None = the block's empty copy, Error = message + Retry
  (Retry → BoardModel.Retry → Store.Reload; ErrorTemplate's DataContext is the exception, so it binds by ElementName).
  Breakpoints (Styles/Layout.xaml): the header stacks below Widest; the hero and bottom splits stack below SplitLayout's
  Widest (1280, the full sidebar's page needs it); cards fit 3 / 2 / 1 columns by width (CardColumnsLayout, 320 px
  minimum); the Due next status column folds under the task below Wide; phones stack the section headers.
-->
<Page x:Class="Vigil.Presentation.BoardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:controls="using:Vigil.Controls"
      xmlns:local="using:Vigil.Presentation"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Transparent">
  <Page.Resources>
    <!-- Segmented control segment (.seg): 30 px, radius 8; the selected chrome lives in the content (seg-on shadow).
         xaml-lint: allow template - hover ink 5 % under a content-drawn selected surface -->
    <Style x:Key="SegmentButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="{StaticResource Radius8}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal" />
                  <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource OnSurfaceHoverBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Root.Background" Value="{ThemeResource OnSurfacePressedBrush}" /></VisualState.Setters></VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter Content="{TemplateBinding Content}" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="QuietPanel" TargetType="Border">
      <Setter Property="CornerRadius" Value="{StaticResource Radius14}" />
      <Setter Property="Padding" Value="{StaticResource QuietPanelInset}" />
      <Setter Property="Background" Value="{ThemeResource BackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{ThemeResource OutlineVariantBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Page.Resources>

  <ScrollViewer x:Name="TodayScroll" HorizontalScrollMode="Disabled">
    <StackPanel Padding="{utu:Responsive Narrowest={StaticResource PageInsetNarrow}, Normal={StaticResource PageInsetNormal}}" MaxWidth="{StaticResource ContentMaxWidth}">

      <!-- 1. Header: greeting + recap -->
      <StackPanel>
        <!-- Newsreader sits 4 px lower than the browser places it at 40/46: pulled up to the render. -->
        <TextBlock Text="{Binding Greeting.Title}" Style="{StaticResource HeadlineLarge}" TextWrapping="WrapWholeWords" Margin="0,-4,0,0" />
        <!-- Recap: the most urgent fact in bold, then the other counts. -->
        <TextBlock Margin="{StaticResource GapTop10}" Style="{StaticResource BodyLarge}" TextWrapping="WrapWholeWords" Foreground="{ThemeResource OnSurfaceVariantBrush}" AutomationProperties.LiveSetting="Off"><Run Text="{Binding Greeting.Lead}" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" /><Run Text="{Binding Greeting.Rest}" /></TextBlock>
      </StackPanel>

      <!-- A failed action (Start prep) says why, above the hero, until dismissed. -->
      <muxc:InfoBar x:Uid="Board_1" Margin="{StaticResource HeroTopGap}" Severity="Error" Title="Not saved" Message="{Binding ActionError}" IsOpen="{Binding HasActionError}" IsClosable="False"
                    Visibility="{Binding HasActionError, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
        <muxc:InfoBar.ActionButton>
          <Button x:Uid="Board_2" Content="Dismiss" Command="{Binding DismissError}" />
        </muxc:InfoBar.ActionButton>
      </muxc:InfoBar>

      <!-- 2. Hero "Right now": live card (448) | under care today + gantt; stacks below 1080 (TodayHeroView) -->
      <local:TodayHeroView />

      <!-- 3. Today's patients: header (segmented filter, All records), 3 / 2 / 1 column card grid -->
      <!-- Below Wide the title and All records share the first row and the filter takes the second; from Wide one row. -->
      <Grid Margin="{StaticResource GapTop40}" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="{StaticResource Space16}" RowSpacing="{utu:Responsive Narrowest={StaticResource Space12}, Wide=0}">
        <TextBlock x:Uid="TodayPage_21" Text="Today's patients" Style="{StaticResource TitleMedium}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space16}" VerticalAlignment="Center" HorizontalAlignment="Left"
                    Grid.Column="{utu:Responsive Narrowest=0, Wide=1}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=3, Wide=1}"
                    Grid.Row="{utu:Responsive Narrowest=1, Wide=0}">
          <!-- Segmented control: pad 3, radius 11, #F3F3F2, border #E8E8EA, gap 2 -->
          <!-- xaml-lint: allow card - segmented-control track, not a surface -->
          <Border x:Uid="TodayPage_22" Padding="{StaticResource Inset3}" CornerRadius="{StaticResource Radius11}" Background="{ThemeResource BackgroundBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" AutomationProperties.Name="Filter patients">
            <ItemsControl ItemsSource="{Binding Tabs}" IsTabStop="False">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="{StaticResource Space2}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Style="{StaticResource SegmentButton}" Command="{utu:AncestorBinding AncestorType=Page, Path=DataContext.ShowFilter}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid>
                      <utu:ShadowContainer Background="{ThemeResource SurfaceBrush}" CornerRadius="{StaticResource Radius8}" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" Shadows="{StaticResource ShadowSegOn}">
                        <Border CornerRadius="{StaticResource Radius8}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" />
                      </utu:ShadowContainer>
                      <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}" Padding="{StaticResource InsetX12}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" FontWeight="SemiBold" Visibility="{Binding IsSelected, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                        <TextBlock Text="{Binding Label}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceBrush}" FontWeight="Medium" Visibility="{Binding IsUnselected, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                        <TextBlock Text="{Binding Count}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
        </StackPanel>
        <Button x:Uid="TodayPage_23" Grid.Column="2" Style="{StaticResource LinkButton}" Content="All records" Command="{Binding OpenPatients}" VerticalAlignment="Center" />
      </Grid>
      <mvux:FeedView x:Name="CardsFeed" Source="{Binding Cards}" Margin="{StaticResource GapTop16}" MinHeight="227" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
        <mvux:FeedView.ValueTemplate>
          <DataTemplate>
            <muxc:ItemsRepeater x:Uid="TodayPage_24" ItemsSource="{Binding Data}" AutomationProperties.Name="Patient cards">
              <muxc:ItemsRepeater.Layout><controls:CardColumnsLayout MinColumnWidth="{StaticResource CardMinColumnWidth}" MaxColumns="3" ColumnSpacing="{StaticResource Space24}" RowSpacing="{StaticResource Space24}" /></muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate><local:PatientCardView /></DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>
        </mvux:FeedView.ValueTemplate>
        <mvux:FeedView.ProgressTemplate>
          <DataTemplate>
            <!-- Skeleton: the collapsed card's footprint (photo, two text bars, strip, stepper, toggle), 227 px -->
            <muxc:ItemsRepeater ItemsSource="{Binding DataContext.Skeleton, ElementName=CardsFeed}" AutomationProperties.AccessibilityView="Raw">
              <muxc:ItemsRepeater.Layout><controls:CardColumnsLayout MinColumnWidth="{StaticResource CardMinColumnWidth}" MaxColumns="3" ColumnSpacing="{StaticResource Space24}" RowSpacing="{StaticResource Space24}" /></muxc:ItemsRepeater.Layout>
              <muxc:ItemsRepeater.ItemTemplate>
                <DataTemplate>
                  <!-- xaml-lint: allow card - skeleton of the patient card shell -->
                  <Border Height="227" CornerRadius="{StaticResource Radius22}" Background="{ThemeResource SurfaceVariantBrush}" BorderBrush="{ThemeResource OutlineVariantBrush}" BorderThickness="1" Padding="{StaticResource CardSkeletonInset}">
                    <Grid RowDefinitions="44,Auto,Auto,*" RowSpacing="{StaticResource Space12}">
                      <Grid ColumnDefinitions="88,*" ColumnSpacing="{StaticResource Space12}">
                        <Rectangle Style="{StaticResource Skeleton}" Width="88" Height="44" RadiusX="{StaticResource RectRadius12}" RadiusY="{StaticResource RectRadius12}" />
                        <StackPanel Grid.Column="1" Spacing="{StaticResource Space8}" VerticalAlignment="Center">
                          <Rectangle Style="{StaticResource Skeleton}" Width="90" Height="16" />
                          <Rectangle Style="{StaticResource Skeleton}" Width="150" Height="12" />
                        </StackPanel>
                      </Grid>
                      <Rectangle Grid.Row="1" Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="44" RadiusX="{StaticResource RectRadius12}" RadiusY="{StaticResource RectRadius12}" />
                      <Rectangle Grid.Row="2" Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="6" Margin="{StaticResource SkeletonStepperMargin}" />
                      <Rectangle Grid.Row="3" Style="{StaticResource Skeleton}" HorizontalAlignment="Center" Width="100" Height="12" VerticalAlignment="Center" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </muxc:ItemsRepeater.ItemTemplate>
            </muxc:ItemsRepeater>
          </DataTemplate>
        </mvux:FeedView.ProgressTemplate>
        <mvux:FeedView.NoneTemplate>
          <DataTemplate>
            <Border Style="{StaticResource QuietPanel}" MinHeight="227" Padding="{StaticResource Inset24}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="{StaticResource Space8}" AutomationProperties.LiveSetting="Polite">
                <TextBlock Text="{Binding DataContext.CardsEmpty.Title, ElementName=CardsFeed}" Style="{StaticResource LabelLarge}" TextWrapping="WrapWholeWords" />
                <TextBlock Text="{Binding DataContext.CardsEmpty.Body, ElementName=CardsFeed}" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" />
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space10}" Margin="{StaticResource GapTop8}" Visibility="{Binding DataContext.CardsEmpty.ShowActions, ElementName=CardsFeed, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                  <Button x:Uid="TodayPage_25" Style="{StaticResource ButtonPrimaryM}" Command="{Binding DataContext.NewCase, ElementName=CardsFeed}" AutomationProperties.Name="New patient">
                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space6}">
                      <TextBlock x:Uid="TodayPage_26" Text="New patient" Style="{StaticResource LabelMedium}" Foreground="{ThemeResource OnPrimaryBrush}" VerticalAlignment="Center" />
                      <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconPlus}" Foreground="{ThemeResource OnPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource ButtonSecondaryM}" Command="{Binding DataContext.OpenAgenda, ElementName=CardsFeed}">
                    <TextBlock x:Uid="TodayPage_27" Text="Open agenda" Style="{StaticResource LabelMedium}" VerticalAlignment="Center" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </mvux:FeedView.NoneTemplate>
        <mvux:FeedView.ErrorTemplate>
          <DataTemplate>
            <Border Style="{StaticResource QuietPanel}" MinHeight="227" Padding="{StaticResource Inset24}">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="{StaticResource Space10}" AutomationProperties.LiveSetting="Polite">
                <StackPanel Orientation="Horizontal" Spacing="{StaticResource Space8}">
                  <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource ErrorBrush}" VerticalAlignment="Center" />
                  <TextBlock x:Uid="TodayPage_28" Text="Couldn't read saved records." Style="{StaticResource LabelLarge}" />
                </StackPanel>
                <Button x:Uid="TodayPage_29" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=CardsFeed}" AutomationProperties.Name="Retry reading records">
                  <TextBlock x:Uid="TodayPage_30" Text="Retry" Style="{StaticResource LabelMedium}" />
                </Button>
              </StackPanel>
            </Border>
          </DataTemplate>
        </mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>

      <!-- 4. Bottom split: Due next (1.55fr) | Where care time went (1fr, left divider + 40); stacks below SplitLayout's Widest -->
      <Grid Margin="{StaticResource GapTop48}" RowDefinitions="Auto,Auto"
            ColumnSpacing="{utu:Responsive Narrowest=0, Widest={StaticResource Space40}, Layout={StaticResource SplitLayout}}"
            RowSpacing="{utu:Responsive Narrowest={StaticResource Space40}, Widest=0, Layout={StaticResource SplitLayout}}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

        <local:DueNextView Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}" />

        <!-- Where care time went: pad-left 40, left divider (dropped when stacked) -->
        <StackPanel Grid.Column="{utu:Responsive Narrowest=0, Widest=1, Layout={StaticResource SplitLayout}}"
                    Grid.Row="{utu:Responsive Narrowest=1, Widest=0, Layout={StaticResource SplitLayout}}"
                    Grid.ColumnSpan="{utu:Responsive Narrowest=2, Widest=1, Layout={StaticResource SplitLayout}}"
                    Padding="{utu:Responsive Narrowest='0', Widest={StaticResource GapStart40}, Layout={StaticResource SplitLayout}}"
                    BorderThickness="{utu:Responsive Narrowest='0', Widest='1,0,0,0', Layout={StaticResource SplitLayout}}"
                    BorderBrush="{ThemeResource OutlineVariantBrush}">
          <StackPanel>
            <TextBlock x:Uid="TodayPage_41" Text="Where care time went" Style="{StaticResource TitleMedium}" />
            <TextBlock Text="{Binding CareTime.Summary}" Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" Margin="{StaticResource GapTop2}" />
          </StackPanel>
          <mvux:FeedView x:Name="CareFeed" Source="{Binding CareTime}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch" Margin="{StaticResource GapTop20}">
            <mvux:FeedView.ValueTemplate>
              <DataTemplate>
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Data.Bars}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid Height="36" ColumnSpacing="{StaticResource Space12}" ToolTipService.ToolTip="{Binding Tooltip}" Background="Transparent" AutomationProperties.Name="{Binding Tooltip}">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Label}" Style="{StaticResource BodyMedium}" VerticalAlignment="Center" />
                          <Grid Grid.Column="1" Height="8" VerticalAlignment="Center">
                            <Rectangle RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource SurfaceVariantBrush}" />
                            <controls:SpanPanel>
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource AnesthesiaBrush}" Visibility="{Binding IsAnesthesia, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource PrepBrush}" Visibility="{Binding IsPrep, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource RecoveryBrush}" Visibility="{Binding IsRecovery, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                              <Rectangle controls:SpanPanel.Start="0" controls:SpanPanel.Length="{Binding Fraction}" Height="8" RadiusX="{StaticResource RectRadius4}" RadiusY="{StaticResource RectRadius4}" Fill="{ThemeResource WaitingBrush}" Visibility="{Binding IsWaiting, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}" />
                            </controls:SpanPanel>
                          </Grid>
                          <TextBlock Grid.Column="2" Text="{Binding DurationText}" Style="{StaticResource NumeralBodySmall}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource BodySmall}" Foreground="{ThemeResource OnSurfaceVariantBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Insight card: margin-top 24, pad 14 16, radius 14, #F3F3F2, tri-tone -->
                  <Border Style="{StaticResource QuietPanel}" Margin="{StaticResource GapTop24}" Visibility="{Binding Data.HasInsight, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Space12}">
                      <Grid Width="32" Height="32" VerticalAlignment="Top">
                        <Rectangle RadiusX="{StaticResource RectRadius10}" RadiusY="{StaticResource RectRadius10}" Fill="{ThemeResource PrepContainerBrush}" />
                        <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconLightbulb}" Foreground="{ThemeResource OnPrepContainerBrush}" />
                      </Grid>
                      <StackPanel Grid.Column="1" Spacing="{StaticResource Space4}">
                        <TextBlock Text="{Binding Data.Insight}" Style="{StaticResource BodyMedium}" TextWrapping="WrapWholeWords" />
                        <!-- The next case to prepare, on its record's Preparation drawer; hidden when nothing is booked. -->
                        <Button x:Uid="TodayPage_45" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Content="See the prep checklist" Visibility="{Binding Data.HasChecklist, Converter={StaticResource VisibleWhenTrue}, FallbackValue=Collapsed}"
                                Command="{Binding DataContext.OpenPrepChecklist, ElementName=CareFeed}" AutomationProperties.Name="{Binding Data.ChecklistName}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ProgressTemplate>
              <DataTemplate>
                <StackPanel Spacing="{StaticResource Space20}" AutomationProperties.AccessibilityView="Raw">
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="16" />
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.NoneTemplate>
              <DataTemplate>
                <TextBlock x:Uid="TodayPage_46" Text="No care time recorded yet today." Style="{StaticResource BodyMedium}" Foreground="{ThemeResource OnSurfaceVariantBrush}" TextWrapping="WrapWholeWords" AutomationProperties.LiveSetting="Polite" />
              </DataTemplate>
            </mvux:FeedView.NoneTemplate>
            <mvux:FeedView.ErrorTemplate>
              <DataTemplate>
                <StackPanel Spacing="{StaticResource Space10}" AutomationProperties.LiveSetting="Polite">
                  <TextBlock x:Uid="TodayPage_47" Text="Couldn't total today's care time." Style="{StaticResource LabelLarge}" />
                  <Button x:Uid="TodayPage_48" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=CareFeed}" AutomationProperties.Name="Retry reading records">
                    <TextBlock x:Uid="TodayPage_49" Text="Retry" Style="{StaticResource LabelMedium}" />
                  </Button>
                </StackPanel>
              </DataTemplate>
            </mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
        </StackPanel>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
