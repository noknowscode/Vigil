<!--
  Agenda (sidebar destination, route Main/Agenda). v2 utility layout, as Patients and Settings: serif title, the date
  and clock as the subtitle, the top-bar cluster; then panel cards. Left: recorded intervals (care ruler) over the
  patients in preparation. Right (stacked below Wide): the next observation reminder with its one call to action.
-->
<Page x:Class="Vigil.Presentation.AgendaPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:controls="using:Vigil.Controls"
      xmlns:mvux="using:Uno.Extensions.Reactive.UI"
      xmlns:uen="using:Uno.Extensions.Navigation.UI"
      xmlns:utu="using:Uno.Toolkit.UI"
      Background="Transparent">

  <ScrollViewer x:Name="AgendaScroll" HorizontalScrollMode="Disabled">
    <StackPanel Padding="{utu:Responsive Narrowest='20,28,20,40', Narrow='40,36,40,40'}" Spacing="24">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="24" RowSpacing="16">
        <StackPanel Spacing="8" Grid.Row="{utu:Responsive Narrowest=1, Wide=0}" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1}">
          <TextBlock x:Uid="Agenda_1" Text="Agenda" Style="{StaticResource TypeDisplayTitle}" />
          <TextBlock Style="{StaticResource TypeBodyL}" Foreground="{ThemeResource InkMutedBrush}">
            <Run Text="{Binding AgendaDate}" /><Run Text=" · " /><Run Text="{Binding AgendaClock}" FontFamily="{StaticResource FontMono}" />
          </TextBlock>
        </StackPanel>
        <controls:TopBarCluster Grid.Column="{utu:Responsive Narrowest=0, Wide=1}" VerticalAlignment="Top" HorizontalAlignment="Left" />
      </Grid>

      <Grid ColumnDefinitions="3*,2*" ColumnSpacing="20" RowSpacing="20" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="20" Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1, Layout={StaticResource ShellLayout}}">
          <!-- Recorded intervals: the care ruler (CareRuler: anaesthesia green, recovery blue; gaps are unrecorded care). -->
          <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
            <mvux:FeedView x:Name="AgendaFeed" Source="{Binding CareRhythm}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
              <mvux:FeedView.ValueTemplate><DataTemplate>
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Uid="Agenda_2" Text="Recorded intervals" Style="{StaticResource TypeH3Card}" />
                    <TextBlock Grid.Column="1" Text="{Binding Data.Range}" Style="{StaticResource TypeMonoMeta}" VerticalAlignment="Center" />
                  </Grid>
                  <!-- xaml-lint: allow card - 10 px legend swatches for the ruler colours -->
                  <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="10" Height="10" CornerRadius="3" Background="{ThemeResource CloverMint}" BorderBrush="{ThemeResource CloverMintEdge}" BorderThickness="1" VerticalAlignment="Center" /><TextBlock x:Uid="Agenda_3" Text="Anaesthesia" Style="{StaticResource TypeCaption}" Foreground="{ThemeResource InkMutedBrush}" /></StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6"><Border Width="10" Height="10" CornerRadius="3" Background="{ThemeResource CloverLavender}" BorderBrush="{ThemeResource CloverLavenderEdge}" BorderThickness="1" VerticalAlignment="Center" /><TextBlock x:Uid="Agenda_4" Text="Recovery" Style="{StaticResource TypeCaption}" Foreground="{ThemeResource InkMutedBrush}" /></StackPanel>
                  </StackPanel>
                  <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><controls:CareRuler Data="{Binding Data}" /></ScrollViewer>
                  <TextBlock x:Uid="Agenda_5" Text="Gaps indicate no recorded care." Style="{StaticResource TypeCaption}" Foreground="{ThemeResource InkMutedBrush}" />
                </StackPanel>
              </DataTemplate></mvux:FeedView.ValueTemplate>
              <mvux:FeedView.ProgressTemplate><DataTemplate>
                <StackPanel Spacing="14" AutomationProperties.AccessibilityView="Raw">
                  <Rectangle Style="{StaticResource Skeleton}" Width="160" Height="20" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="120" />
                </StackPanel>
              </DataTemplate></mvux:FeedView.ProgressTemplate>
              <mvux:FeedView.ErrorTemplate><DataTemplate>
                <StackPanel Spacing="10">
                  <TextBlock x:Uid="Agenda_6" Text="Agenda couldn't be loaded." Style="{StaticResource TypeH3Card}" />
                  <Button x:Uid="Agenda_7" Content="Retry" Style="{StaticResource ButtonSecondaryM}" HorizontalAlignment="Left" Command="{Binding DataContext.Retry, ElementName=AgendaFeed}" />
                </StackPanel>
              </DataTemplate></mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>
          </utu:CardContentControl>

          <!-- In preparation: one row per patient, opening the record. -->
          <utu:CardContentControl Style="{StaticResource PanelCardStyle}">
            <mvux:FeedView Source="{Binding Agenda}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
              <mvux:FeedView.ValueTemplate><DataTemplate>
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock x:Uid="Agenda_8" Text="In preparation" Style="{StaticResource TypeH3Card}" />
                    <Border Grid.Column="1" Style="{StaticResource BadgeNeutral}" VerticalAlignment="Center"><TextBlock x:Uid="Agenda_9" Text="Untimed" Style="{StaticResource TypeCaptionStrong}" /></Border>
                  </Grid>
                  <muxc:ItemsRepeater ItemsSource="{Binding Data.Preparing}" Margin="-8,0">
                    <muxc:ItemsRepeater.Layout><muxc:StackLayout Spacing="2" /></muxc:ItemsRepeater.Layout>
                    <muxc:ItemsRepeater.ItemTemplate><DataTemplate>
                      <Button Style="{StaticResource RowLinkButton}" uen:Navigation.Request="Record" uen:Navigation.Data="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                          <Grid Width="40" Height="40" CornerRadius="20" Background="{ThemeResource MediaPlaceholderBrush}" VerticalAlignment="Center">
                            <controls:PetBackdrop Photo="{Binding Photo}" />
                            <TextBlock Text="{Binding Initial}" Visibility="{Binding HasNoPhoto}" Style="{StaticResource TypeBodyStrong}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                          </Grid>
                          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource TypeTitleS}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <ContentControl Grid.Column="2" Style="{StaticResource LineIcon16}" Content="{StaticResource IconChevronRight}" Foreground="{ThemeResource IconMutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                      </Button>
                    </DataTemplate></muxc:ItemsRepeater.ItemTemplate>
                  </muxc:ItemsRepeater>
                  <TextBlock x:Uid="Agenda_10" Text="No patients waiting for preparation." Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" Visibility="{Binding Data.NoPreparing}" />
                </StackPanel>
              </DataTemplate></mvux:FeedView.ValueTemplate>
              <mvux:FeedView.ProgressTemplate><DataTemplate>
                <StackPanel Spacing="10" AutomationProperties.AccessibilityView="Raw">
                  <Rectangle Style="{StaticResource Skeleton}" Width="140" Height="20" />
                  <Rectangle Style="{StaticResource Skeleton}" HorizontalAlignment="Stretch" Height="52" />
                </StackPanel>
              </DataTemplate></mvux:FeedView.ProgressTemplate>
              <mvux:FeedView.ErrorTemplate><DataTemplate><TextBlock x:Uid="Agenda_11" Text="Patients in preparation couldn't be loaded." Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" /></DataTemplate></mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>
          </utu:CardContentControl>
        </StackPanel>

        <!-- Next observation reminder: the patient, the status line, one dark call to action. -->
        <utu:CardContentControl Style="{StaticResource PanelCardStyle}" VerticalAlignment="Top"
                                Grid.Column="{utu:Responsive Narrowest=0, Wide=1, Layout={StaticResource ShellLayout}}"
                                Grid.Row="{utu:Responsive Narrowest=1, Wide=0, Layout={StaticResource ShellLayout}}"
                                Grid.ColumnSpan="{utu:Responsive Narrowest=2, Wide=1, Layout={StaticResource ShellLayout}}">
          <StackPanel Spacing="14">
            <TextBlock x:Uid="Agenda_12" Text="Next observation" Style="{StaticResource TypeH3Card}" />
            <mvux:FeedView Source="{Binding AgendaNext}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
              <mvux:FeedView.ValueTemplate><DataTemplate>
                <StackPanel Spacing="14">
                  <Grid ColumnDefinitions="40,*" ColumnSpacing="12">
                    <Grid Width="40" Height="40" CornerRadius="20" Background="{ThemeResource MediaPlaceholderBrush}" VerticalAlignment="Center">
                      <controls:PetBackdrop Photo="{Binding Data.Photo}" />
                      <TextBlock Text="{Binding Data.Initial}" Visibility="{Binding Data.HasNoPhoto}" Style="{StaticResource TypeBodyStrong}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Data.Name}" Style="{StaticResource TypeTitleS}" TextTrimming="CharacterEllipsis" />
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <ContentControl Style="{StaticResource LineIcon14Bold}" Content="{StaticResource IconTriangleAlert}" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Data.Label}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource PrimaryBrush}" Visibility="{Binding Data.IsWaiting}" />
                        <TextBlock Text="{Binding Data.Label}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{Binding Data.Detail}" Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" TextWrapping="WrapWholeWords" />
                  <Button Style="{StaticResource ButtonPrimaryL}" HorizontalAlignment="Left" uen:Navigation.Request="Record" uen:Navigation.Data="{Binding Data}" AutomationProperties.Name="{Binding Data.AccessibleName}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding Data.OpenLabel}" />
                      <ContentControl Style="{StaticResource LineIcon16Bold}" Content="{StaticResource IconArrowRight}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </DataTemplate></mvux:FeedView.ValueTemplate>
              <mvux:FeedView.NoneTemplate><DataTemplate><TextBlock x:Uid="Agenda_13" Text="No observation reminders right now." Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" /></DataTemplate></mvux:FeedView.NoneTemplate>
              <mvux:FeedView.ErrorTemplate><DataTemplate><TextBlock x:Uid="Agenda_14" Text="Observation reminders unavailable." Style="{StaticResource TypeBodyS}" Foreground="{ThemeResource InkMutedBrush}" /></DataTemplate></mvux:FeedView.ErrorTemplate>
            </mvux:FeedView>
          </StackPanel>
        </utu:CardContentControl>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</Page>
