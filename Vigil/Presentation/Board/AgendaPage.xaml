<Page x:Class="Vigil.Presentation.AgendaPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:muxc="using:Microsoft.UI.Xaml.Controls" xmlns:controls="using:Vigil.Controls" xmlns:mvux="using:Uno.Extensions.Reactive.UI" xmlns:uen="using:Uno.Extensions.Navigation.UI" xmlns:utu="using:Uno.Toolkit.UI" Background="Transparent">
  <Page.Resources>
    <!-- Same 1120 threshold as BoardLayout: docked from there, so the close button only shows in the flyout. -->
    <utu:ResponsiveLayout x:Key="AgendaLayout" Widest="1120" />
  </Page.Resources>
  <!-- Card after the "Patient care" popover: 24 px padding, radius 24, eyebrow + serif title, round close, tinted patient rows, one dark call to action. -->
  <utu:CardContentControl x:Name="AgendaPanel" Style="{StaticResource StaticOutlinedCardStyle}" MaxWidth="560" CornerRadius="24"
                          Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource OutlineBrush}" BorderThickness="1"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <Grid RowDefinitions="Auto,*,Auto,Auto">
      <Grid Padding="24,24,16,16" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
        <TextBlock x:Uid="Board_23" Text="CARE, THROUGH THE DAY" Style="{StaticResource CloverLabel}" Foreground="{ThemeResource OnSurfaceVariantBrush}" VerticalAlignment="Center" />
        <TextBlock x:Uid="Board_25" Grid.Row="1" Text="Today's agenda" FontFamily="{StaticResource CloverEditorialFont}" FontSize="28" Foreground="{ThemeResource OnSurfaceBrush}" />
        <!-- xaml-lint: allow backbar - the X dismisses the !Agenda flyout; there is no page to go back from -->
        <Button x:Uid="Board_24" Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Top" Style="{StaticResource CloverQuiet}" Width="40" Height="40" MinHeight="40" Padding="0" CornerRadius="20" Background="{ThemeResource CloverSage}"
                Visibility="{utu:Responsive Narrowest=Visible, Widest=Collapsed, Layout={StaticResource AgendaLayout}}" uen:Navigation.Request="-" AutomationProperties.Name="Close agenda"><FontIcon Glyph="&#xE711;" FontSize="14" Foreground="{ThemeResource OnSurfaceBrush}" /></Button>
        <!-- xaml-lint: allow card - 13 px clock pill, display-only, not a surface -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,4,8,0"><TextBlock Text="{Binding AgendaDate}" Style="{StaticResource CloverBody}" FontSize="13" VerticalAlignment="Center" /><Border Grid.Column="1" Background="{ThemeResource CloverSage}" CornerRadius="12" Padding="10,3"><TextBlock Text="{Binding AgendaClock}" FontFamily="{StaticResource CodeFontFamily}" FontSize="13" Foreground="{ThemeResource PrimaryBrush}" /></Border></Grid>
      </Grid>
      <ScrollViewer x:Name="AgendaScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="16,4,16,20" Spacing="20">
          <mvux:FeedView x:Name="AgendaFeed" Source="{Binding CareRhythm}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
            <mvux:FeedView.ValueTemplate><DataTemplate>
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto" Margin="8,0"><TextBlock x:Uid="Board_42" Text="RECORDED INTERVALS" Style="{StaticResource CloverLabel}" Foreground="{ThemeResource OnSurfaceVariantBrush}" /><TextBlock Grid.Column="1" Text="{Binding Data.Range}" Style="{StaticResource CloverBody}" FontFamily="{StaticResource CodeFontFamily}" FontSize="12" /></Grid>
                <!-- xaml-lint: allow card - 10 px legend swatches for the ruler colours -->
                <StackPanel Orientation="Horizontal" Spacing="14" Margin="8,0"><StackPanel Orientation="Horizontal" Spacing="6"><Border Width="10" Height="10" CornerRadius="3" Background="{ThemeResource CloverLavender}" BorderBrush="{ThemeResource CloverLavenderEdge}" BorderThickness="1" /><TextBlock x:Uid="Board_43" Text="Anaesthesia" Style="{StaticResource CloverBody}" FontSize="12" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="6"><Border Width="10" Height="10" CornerRadius="3" Background="{ThemeResource CloverMint}" BorderBrush="{ThemeResource CloverMintEdge}" BorderThickness="1" /><TextBlock x:Uid="Board_44" Text="Recovery" Style="{StaticResource CloverBody}" FontSize="12" /></StackPanel></StackPanel>
                <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled"><controls:CareRuler Data="{Binding Data}" /></ScrollViewer>
              </StackPanel>
            </DataTemplate></mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ProgressTemplate><DataTemplate><ProgressRing x:Uid="Board_28" Width="24" Height="24" IsActive="True" AutomationProperties.Name="Loading agenda" /></DataTemplate></mvux:FeedView.ProgressTemplate>
            <mvux:FeedView.ErrorTemplate><DataTemplate><StackPanel Spacing="10"><TextBlock x:Uid="Board_29" Text="Agenda couldn't be loaded." Style="{StaticResource CloverBody}" /><Button x:Uid="Board_30" Content="Retry" Style="{StaticResource CloverSecondary}" Command="{Binding DataContext.Retry, ElementName=AgendaFeed}" /></StackPanel></DataTemplate></mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
          <mvux:FeedView Source="{Binding Agenda}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
            <mvux:FeedView.ValueTemplate><DataTemplate>
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" Margin="8,0,8,2"><TextBlock x:Uid="Board_34" Text="IN PREPARATION" Style="{StaticResource CloverLabel}" Foreground="{ThemeResource OnSurfaceVariantBrush}" /><TextBlock x:Uid="Board_35" Grid.Column="1" Text="UNTIMED" Style="{StaticResource CloverLabel}" Foreground="{ThemeResource OnSurfaceVariantBrush}" /></Grid>
                <!-- Patient row: tinted, radius 14, 12 px padding, 40 px avatar, name 15 SemiBold over a 13 px detail. -->
                <muxc:ItemsRepeater ItemsSource="{Binding Data.Preparing}"><muxc:ItemsRepeater.Layout><muxc:StackLayout Spacing="8" /></muxc:ItemsRepeater.Layout><muxc:ItemsRepeater.ItemTemplate><DataTemplate>
                  <Button Style="{StaticResource CloverAgendaItem}" Background="{ThemeResource SurfaceVariantBrush}" CornerRadius="14" Padding="12" uen:Navigation.Request="Record" uen:Navigation.Data="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
                    <Grid ColumnDefinitions="40,*,16" ColumnSpacing="12">
                      <Grid Width="40" Height="40" CornerRadius="20" Background="{ThemeResource CloverSage}" VerticalAlignment="Center"><controls:PetBackdrop Photo="{Binding Photo}" /><TextBlock Text="{Binding Initial}" Visibility="{Binding HasNoPhoto}" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                      <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" Style="{StaticResource CloverBody}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Detail}" Style="{StaticResource CloverBody}" FontSize="13" TextTrimming="CharacterEllipsis" /></StackPanel>
                      <FontIcon Grid.Column="2" Glyph="&#xE72A;" FontSize="14" Foreground="{ThemeResource PrimaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>
                </DataTemplate></muxc:ItemsRepeater.ItemTemplate></muxc:ItemsRepeater>
                <TextBlock x:Uid="Board_36" Text="No patients waiting for preparation." Style="{StaticResource CloverBody}" FontSize="13" Margin="8,0" Visibility="{Binding Data.NoPreparing}" />
              </StackPanel>
            </DataTemplate></mvux:FeedView.ValueTemplate>
            <mvux:FeedView.ErrorTemplate><DataTemplate><Border /></DataTemplate></mvux:FeedView.ErrorTemplate>
          </mvux:FeedView>
        </StackPanel>
      </ScrollViewer>
      <!-- Next reminder: the patient row, the status line, then one dark call to action (44 px, as in the reference). -->
      <mvux:FeedView Grid.Row="2" Margin="24,8,24,16" Source="{Binding AgendaNext}" RefreshingState="None" IsTabStop="False" HorizontalContentAlignment="Stretch">
        <mvux:FeedView.ValueTemplate><DataTemplate>
          <StackPanel Spacing="12">
            <utu:CardContentControl Style="{StaticResource StaticOutlinedCardStyle}" CornerRadius="14" Background="{ThemeResource SurfaceVariantBrush}" BorderThickness="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
              <Grid Padding="12" ColumnDefinitions="40,*" ColumnSpacing="12">
                <Grid Width="40" Height="40" CornerRadius="20" Background="{ThemeResource CloverCream}" VerticalAlignment="Center"><controls:PetBackdrop Photo="{Binding Data.Photo}" /><TextBlock Text="{Binding Data.Initial}" Visibility="{Binding Data.HasNoPhoto}" Foreground="{ThemeResource PrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Data.Name}" Style="{StaticResource CloverBody}" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource OnSurfaceBrush}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" /><TextBlock Text="{Binding Data.Label}" FontSize="13" Foreground="{ThemeResource PrimaryBrush}" Visibility="{Binding Data.IsWaiting}" /><TextBlock Text="{Binding Data.Label}" FontSize="13" Foreground="{ThemeResource ErrorBrush}" Visibility="{Binding Data.IsOverdue}" /></StackPanel>
                </StackPanel>
              </Grid>
            </utu:CardContentControl>
            <TextBlock Text="{Binding Data.Detail}" Style="{StaticResource CloverBody}" FontSize="13" Margin="4,0" />
            <Button Style="{StaticResource CloverPrimary}" CornerRadius="12" MinHeight="44" Padding="20,10" HorizontalAlignment="Left" uen:Navigation.Request="Record" uen:Navigation.Data="{Binding Data}" AutomationProperties.Name="{Binding Data.AccessibleName}">
              <StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Data.OpenLabel}" /><FontIcon Glyph="&#xE72A;" FontSize="14" /></StackPanel>
            </Button>
          </StackPanel>
        </DataTemplate></mvux:FeedView.ValueTemplate>
        <mvux:FeedView.NoneTemplate><DataTemplate><TextBlock x:Uid="Board_32" Text="No observation reminders right now." Style="{StaticResource CloverBody}" FontSize="13" /></DataTemplate></mvux:FeedView.NoneTemplate>
        <mvux:FeedView.ErrorTemplate><DataTemplate><TextBlock x:Uid="Board_33" Text="Observation reminders unavailable." Style="{StaticResource CloverBody}" FontSize="13" /></DataTemplate></mvux:FeedView.ErrorTemplate>
      </mvux:FeedView>
      <Border Grid.Row="3" Padding="24,14,24,18" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource OutlineBrush}"><StackPanel Orientation="Horizontal" Spacing="8"><controls:CareMark Width="14" Height="17" /><TextBlock x:Uid="Board_37" Text="Gaps indicate no recorded care." Style="{StaticResource CloverBody}" FontSize="12" VerticalAlignment="Center" /></StackPanel></Border>
    </Grid>
  </utu:CardContentControl>
</Page>
