<!--
  The sidebar as a left drawer below 760 px (route "!Menu"): a Flyout view, so the navigation flyout uses this
  instance and its Toolkit drawer presenter. MenuModel hands each choice back to the shell.
-->
<Flyout x:Class="Vigil.Presentation.MenuFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:Vigil.Controls"
        xmlns:utu="using:Uno.Toolkit.UI">
  <Flyout.FlyoutPresenterStyle>
    <Style TargetType="FlyoutPresenter" BasedOn="{StaticResource LeftDrawerFlyoutPresenterStyle}">
      <Setter Property="utu:DrawerFlyoutPresenter.DrawerLength" Value="272" />
      <Setter Property="Background" Value="{ThemeResource PageBrush}" />
    </Style>
  </Flyout.FlyoutPresenterStyle>
  <Grid Background="{ThemeResource PageBrush}">
    <controls:Sidebar />
  </Grid>
</Flyout>
